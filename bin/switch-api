    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(provider_model_catalog(), ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    try:
        tmp.chmod(0o600)
    except Exception:
        pass
    os.replace(tmp, path)


def resolve_cc_model_for_quotio(current_model: str) -> Tuple[str, str]:
    m = (current_model or "").strip()
    if not m:
        return QUOTIO_CC_DEFAULT_MODEL, "Claude Code model empty; set to quotio default claude-opus-4-6-thinking"

    if m in QUOTIO_CC_ALLOWED_MODELS:
        return m, ""

    if m in QUOTIO_CC_MODEL_FALLBACKS:
        return QUOTIO_CC_MODEL_FALLBACKS[m], f"Claude model {m} mapped to {QUOTIO_CC_MODEL_FALLBACKS[m]} for quotio"

    lm = m.lower()
    if "haiku" in lm:
        return "claude-sonnet-4-6", f"Claude model {m} mapped to claude-sonnet-4-6 (haiku fallback policy)"
    if "opus-4-5" in lm:
        return "claude-opus-4-6-thinking", f"Claude model {m} mapped to claude-opus-4-6-thinking (opus4.5 fallback policy)"

    return QUOTIO_CC_DEFAULT_MODEL, f"Claude model {m} is not in quotio allowlist; fallback to {QUOTIO_CC_DEFAULT_MODEL}"


def resolve_openclaw_primary_for_quotio(current_primary: str) -> Tuple[str, str]:
    p = (current_primary or "").strip()
    if not p:
        return QUOTIO_OPENCLAW_DEFAULT_PRIMARY, "OpenClaw primary empty; set to quotio default quotio/claude-opus-4-6-thinking"

    if p in QUOTIO_OPENCLAW_ALLOWED_PRIMARY:
        return p, ""

    if p in QUOTIO_OPENCLAW_PRIMARY_FALLBACKS:
        t = QUOTIO_OPENCLAW_PRIMARY_FALLBACKS[p]
        return t, f"OpenClaw primary {p} mapped to {t} for quotio"

    lp = p.lower()
    if "haiku" in lp:
        return "quotio/claude-sonnet-4-6", f"OpenClaw primary {p} mapped to quotio/claude-sonnet-4-6 (haiku fallback policy)"
    if "opus-4-5" in lp:
        return "quotio/claude-opus-4-6-thinking", f"OpenClaw primary {p} mapped to quotio/claude-opus-4-6-thinking (opus4.5 fallback policy)"

    return QUOTIO_OPENCLAW_DEFAULT_PRIMARY, f"OpenClaw primary {p} is not in quotio allowlist; fallback to {QUOTIO_OPENCLAW_DEFAULT_PRIMARY}"


def resolve_openclaw_quotio_profile(profile: str) -> Tuple[str, str]:
    p = (profile or "").strip().lower()
    if not p:
        target = OPENCLAW_QUOTIO_PROFILE_TO_PRIMARY["default"]
        return target, f"OpenClaw quotio profile default -> {target}"

    if p not in OPENCLAW_QUOTIO_PROFILE_TO_PRIMARY:
        raise SwitchError(
            f"Unknown openclaw quotio profile: {profile} (use one of: {', '.join(OPENCLAW_QUOTIO_PROFILE_NAMES)})"
        )

    target = OPENCLAW_QUOTIO_PROFILE_TO_PRIMARY[p]
    return target, f"OpenClaw quotio profile {p} -> {target}"



def resolve_openclaw_antigravity_profile(profile: str) -> Tuple[str, str]:
    p = (profile or "").strip().lower()
    if not p:
        target = OPENCLAW_ANTIGRAVITY_PROFILE_TO_PRIMARY["default"]
        return target, f"OpenClaw antigravity profile default -> {target}"

    if p not in OPENCLAW_ANTIGRAVITY_PROFILE_TO_PRIMARY:
        raise SwitchError(
            f"Unknown openclaw antigravity profile: {profile} (use one of: {', '.join(OPENCLAW_ANTIGRAVITY_PROFILE_NAMES)})"
        )

    target = OPENCLAW_ANTIGRAVITY_PROFILE_TO_PRIMARY[p]
    return target, f"OpenClaw antigravity profile {p} -> {target}"


class Config:
    def __init__(self, home: Path):
        self.home = home
        self.cc_settings = home / ".claude/settings.json"
        self.oc_config = home / ".openclaw/openclaw.json"
        self.oc_models = home / ".openclaw/agents/main/agent/models.json"
        self.oc_auth = home / ".openclaw/agents/main/agent/auth.json"
        self.oc_auth_profiles = home / ".openclaw/agents/main/agent/auth-profiles.json"
        self.cx_config = home / ".codex/config.toml"
        self.bashrc = home / ".bashrc"
        self.switch_dir = home / ".config/switch-api"
        self.cred_file = self.switch_dir / "credentials.json"
        self.provider_models_file = self.switch_dir / "provider-models.json"


# ----------------------------- status -----------------------------
def detect_provider(tool: str, cfg: Config) -> str:
    if tool == "cc":
        if not cfg.cc_settings.exists():
            return "no-config"
        data = load_json(cfg.cc_settings)
        url = ((data.get("env") or {}).get("ANTHROPIC_BASE_URL") or "").strip()
        if "tools.ancientechoes" in url:
            return "antigravity"
        if "ancientechoes" in url:
            return "quotio"
        if "duckcoding" in url:
            return "duck"
        return f"unknown({url})" if url else "unknown"

    if tool == "openclaw":
        if not cfg.oc_config.exists():
            return "no-config"
        data = load_json(cfg.oc_config)
        model = (
            (((data.get("agents") or {}).get("defaults") or {}).get("model") or {}).get(
                "primary"
            )
            or ""
        )
        if model.startswith("antigravity/") or model.startswith("antigravity-gemini/"):
            return "antigravity"
        if model.startswith("quotio/") or model.startswith("quotio-gemini/"):
            return "quotio"
        if model.startswith("duckcoding/"):
            return "duck"
        return f"unknown({model})" if model else "unknown"

    if tool == "codex":
        if not cfg.cx_config.exists():
            return "no-config"
        text = read_text(cfg.cx_config)
        m = re.search(r'^\s*model_provider\s*=\s*"([^"]+)"\s*$', text, re.M)
        provider = m.group(1) if m else "unknown"
        if provider == "antigravity":
            return "antigravity"
        if provider == "quotio":
            return "quotio"
        if provider == "duckcoding":
            return "duck"
        return provider

    if tool == "droid":
        base = os.environ.get("GEMINI_BASE_URL", "")
        if "tools.ancientechoes" in base:
            return "antigravity"
        if "ancientechoes" in base:
            return "quotio"
        if "duckcoding" in base:
            return "duck"
        return "unknown"

    return "unknown"


def show_status(cfg: Config) -> None:
    print(f"{CYAN}═══ API Provider Status ═══{NC}")
    for tool in TOOLS:
        p = detect_provider(tool, cfg)
        icon = "❓"
        if p == "duck":
            icon = "🦆"
        elif p == "quotio":
            icon = "🔗"
        elif p == "antigravity":
            icon = "🚀"
        print(f"  {tool:<10} {icon}  {p}")
    print(f"{CYAN}═══════════════════════════{NC}")
    print("  🦆 = DuckCoding (jp.duckcoding.com)")
    print("  🔗 = Quotio Tunnel (api.ancientechoes.ai)")
    print("  🚀 = Antigravity-tools (tools.ancientechoes.ai)")


# ----------------------------- switchers -----------------------------
def switch_cc(provider: str, cfg: Config, keys: Dict[str, str]) -> None:
    info(f"Switching Claude Code → {provider}")
    backup(cfg.cc_settings)

    data = load_json(cfg.cc_settings)
    env = data.setdefault("env", {})
    current_model = str(data.get("model", "") or "").strip()

    if provider == "duck":
        env["ANTHROPIC_BASE_URL"] = DUCK_BASE_URL
        env["ANTHROPIC_AUTH_TOKEN"] = ensure_key(
            "DUCK_ANTHROPIC_API_KEY/ANTHROPIC_API_KEY", keys["duck_anthropic"]
        )
    elif provider == "quotio":
        env["ANTHROPIC_BASE_URL"] = QUOTIO_BASE_URL
        env["ANTHROPIC_AUTH_TOKEN"] = ensure_key("QUOTIO_API_KEY", keys["quotio"])

        target_model, reason = resolve_cc_model_for_quotio(current_model)
        data["model"] = target_model
        if reason:
            warn(reason)
        info("Quotio Claude allowlist: claude-opus-4-6-thinking, claude-sonnet-4-6")

    elif provider == "antigravity":
        env["ANTHROPIC_BASE_URL"] = ANTIGRAVITY_BASE_URL
        env["ANTHROPIC_AUTH_TOKEN"] = ensure_key("ANTIGRAVITY_API_KEY", keys["antigravity"])

        # Reuse quotio model resolution (same model set)
        target_model, reason = resolve_cc_model_for_quotio(current_model)
        data["model"] = target_model
        if reason:
            warn(reason)
        info("Antigravity Claude allowlist: claude-opus-4-6-thinking, claude-sonnet-4-6")

    save_json(cfg.cc_settings, data)
    ok(f"Claude Code → {provider}")


