class Config:
    def __init__(self, home: Path):
        self.home = home
        self.cc_settings = home / ".claude/settings.json"
        self.oc_config = home / ".openclaw/openclaw.json"
        self.oc_models = home / ".openclaw/agents/main/agent/models.json"
        self.oc_auth = home / ".openclaw/agents/main/agent/auth.json"
        self.oc_auth_profiles = home / ".openclaw/agents/main/agent/auth-profiles.json"
        self.cx_config = home / ".codex/config.toml"
        self.factory_settings = home / ".factory/settings.json"
        self.gemini_env = home / ".gemini/.env"
        self.bashrc = home / ".bashrc"
        self.switch_dir = home / ".config/switch-api"
        self.cred_file = self.switch_dir / "credentials.json"
        self.provider_models_file = self.switch_dir / "provider-models.json"


# ----------------------------- status -----------------------------
def detect_provider(tool: str, cfg: Config) -> str:
    if tool == "cc":
        if not cfg.cc_settings.exists():
            return "no-config"
        data = load_json(cfg.cc_settings)
        url = ((data.get("env") or {}).get("ANTHROPIC_BASE_URL") or "").strip()
        if "tools.ancientechoes" in url:
            return "antigravity"
        if "ancientechoes" in url:
            return "quotio"
        if "icodeeasy" in url:
            return "icodeeasy"
        if "duckcoding" in url:
            # Distinguish duck vs duck_cc1 vs duck_codex2cc by checking the key against credential store
            cc_key = ((data.get("env") or {}).get("ANTHROPIC_AUTH_TOKEN") or "").strip()
            cred_path = cfg.switch_dir / "credentials.json"
            cred_store = load_credential_store(cred_path) if cred_path.exists() else {}
            duck_cc1_key = os.environ.get("DUCK_CC1_API_KEY") or cred_store.get("duck_cc1", "")
            if duck_cc1_key and cc_key == duck_cc1_key:
                return "duck_cc1"
            duck_codex2cc_key = os.environ.get("DUCK_CODEX2CC_API_KEY") or cred_store.get("duck_codex2cc", "")
            if duck_codex2cc_key and cc_key == duck_codex2cc_key:
                return "duck_codex2cc"
            return "duck"
        if "openrouter.ai" in url:
            return "openrouter"
        return f"unknown({url})" if url else "unknown"

    if tool == "openclaw":
        if not cfg.oc_config.exists():
            return "no-config"
        data = load_json(cfg.oc_config)
        model = (
            (((data.get("agents") or {}).get("defaults") or {}).get("model") or {}).get(
                "primary"
            )
            or ""
        )
        if model.startswith("antigravity/") or model.startswith("antigravity-gemini/"):
            return "antigravity"
        if model.startswith("quotio/") or model.startswith("quotio-gemini/"):
            return "quotio"
        if model.startswith("duckcoding/") or model.startswith("duckcoding-claude/"):
            return "duck"
        if model.startswith("openrouter/"):
            return "openrouter"
        if model.startswith("openai-direct/"):
            return "openai"
        return f"unknown({model})" if model else "unknown"

    if tool == "codex":
        if not cfg.cx_config.exists():
            return "no-config"
        text = read_text(cfg.cx_config)
        m = re.search(r'^\s*model_provider\s*=\s*"([^"]+)"\s*$', text, re.M)
        provider = m.group(1) if m else "unknown"
        if provider == "antigravity":
            return "antigravity"
        if provider == "quotio":
            return "quotio"
        if provider == "duckcoding":
            return "duck"
        if provider == "quotio-local":
            return "quotio_local"
        if provider == "openai-official":
            return "openai"
        # Named OpenAI accounts: openai-Gq80 → openai_Gq80
        for _np in OPENAI_NAMED_PROVIDERS:
            if provider == _np.replace("_", "-", 1):  # openai_Gq80 → openai-Gq80
                return _np
        if provider == "openrouter":
            return "openrouter"
        if provider == "aiwave":
            return "aiwave"
        return provider


    if tool == "gemini":
        gemini_env = cfg.gemini_env
        if not gemini_env.exists():
            return "no-config"
        text = read_text(gemini_env)
        m = re.search(r"^GOOGLE_GEMINI_BASE_URL=(.*)$", text, re.M)
        url = m.group(1).strip() if m else ""
        if "tools.ancientechoes" in url:
            return "antigravity"
        if "ancientechoes" in url:
            return "quotio"
        if "duckcoding" in url:
            return "duck"
        return f"unknown({url})" if url else "unknown"

    if tool == "droid":
        # Check customModels first (OpenRouter / aiwave / duck_cc1 use this)
        factory_settings = cfg.home / ".factory/settings.json"
        if factory_settings.exists():
            try:
                fdata = load_json(factory_settings)
                cms = fdata.get("customModels", [])
                if cms and isinstance(cms, list) and isinstance(cms[0], dict):
                    cm_url = cms[0].get("baseUrl", "")
                    cm_key = cms[0].get("apiKey", "")
                    if "openrouter.ai" in cm_url:
                        return "openrouter"
                    if "ai-wave.org" in cm_url:
                        return "aiwave"
                    if "127.0.0.1:8317" in cm_url:
                        return "quotio_local"
                    if "api.openai.com" in cm_url:
                        # Distinguish named OpenAI accounts by key
                        _cred = load_credential_store(cfg.cred_file) if cfg.cred_file.exists() else {}
                        for _np in OPENAI_NAMED_PROVIDERS:
                            _np_key = _cred.get(_np, "")
                            if _np_key and cm_key == _np_key:
                                return _np
                        return "openai"
                    if "duckcoding" in cm_url:
                        # Distinguish duck vs duck_cc1 by key
                        cred_store = load_credential_store(cfg.cred_file) if cfg.cred_file.exists() else {}
                        dc1_key = os.environ.get("DUCK_CC1_API_KEY") or cred_store.get("duck_cc1", "")
                        if dc1_key and cm_key == dc1_key:
                            return "duck_cc1"
                        return "duck"
            except Exception:
                pass
        base = os.environ.get("GEMINI_BASE_URL", "")
        if "tools.ancientechoes" in base:
            return "antigravity"
        if "ancientechoes" in base:
            return "quotio"
        if "duckcoding" in base:
            return "duck"
        return "unknown"

    return "unknown"


def show_status(cfg: Config) -> None:
    print(f"{CYAN}═══ API Provider Status ═══{NC}")
    for tool in TOOLS:
        p = detect_provider(tool, cfg)
        icon = "❓"
        if p == "duck":
            icon = "🦆"
        elif p == "quotio" or p == "quotio_local":
            icon = "🔗"
        elif p == "antigravity":
            icon = "🚀"
        elif p == "openai" or p.startswith("openai_"):
            icon = "🔑"
        elif p == "openrouter":
            icon = "🌐"
        elif p == "aiwave":
            icon = "🌊"
        elif p == "duck_cc1":
            icon = "🦆"
        elif p == "duck_codex2cc":
            icon = "🦆"
        elif p == "icodeeasy":
            icon = "🧊"
        print(f"  {tool:<10} {icon}  {p}")
    print(f"{CYAN}═══════════════════════════{NC}")
    print("  🦆 = DuckCoding (api.duckcoding.ai)")
    print("  🔗 = Quotio Tunnel (api.ancientechoes.ai) / Quotio-Local (127.0.0.1:8317)")
    print("  🚀 = Antigravity-tools (tools.ancientechoes.ai)")
    print("  🔑 = OpenAI 官方 (api.openai.com via proxy) — Gq80/V420 = 账号标识")
    print("  🌐 = OpenRouter (openrouter.ai)")
    print("  🌊 = AI Wave (api.ai-wave.org)")
    print("  🧊 = iCodeEasy (api.icodeeasy.cc)")




# ----------------------------- model helpers ----------------------------
# Model family → compatible tools
FAMILY_TOOLS = {
    "claude": ("cc", "openclaw"),
    "gemini": ("openclaw", "droid", "gemini"),
    "gpt":    ("codex", "droid", "openclaw"),
    "openrouter": ("openclaw", "codex", "droid"),
}

ALL_KNOWN_PROFILES = frozenset(
    list(OPENCLAW_DUCK_PROFILE_NAMES)
    + list(OPENCLAW_QUOTIO_PROFILE_NAMES)
    + list(OPENCLAW_ANTIGRAVITY_PROFILE_NAMES)
    + list(DROID_QUOTIO_PROFILE_NAMES)
    + list(OPENCLAW_OPENROUTER_PROFILE_NAMES)
)


def model_family(model: str) -> str:
    """Return 'claude', 'gemini', 'gpt', or 'other'."""
    m = model.split("/")[-1]  # strip provider prefix like quotio/
    if m.startswith("claude-") or m.startswith("claude_"):
        return "claude"
    if m.startswith("gemini-") or m.startswith("gemini_"):
        return "gemini"
    if m.startswith("gpt-") or m.startswith("gpt_") or m.startswith("o1") or m.startswith("o3") or m.startswith("o4"):
        return "gpt"
    # OpenRouter model IDs contain "/" (e.g. stepfun/step-3.5-flash:free)
    if "/" in model and (model in OPENROUTER_FREE_MODELS or model.rstrip(":free") + ":free" in OPENROUTER_FREE_MODELS):
        return "openrouter"
    return "other"


def is_model_name(s: str) -> bool:
    """Heuristic: is this string a model name (vs a profile name)?"""
    if s.lower() in ALL_KNOWN_PROFILES:
        return False
    if s.startswith("claude-") or s.startswith("gemini-") or s.startswith("gpt-"):
        return True
    if "." in s:  # e.g. gpt-5.3-codex
        return True
    return True  # default: treat as model name


def get_provider_models(provider: str) -> Dict[str, Tuple[str, ...]]:
    """Return {family: (models...)} for a provider."""
    if provider == "quotio":
        models = QUOTIO_AVAILABLE_MODELS
    elif provider == "duck":
        # Merge all 3 duck keys
        models = tuple(sorted(set(DUCK_ANTHROPIC_MODELS + DUCK_GEMINI_MODELS + DUCK_CODEX_MODELS)))
    elif provider == "antigravity":
        # Antigravity shares Quotio model set (same tunnel backend)
        models = QUOTIO_AVAILABLE_MODELS
    elif provider == "icodeeasy":
        models = ICODEEASY_AVAILABLE_MODELS
    elif provider == "duck_codex2cc":
        models = DUCK_CODEX2CC_AVAILABLE_MODELS
    elif provider == "openrouter":
        models = OPENROUTER_FREE_MODELS
    else:
        return {}
    result: Dict[str, list] = {"claude": [], "gemini": [], "gpt": [], "openrouter": [], "other": []}
    for m in models:
        result[model_family(m)].append(m)
    return {k: tuple(v) for k, v in result.items()}


def model_in_provider(model: str, provider: str) -> bool:
    """Check if a model name is in the provider's catalog."""
    if provider == "openrouter":
        # OpenRouter model IDs contain slashes (e.g. stepfun/step-3.5-flash:free)
        return model in OPENROUTER_FREE_MODELS
    m = model.split("/")[-1]  # strip provider prefix
    if provider == "quotio" or provider == "antigravity":
        return m in QUOTIO_AVAILABLE_MODELS
    if provider == "icodeeasy":
        return m in ICODEEASY_AVAILABLE_MODELS
    if provider == "duck_codex2cc":
        return m in DUCK_CODEX2CC_AVAILABLE_MODELS
    if provider == "duck":
        return m in DUCK_ANTHROPIC_MODELS or m in DUCK_GEMINI_MODELS or m in DUCK_CODEX_MODELS
    return False  # openai — no local catalog


def tools_for_model(model: str) -> Tuple[str, ...]:
    """Return which tools can use this model."""
    fam = model_family(model)
    return FAMILY_TOOLS.get(fam, ())


# ----------------------------- list command ----------------------------
def cmd_list_models(provider: str = "") -> None:
    """Print available models for one or all providers."""
    providers = [provider] if provider else ["quotio", "duck", "antigravity", "icodeeasy", "duck_codex2cc", "openrouter"]

    for prov in providers:
        catalog = get_provider_models(prov)
        total = sum(len(v) for v in catalog.values())
        prov_label = {
            "quotio": "Quotio",
            "duck": "DuckCoding",
            "antigravity": "Antigravity",
            "icodeeasy": "iCodeEasy (CC-only)",
            "duck_codex2cc": "Duck CodeX→CC (CC-only)",
            "openrouter": "OpenRouter (Free)",
        }.get(prov, prov)
        print(f"{CYAN}═══ {prov_label} 可用模型 ({total}) ═══{NC}")

        sections = [
            ("Claude", "claude", "cc, openclaw"),
            ("Gemini", "gemini", "openclaw, droid, gemini"),
            ("OpenAI/GPT", "gpt", "codex, droid"),
            ("OpenRouter (Free)", "openrouter", "openclaw, codex, droid"),
            ("其他", "other", "—"),
        ]
        for label, fam, tools_hint in sections:
            models = catalog.get(fam, ())
            if not models:
                continue
            print(f"  {GREEN}{label}{NC} ({tools_hint}):")
            # For duck, annotate which key
            for m in models:
                if prov == "duck":
                    if m in DUCK_ANTHROPIC_MODELS:
                        tag = " [anthropic]"
                    elif m in DUCK_GEMINI_MODELS:
                        tag = " [gemini]"
                    elif m in DUCK_CODEX_MODELS:
                        tag = " [codex]"
                    else:
                        tag = ""
                    print(f"    {m}{tag}")
                elif prov == "duck_codex2cc":
                    mapped = DUCK_CODEX2CC_MODEL_MAP.get(m, "?")
                    print(f"    {m}  → {mapped}")
                else:
                    print(f"    {m}")
        print()


# ----------------------------- check command ---------------------------
def detect_current_model(tool: str, cfg: Config) -> str:
    """Read current model from tool config."""
    if tool == "cc":
        if not cfg.cc_settings.exists():
            return "?"
        data = load_json(cfg.cc_settings)
        return str(data.get("model", "") or "?")

    if tool == "openclaw":
        if not cfg.oc_config.exists():
            return "?"
        data = load_json(cfg.oc_config)
        return str(
            (((data.get("agents") or {}).get("defaults") or {}).get("model") or {}).get("primary", "?")
        )

    if tool == "codex":
        if not cfg.cx_config.exists():
            return "?"
        text = read_text(cfg.cx_config)
        m = re.search(r'^\s*model\s*=\s*"([^"]+)"', text, re.M)
        return m.group(1) if m else "?"

    if tool == "droid":
        # Check customModels first, then env
        if cfg.factory_settings.exists():
            data = load_json(cfg.factory_settings)
            cms = data.get("customModels", [])
            if cms and isinstance(cms, list) and isinstance(cms[0], dict):
                return cms[0].get("model", "?")
        return os.environ.get("GEMINI_MODEL", "?")

    if tool == "gemini":
        gemini_env = cfg.gemini_env
        if not gemini_env.exists():
            return "?"
        text = read_text(gemini_env)
        m = re.search(r"^GOOGLE_GEMINI_MODEL=(.*)$", text, re.M)
        return m.group(1).strip() if m else "?"

    return "?"


def probe_model_curl(provider: str, model: str, keys: Dict[str, str]) -> Tuple[bool, str]:
    """Online verify a model by sending a minimal chat completion via curl."""
    endpoint_map = {
        "duck": (DUCK_BASE_URL_V1 + "/chat/completions", None),
        "quotio": (QUOTIO_BASE_URL_V1 + "/chat/completions", None),
        "antigravity": (ANTIGRAVITY_BASE_URL_V1 + "/chat/completions", None),
        "openai": (OPENAI_BASE_URL_V1 + "/chat/completions", XRAY_PROXY),
        "openrouter": (OPENROUTER_BASE_URL_V1 + "/chat/completions", None),
    }
    entry = endpoint_map.get(provider)
    if not entry:
        return False, f"unknown provider: {provider}"
    url, proxy = entry

    # Pick the right API key
    fam = model_family(model)
    if provider == "duck":
        if fam == "claude":
            key = keys.get("duck_anthropic", "")
        elif fam == "gemini":
            key = keys.get("duck_gemini", "")
        else:
            key = keys.get("duck_codex", "")
    elif provider == "quotio":
        key = keys.get("quotio", "")
    elif provider == "antigravity":
        key = keys.get("antigravity", "")
    elif provider == "openai":
        key = keys.get("openai", "")
    elif provider == "openrouter":
        key = keys.get("openrouter", "")
    else:
        key = ""

    if not key:
        return False, "no API key"

    payload = json.dumps({
        "model": model.split("/")[-1],
        "messages": [{"role": "user", "content": "hi"}],
        "max_tokens": 1,
    })

    cmd = ["curl", "-s", "-w", "\n%{http_code}", "-X", "POST", url,
           "-H", f"Authorization: Bearer {key}",
           "-H", "Content-Type: application/json",
           "-d", payload,
           "--max-time", "10"]
    if proxy:
        cmd.extend(["--proxy", proxy])

    try:
        result = subprocess.run(cmd, capture_output=True, text=True, timeout=15)
        lines = result.stdout.strip().rsplit("\n", 1)
        if len(lines) == 2:
            body, code = lines
        else:
            body, code = result.stdout.strip(), "0"
        code = code.strip()
        if code.startswith("2"):
            return True, ""
        # Parse error
        try:
            err_data = json.loads(body)
            err_msg = err_data.get("error", {}).get("message", body[:80]) if isinstance(err_data.get("error"), dict) else str(err_data.get("error", body[:80]))
        except Exception:
            err_msg = body[:80]
        return False, f"HTTP {code}: {err_msg}"
    except subprocess.TimeoutExpired:
        return False, "timeout"
    except Exception as e:
        return False, str(e)


def cmd_check(cfg: Config, keys: Dict[str, str], online: bool = False) -> None:
    """Show current model status for each tool, optionally with online verification."""
    print(f"{CYAN}═══ Model Status {'(online)' if online else ''} ═══{NC}")
    for tool in TOOLS:
        prov = detect_provider(tool, cfg)
        model = detect_current_model(tool, cfg)
        icon = {"duck": "🦆", "quotio": "🔗", "antigravity": "🚀", "openai": "🔑", "openrouter": "🌐", "icodeeasy": "🧊"}.get(prov, "❓")

        # Truncate model for display
        model_display = model if len(model) <= 32 else model[:29] + "..."

        # Local catalog check — OpenRouter IDs contain slashes, extract properly
        if prov == "openrouter" and model.startswith("openrouter/"):
            bare_model = model[len("openrouter/"):]
        else:
            bare_model = model.split("/")[-1]
        if prov in ("quotio", "antigravity", "duck", "openrouter", "icodeeasy"):
            in_catalog = model_in_provider(bare_model, prov)
            status = "✅" if in_catalog else "⚠️"
        else:
            status = "—"

        if online and prov in ("quotio", "antigravity", "duck", "openai"):
            ok, reason = probe_model_curl(prov, bare_model, keys)
            if ok:
                status = "✅ online"
            else:
                status = f"❌ {reason[:30]}"

        print(f"  {tool:<10} {icon} {prov:<14} {model_display:<34} {status}")
    print(f"{CYAN}═══════════════════════════════════════════════════════════{NC}")


# ----------------------------- model-level switch ----------------------
def validate_model_for_tool(tool: str, model: str, provider: str, force: bool = False) -> None:
    """Validate model compatibility. Raises SwitchError on failure."""
    fam = model_family(model)
    compatible = FAMILY_TOOLS.get(fam, ())

    if tool not in compatible:
        raise SwitchError(
            f"Model '{model}' (family: {fam}) is not compatible with tool '{tool}'.\n"
            f"  Compatible tools for {fam}: {', '.join(compatible) if compatible else 'none'}"
        )

    if not force and provider not in ("openai", "openrouter", "quotio_local") and provider not in OPENAI_NAMED_PROVIDERS:
        bare = model.split("/")[-1]
        if not model_in_provider(bare, provider):
            raise SwitchError(
                f"Model '{bare}' not found in {provider} catalog.\n"
                f"  Run: switch-api list {provider}\n"
                f"  Or use --force to skip this check."
            )

# ----------------------------- switchers -----------------------------
def switch_cc(provider: str, cfg: Config, keys: Dict[str, str], model: str = "") -> None:
    info(f"Switching Claude Code → {provider}")
    backup(cfg.cc_settings)

    data = load_json(cfg.cc_settings)
    env = data.setdefault("env", {})
    current_model = str(data.get("model", "") or "").strip()

    if provider == "duck":
        env["ANTHROPIC_BASE_URL"] = DUCK_BASE_URL
        env["ANTHROPIC_AUTH_TOKEN"] = ensure_key(
            "DUCK_ANTHROPIC_API_KEY/ANTHROPIC_API_KEY", keys["duck_anthropic"]
        )
    elif provider == "duck_cc1":
        env["ANTHROPIC_BASE_URL"] = DUCK_BASE_URL
        env["ANTHROPIC_AUTH_TOKEN"] = ensure_key(
            "DUCK_CC1_API_KEY", keys["duck_cc1"]
        )
    elif provider == "duck_codex2cc":
        env["ANTHROPIC_BASE_URL"] = DUCK_BASE_URL
        env["ANTHROPIC_AUTH_TOKEN"] = ensure_key(
            "DUCK_CODEX2CC_API_KEY", keys["duck_codex2cc"]
        )
        # Ensure model is one of the mapped Claude names
        if current_model not in DUCK_CODEX2CC_AVAILABLE_MODELS:
            data["model"] = "claude-opus-4-6"
            info(f"Model set to claude-opus-4-6 (→ gpt-5.3-codex-xhigh)")
        else:
            mapped = DUCK_CODEX2CC_MODEL_MAP.get(current_model, "?")
            info(f"Keeping model {current_model} (→ {mapped})")
        info("duck_codex2cc 模型映射:")
        for cm, gm in DUCK_CODEX2CC_MODEL_MAP.items():
            info(f"  {cm} → {gm}")
    elif provider == "quotio":
        env["ANTHROPIC_BASE_URL"] = QUOTIO_BASE_URL
        env["ANTHROPIC_AUTH_TOKEN"] = ensure_key("QUOTIO_API_KEY", keys["quotio"])

        target_model, reason = resolve_cc_model_for_quotio(current_model)
        data["model"] = target_model
        if reason:
            warn(reason)
        info("Quotio Claude allowlist: claude-opus-4-6-thinking, claude-sonnet-4-6")

    elif provider == "antigravity":
        env["ANTHROPIC_BASE_URL"] = ANTIGRAVITY_BASE_URL
        env["ANTHROPIC_AUTH_TOKEN"] = ensure_key("ANTIGRAVITY_API_KEY", keys["antigravity"])

        # Reuse quotio model resolution (same model set)
        target_model, reason = resolve_cc_model_for_quotio(current_model)
        data["model"] = target_model
        if reason:
            warn(reason)
        info("Antigravity Claude allowlist: claude-opus-4-6-thinking, claude-sonnet-4-6")

    elif provider == "icodeeasy":
        env["ANTHROPIC_BASE_URL"] = ICODEEASY_BASE_URL
        env["ANTHROPIC_AUTH_TOKEN"] = ensure_key("ICODEEASY_API_KEY", keys["icodeeasy"])
        env["CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC"] = "1"
        env["CLAUDE_CODE_ATTRIBUTION_HEADER"] = "0"
        info("iCodeEasy: Anthropic 原生 API (api.icodeeasy.cc), 支持所有 Claude 模型")

    save_json(cfg.cc_settings, data)
    ok(f"Claude Code → {provider}")


