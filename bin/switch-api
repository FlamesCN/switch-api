                    "provider": "custom:aiwave",
                    "api_mode": "chat_completions",
                    "env_keys": [AIWAVE_GEMINI_GCP_ENV_KEY, AIWAVE_GEMINI_ENV_KEY],
                },
            },
            "icodeeasy": {
                "available_models": list(ICODEEASY_AVAILABLE_MODELS),
                "base_url": ICODEEASY_BASE_URL,
                "protocols": ["anthropic", "openai", "gemini"],
                "claude_code": {
                    "note": "Claude Code 使用 Anthropic 原生链路",
                },
                "openclaw": {
                    "default_model": f"icodeeasy/{ICODEEASY_OPENCLAW_MODEL}",
                    "note": "当前 OpenClaw 仍走 anthropic-messages，只支持 Claude 模型",
                },
                "codex": {
                    "default_model": ICODEEASY_CODEX_MODEL,
                    "provider_block": "icodeeasy",
                },
                "gemini": {
                    "default_model": ICODEEASY_GEMINI_MODEL,
                },
                "note": "统一网关；实际可用模型以服务端鉴权结果为准",
            },
        }
