        self.cx_config = self.codex_home / "config.toml"
        self.codex_kimi_catalog = (
            self.codex_home / "model-catalogs" / FLAMES_KIMI_CODEX_CATALOG_FILENAME
        )
        self.codex_flames_catalog = (
            self.codex_home / "model-catalogs" / FLAMES_CODEX_CATALOG_FILENAME
        )
        self.codex_deepseek_catalog = (
            self.codex_home / "model-catalogs" / DEEPSEEK_CODEX_CATALOG_FILENAME
        )
        self.codex_openrouter_catalog = (
            self.codex_home / "model-catalogs" / OPENROUTER_CODEX_CATALOG_FILENAME
        )
        self.factory_settings = home / ".factory/settings.json"
        self.gemini_env = home / ".gemini/.env"
        self.gemini_balance_env = home / "tools/gemini-balance/.env"
        self.oc_env = home / ".openclaw/.env"
        self.bashrc = home / ".bashrc"
        self.zshrc = home / ".zshrc"
        self.hermes_dir = home / ".hermes"
        self.hermes_config = self.hermes_dir / "config.yaml"
        self.hermes_profiles_dir = self.hermes_dir / "profiles"
