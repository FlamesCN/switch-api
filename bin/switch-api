        if anthropic_cfg is not None:
            available_models.extend(normalize_available_models(anthropic_cfg.get("available_models") or []))
            entry["claude_code"] = {
                "default_model": anthropic_cfg["default_model"],
                "base_url": anthropic_cfg["base_url"],
                "env_key": anthropic_cfg["env_key"],
                "extra_env": dict(anthropic_cfg.get("extra_env") or {}),
                "available_models": list(anthropic_cfg.get("available_models") or []),
                "model_discovery": dict(anthropic_cfg.get("model_discovery") or {}),
            }
        if openai_cfg is not None:
            available_models.extend(normalize_available_models(openai_cfg.get("available_models") or []))
        if openai_cfg is not None and "codex" in spec["tools"]:
            entry["codex"] = {
                "default_model": openai_cfg["default_model"],
                "provider_block": name,
                "env_key": openai_cfg["env_key"],
                "wire_api": openai_cfg["codex_wire_api"],
                "features": dict(openai_cfg["codex_features"]),
                "available_models": list(openai_cfg.get("available_models") or []),
                "model_discovery": dict(openai_cfg.get("model_discovery") or {}),
            }
        if openai_cfg is not None and "openclaw" in spec["tools"]:
            entry["openclaw"] = {
                "default_model": f"{name}/{openai_cfg['default_model']}",
                "api": openai_cfg["openclaw_api"],
            }
        if openai_cfg is not None and "droid" in spec["tools"]:
            entry["droid"] = {
                "default_model": openai_cfg["default_model"],
            }
        if openai_cfg is not None and "hermes" in spec["tools"]:
            entry["hermes"] = {
                "default_model": openai_cfg["default_model"],
                "provider": f"custom:{name}",
                "api_mode": openai_cfg["hermes_api_mode"],
            }
        if openai_cfg is not None and "grok" in spec["tools"]:
            entry["grok"] = {
                "default_model": openai_cfg["default_model"],
                "managed_model": GROK_MANAGED_MODEL_NAME,
                "api_backend": "responses" if openai_cfg["codex_wire_api"] == "responses" else "chat_completions",
                "env_key": openai_cfg["env_key"],
            }
        if available_models:
            deduped: List[str] = []
            for model_id in available_models:
                if model_id not in deduped:
                    deduped.append(model_id)
            entry["available_models"] = deduped
        catalog["providers"][name] = entry
    return catalog


def save_provider_model_catalog(path: Path, custom_store: Dict[str, Any] | None = None) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(
        json.dumps(provider_model_catalog(custom_store), ensure_ascii=False, indent=2) + "\n",
        encoding="utf-8",
    )
    try:
        tmp.chmod(0o600)
    except Exception:
        pass
    os.replace(tmp, path)


def mask_secret(value: str) -> str:
    if len(value) <= 8:
        return "*" * len(value)
    return value[:4] + "…" + value[-4:]


def cmd_key_set(cfg: Config, store: Dict[str, str], env_key: str, value: str) -> None:
    key_name = validate_env_key_name(env_key)
    if not value.strip():
        raise SwitchError("Key value must not be empty")
    secret = value.strip()
    store[key_name] = secret
    slot = ENV_KEY_PROVIDER_SLOTS.get(key_name)
    if slot:
        store[slot] = secret
    save_credential_store(cfg.cred_file, store)
    sync_shared_shell_env(cfg, {key_name: secret})
    ok(f"Saved key → {key_name}")
    info(f"credentials: {cfg.cred_file}")
    info(f"shell env: {cfg.home / '.env'}")
    info("Ensured ~/.bashrc and ~/.zshrc load ~/.env")


def cmd_key_list(store: Dict[str, str]) -> None:
    env_keys = sorted(key for key in store if ENV_KEY_NAME_RE.match(key))
    if not env_keys:
        print("No env-style keys saved in credentials store.")
        return
    print("Saved env-style keys:")
    for key in env_keys:
        print(f"  {key:<32} {mask_secret(store[key])}")


def merge_custom_provider_record(existing: Dict[str, Any], incoming: Dict[str, Any]) -> Dict[str, Any]:
    payload: Dict[str, Any] = {"name": incoming["name"]}

    if isinstance(existing, dict):
        if isinstance(existing.get("openai"), dict):
            payload["openai"] = dict(existing["openai"])
        if isinstance(existing.get("anthropic"), dict):
            payload["anthropic"] = dict(existing["anthropic"])

    if isinstance(incoming.get("openai"), dict):
        payload["openai"] = dict(incoming["openai"])
    if isinstance(incoming.get("anthropic"), dict):
        payload["anthropic"] = dict(incoming["anthropic"])

    return normalize_custom_provider_spec(incoming["name"], payload)


def cmd_provider_add_openai(cfg: Config, spec: Dict[str, Any]) -> None:
    if not spec.get("default_model"):
        raise SwitchError("Custom provider default_model must not be empty")
    store = load_custom_provider_store(cfg.custom_providers_file)
    providers = custom_provider_map(store)
    providers[spec["name"]] = merge_custom_provider_record(providers.get(spec["name"], {}), spec)
    save_custom_provider_store(cfg.custom_providers_file, {"providers": providers})
    ok(f"Saved custom OpenAI-compatible provider → {spec['name']}")
    info(f"base_url={spec['base_url']}")
    info(f"env_key={spec['env_key']}")
    info(f"default_model={spec['default_model']}")
    info(f"tools={','.join(spec['openai']['tools'])}")


def cmd_provider_add_anthropic(cfg: Config, spec: Dict[str, Any]) -> None:
    anthropic_cfg = spec.get("anthropic") if isinstance(spec.get("anthropic"), dict) else None
    if anthropic_cfg is None or not anthropic_cfg.get("default_model"):
        raise SwitchError("Custom anthropic provider default_model must not be empty")
    store = load_custom_provider_store(cfg.custom_providers_file)
    providers = custom_provider_map(store)
    providers[spec["name"]] = merge_custom_provider_record(providers.get(spec["name"], {}), spec)
    save_custom_provider_store(cfg.custom_providers_file, {"providers": providers})
    ok(f"Saved custom Anthropic-compatible provider → {spec['name']}")
    info(f"base_url={anthropic_cfg['base_url']}")
    info(f"env_key={anthropic_cfg['env_key']}")
    info(f"default_model={anthropic_cfg['default_model']}")
    if anthropic_cfg.get("extra_env"):
        info("extra_env=" + ",".join(f"{key}={value}" for key, value in sorted(anthropic_cfg["extra_env"].items())))
    info("tools=cc")


def sync_custom_provider_specs(
    cfg: Config,
    store: Dict[str, str],
    *,
    provider_name: str = "",
) -> Dict[str, Any]:
    provider_store = load_custom_provider_store(cfg.custom_providers_file)
    providers = custom_provider_map(provider_store)
    if not providers:
        raise SwitchError("No custom providers registered.")

    target_names = [validate_custom_provider_name(provider_name)] if provider_name else sorted(providers)
    changed = False
    for name in target_names:
        if name not in providers:
            raise SwitchError(f"Custom provider not found: {name}")
        synced_spec, notes = sync_custom_provider_model_cache(providers[name], store)
        providers[name] = synced_spec
        changed = True
        for note in notes:
            info(f"{name}: {note}")

    if changed:
        save_custom_provider_store(cfg.custom_providers_file, {"providers": providers})
        save_provider_model_catalog(cfg.provider_models_file, {"providers": providers})
    return {"providers": providers}


def cmd_provider_sync_models(cfg: Config, store: Dict[str, str], provider_name: str = "") -> None:
    synced = sync_custom_provider_specs(cfg, store, provider_name=provider_name)
    names = [provider_name] if provider_name else sorted(custom_provider_map(synced))
    ok("Synced model catalogs → " + ",".join(names))


def cmd_provider_export(
    cfg: Config,
    store: Dict[str, str],
    *,
    name: str = "",
    out_path: str = "",
    include_secrets: bool = False,
    export_all: bool = False,
) -> None:
    provider_store = load_custom_provider_store(cfg.custom_providers_file)
    providers = custom_provider_map(provider_store)
    if not providers:
        raise SwitchError("No custom providers registered.")

    selected_names = sorted(providers) if export_all else [validate_custom_provider_name(name)]
    bundle = build_provider_export_bundle(
        providers,
        store,
        names=selected_names,
        include_secrets=include_secrets,
    )
    rendered = json.dumps(bundle, ensure_ascii=False, indent=2) + "\n"

    if not out_path or out_path == "-":
        print(rendered, end="")
        return

    target_path = resolve_cli_path(out_path)
    target_path.parent.mkdir(parents=True, exist_ok=True)
    target_path.write_text(rendered, encoding="utf-8")
    ok(f"Exported custom provider bundle → {target_path}")
    info(
        f"providers={','.join(selected_names)}"
        + (" (with secrets)" if include_secrets else "")
    )


def cmd_provider_import(cfg: Config, store: Dict[str, str], source_path: str, *, replace: bool = False) -> None:
    source = (source_path or "").strip()
    if not source:
        raise SwitchError("Provider import source path must not be empty")

    if source == "-":
        raw_text = sys.stdin.read()
        source_label = "<stdin>"
    else:
        source_file = resolve_cli_path(source)
        if not source_file.exists():
            raise SwitchError(f"Provider import file not found: {source_file}")
        raw_text = source_file.read_text(encoding="utf-8")
        source_label = str(source_file)

    try:
        payload = json.loads(raw_text)
    except Exception as ex:
        raise SwitchError(f"Failed to parse provider import JSON: {source_label}: {ex}")

    bundle = normalize_provider_import_bundle(payload)
    existing = {} if replace else custom_provider_map(load_custom_provider_store(cfg.custom_providers_file))
    merged = dict(existing)
    merged.update(bundle["providers"])
    save_custom_provider_store(cfg.custom_providers_file, {"providers": merged})

    imported_env_values = dict(bundle["env_values"])
    if imported_env_values:
        store.update(imported_env_values)
        save_credential_store(cfg.cred_file, store)
        sync_shared_shell_env(cfg, imported_env_values)

    save_provider_model_catalog(cfg.provider_models_file, load_custom_provider_store(cfg.custom_providers_file))
    ok(
        f"Imported custom provider bundle ← {source_label}"
        + (" (replace)" if replace else " (merge)")
    )
    info("providers=" + ",".join(sorted(bundle["providers"])))
    if imported_env_values:
        info("env_keys=" + ",".join(sorted(imported_env_values)))


def cmd_provider_list(cfg: Config) -> None:
    store = load_custom_provider_store(cfg.custom_providers_file)
    providers = custom_provider_map(store)
    if not providers:
        print("No custom providers registered.")
        return
    print("Custom providers:")
    for name in sorted(providers):
        spec = providers[name]
        openai_cfg = spec.get("openai") if isinstance(spec.get("openai"), dict) else None
        anthropic_cfg = spec.get("anthropic") if isinstance(spec.get("anthropic"), dict) else None

        print(f"  {name:<18} tools={','.join(spec['tools'])}")
        if openai_cfg is not None:
            feature_flags = []
            for feature_name, enabled in sorted((openai_cfg.get("codex_features") or {}).items()):
                feature_flags.append(f"{feature_name}={'on' if enabled else 'off'}")
            extras = f" features[{', '.join(feature_flags)}]" if feature_flags else ""
            if openai_cfg.get("available_models"):
                extras += f" models[{len(openai_cfg.get('available_models') or [])}]"
            print(
                f"    openai     {openai_cfg['base_url']}  "
                f"env={openai_cfg['env_key']}  model={openai_cfg['default_model']}  "
                f"tools={','.join(openai_cfg['tools'])}{extras}"
            )
        if anthropic_cfg is not None:
            extras = ""
            if anthropic_cfg.get("extra_env"):
                extras = " extra_env[" + ", ".join(
                    f"{key}={value}" for key, value in sorted(anthropic_cfg["extra_env"].items())
                ) + "]"
            if anthropic_cfg.get("available_models"):
                extras += f" models[{len(anthropic_cfg.get('available_models') or [])}]"
            print(
                f"    anthropic  {anthropic_cfg['base_url']}  "
                f"env={anthropic_cfg['env_key']}  model={anthropic_cfg['default_model']}{extras}"
            )


def cmd_provider_remove(cfg: Config, name: str) -> None:
    provider_name = validate_custom_provider_name(name)
    store = load_custom_provider_store(cfg.custom_providers_file)
    providers = custom_provider_map(store)
    if provider_name not in providers:
        raise SwitchError(f"Custom provider not found: {provider_name}")
    del providers[provider_name]
    save_custom_provider_store(cfg.custom_providers_file, {"providers": providers})
    ok(f"Removed custom provider → {provider_name}")


def cmd_model_override_add(cfg: Config, provider: str, model: str, tools: List[str], vision: bool) -> None:
    if provider not in PROVIDERS:
        raise SwitchError("Model overrides support built-in providers only: " + ", ".join(PROVIDERS))
    if provider in custom_provider_map(load_custom_provider_store(cfg.custom_providers_file)):
        raise SwitchError(f"{provider} is a custom provider; use provider add/sync-models instead")
    model_id = model.strip()
    if not model_id or any(char.isspace() for char in model_id):
        raise SwitchError("Model id must be non-empty and contain no whitespace")
    normalized_tools = normalize_model_override_tools(tools, provider)
    overrides = load_model_overrides(cfg)
    overrides.setdefault(provider, {})[model_id] = {
        "tools": normalized_tools,
        "vision": bool(vision),
    }
    save_model_overrides(cfg, overrides)
    ok(f"Registered model override → {provider}/{model_id}")
    info(f"tools={','.join(normalized_tools)} vision={'on' if vision else 'off'}")


def cmd_model_override_remove(cfg: Config, provider: str, model: str) -> None:
    overrides = load_model_overrides(cfg)
    models = overrides.get(provider, {})
    if model not in models:
        raise SwitchError(f"Model override not found: {provider}/{model}")
    del models[model]
    if not models:
        overrides.pop(provider, None)
    save_model_overrides(cfg, overrides)
    ok(f"Removed model override → {provider}/{model}")


def cmd_model_override_list(cfg: Config) -> None:
    entries = load_model_overrides(cfg)
    if not entries:
        print("No built-in model overrides registered.")
        return
    print("Built-in model overrides:")
    for provider in sorted(entries):
        for model, spec in sorted(entries[provider].items()):
            print(
                f"  {provider:<9} {model:<40} "
                f"tools={','.join(spec['tools'])} vision={'on' if spec['vision'] else 'off'}"
            )


def resolve_cc_model_for_quotio(current_model: str) -> Tuple[str, str]:
    m = (current_model or "").strip()
    if not m:
        return QUOTIO_CC_DEFAULT_MODEL, "Claude Code model empty; set to quotio default claude-opus-4-6-thinking"

    if m in QUOTIO_CC_ALLOWED_MODELS:
        return m, ""

    if m in QUOTIO_CC_MODEL_FALLBACKS:
        return QUOTIO_CC_MODEL_FALLBACKS[m], f"Claude model {m} mapped to {QUOTIO_CC_MODEL_FALLBACKS[m]} for quotio"

    lm = m.lower()
    if "haiku" in lm:
        return "claude-sonnet-4-6", f"Claude model {m} mapped to claude-sonnet-4-6 (haiku fallback policy)"
    if "opus-4-5" in lm:
        return "claude-opus-4-6-thinking", f"Claude model {m} mapped to claude-opus-4-6-thinking (opus4.5 fallback policy)"

    return QUOTIO_CC_DEFAULT_MODEL, f"Claude model {m} is not in quotio allowlist; fallback to {QUOTIO_CC_DEFAULT_MODEL}"


def clear_cc_custom_model_env(env: Dict[str, str]) -> None:
    for key in (
        "ANTHROPIC_CUSTOM_MODEL_OPTION",
        "ANTHROPIC_CUSTOM_MODEL_OPTION_NAME",
        "ANTHROPIC_CUSTOM_MODEL_OPTION_DESCRIPTION",
    ):
        env.pop(key, None)


def clear_cc_model_alias_env(env: Dict[str, str]) -> None:
    for key in CC_MODEL_ALIAS_ENV_KEYS:
        env.pop(key, None)


def resolve_cc_model_for_flames(current_model: str, requested_model: str) -> Tuple[str, str]:
    requested = (requested_model or "").strip()
    if requested:
        return requested, ""

    current = (current_model or "").strip()
    if current == FLAMES_CC_DEFAULT_MODEL:
        return current, ""

    return FLAMES_CC_DEFAULT_MODEL, (
        f"Claude Code model {current or '?'} replaced by flames default "
        f"{FLAMES_CC_DEFAULT_MODEL}"
    )


def resolve_cc_model_for_deepseek(current_model: str, requested_model: str) -> Tuple[str, str]:
    requested = (requested_model or "").strip()
    if requested:
        return requested, ""

    current = (current_model or "").strip()
    if current in DEEPSEEK_AVAILABLE_MODELS:
        return current, ""

    return DEEPSEEK_CC_DEFAULT_MODEL, (
        f"Claude Code model {current or '?'} is not in deepseek allowlist; "
        f"fallback to {DEEPSEEK_CC_DEFAULT_MODEL}"
    )


def resolve_openclaw_primary_for_quotio(current_primary: str) -> Tuple[str, str]:
    p = (current_primary or "").strip()
    if not p:
        return QUOTIO_OPENCLAW_DEFAULT_PRIMARY, "OpenClaw primary empty; set to quotio default quotio/claude-opus-4-6-thinking"

    if p in QUOTIO_OPENCLAW_ALLOWED_PRIMARY:
        return p, ""

    if p in QUOTIO_OPENCLAW_PRIMARY_FALLBACKS:
        t = QUOTIO_OPENCLAW_PRIMARY_FALLBACKS[p]
        return t, f"OpenClaw primary {p} mapped to {t} for quotio"

    lp = p.lower()
    if "haiku" in lp:
        return "quotio/claude-sonnet-4-6", f"OpenClaw primary {p} mapped to quotio/claude-sonnet-4-6 (haiku fallback policy)"
    if "opus-4-5" in lp:
        return "quotio/claude-opus-4-6-thinking", f"OpenClaw primary {p} mapped to quotio/claude-opus-4-6-thinking (opus4.5 fallback policy)"

    return QUOTIO_OPENCLAW_DEFAULT_PRIMARY, f"OpenClaw primary {p} is not in quotio allowlist; fallback to {QUOTIO_OPENCLAW_DEFAULT_PRIMARY}"


def resolve_openclaw_duck_profile(profile: str) -> Tuple[str, str]:
    p = profile.lower().strip() if profile else "default"
    if not p or p == "default":
        target = OPENCLAW_DUCK_PROFILE_TO_PRIMARY["default"]
        return target, f"OpenClaw duck profile default -> {target}"
    if p not in OPENCLAW_DUCK_PROFILE_TO_PRIMARY:
        raise SwitchError(
            f"Unknown openclaw duck profile: {profile} (use one of: {', '.join(OPENCLAW_DUCK_PROFILE_NAMES)})"
        )
    target = OPENCLAW_DUCK_PROFILE_TO_PRIMARY[p]
    return target, f"OpenClaw duck profile {profile} -> {target}"


def resolve_openclaw_quotio_profile(profile: str) -> Tuple[str, str]:
    p = (profile or "").strip().lower()
    if not p:
        target = OPENCLAW_QUOTIO_PROFILE_TO_PRIMARY["default"]
        return target, f"OpenClaw quotio profile default -> {target}"

    if p not in OPENCLAW_QUOTIO_PROFILE_TO_PRIMARY:
        raise SwitchError(
            f"Unknown openclaw quotio profile: {profile} (use one of: {', '.join(OPENCLAW_QUOTIO_PROFILE_NAMES)})"
        )

    target = OPENCLAW_QUOTIO_PROFILE_TO_PRIMARY[p]
    return target, f"OpenClaw quotio profile {p} -> {target}"



def resolve_openclaw_antigravity_profile(profile: str) -> Tuple[str, str]:
    p = (profile or "").strip().lower()
    if not p:
        target = OPENCLAW_ANTIGRAVITY_PROFILE_TO_PRIMARY["default"]
        return target, f"OpenClaw antigravity profile default -> {target}"

    if p not in OPENCLAW_ANTIGRAVITY_PROFILE_TO_PRIMARY:
        raise SwitchError(
            f"Unknown openclaw antigravity profile: {profile} (use one of: {', '.join(OPENCLAW_ANTIGRAVITY_PROFILE_NAMES)})"
        )

