            "dialogDescription": "Gemini 3.1 Pro gateway model",
            "isVisible": True,
        },
        "gemini-3.1-pro-preview-customtools": {
            "tier": "standard",
            "family": "gemini-3.1",
            "displayName": f"Gemini 3.1 Pro Tools ({provider_label})",
            "dialogDescription": "Gemini 3.1 Pro gateway model with custom tools",
            "isVisible": True,
        },
        "gemini-3.1-flash-lite": {
            "tier": "standard",
            "family": "gemini-3.1",
            "displayName": f"Gemini 3.1 Flash Lite ({provider_label})",
            "dialogDescription": "Lightweight Gemini 3.1 gateway model",
            "isVisible": True,
        },
        "gemini-2.5-flash": {
            "tier": "standard",
            "family": "gemini-2.5",
            "displayName": f"Gemini 2.5 Flash ({provider_label})",
            "dialogDescription": "Compatible Gemini 2.5 gateway model",
            "isVisible": True,
        },
    }


def update_gemini_cli_settings(provider: str, cfg: Config, model: str = "") -> None:
    target_model = model or GEMINI_CLI_MODELS.get(provider, "gemini-3.1-pro-preview")
    # Gemini CLI currently honors GOOGLE_GEMINI_BASE_URL at request time, but its
    # auth validation/UI path does not fully support selectedType="gateway".
    # Keep auth on gemini-api-key so startup validation passes while requests still
    # route through the custom Google-compatible gateway from ~/.gemini/.env.
    selected_type = "gemini-api-key"

    def mutate(data: Dict[str, Any]) -> Dict[str, Any]:
        security = data.setdefault("security", {})
        auth = security.setdefault("auth", {})
        auth["selectedType"] = selected_type

        model_cfg = data.setdefault("model", {})
        model_cfg["name"] = target_model

        # Enable dynamic model config so gateway-backed Gemini models show up explicitly.
        experimental = data.setdefault("experimental", {})
        experimental["dynamicModelConfiguration"] = True

        model_configs = data.setdefault("modelConfigs", {})
        model_definitions = model_configs.setdefault("modelDefinitions", {})
        model_definitions.update(_gemini_gateway_model_definitions(provider))
        return data

    backup(cfg.home / ".gemini" / "settings.json")
    update_json_file(cfg.home / ".gemini" / "settings.json", mutate)
    info(f"Synced ~/.gemini/settings.json → auth={selected_type}, model={target_model}")


def _write_factory_custom_models(settings_path: Path, models: list) -> None:
    """Write customModels to ~/.factory/settings.json, preserving other keys.
    Also updates sessionDefaultSettings.model to auto-select the first custom model."""
    existing: Dict[str, Any] = {}
    if settings_path.exists():
        try:
            existing = json.loads(settings_path.read_text(encoding="utf-8"))
        except (json.JSONDecodeError, OSError):
            pass
    existing["customModels"] = models
    # Auto-set default model to the first custom model
    if models and isinstance(models[0], dict) and models[0].get("displayName"):
        display_name = models[0]["displayName"]
        custom_id = f"custom:{display_name.replace(' ', '-')}-0"
        session_defaults = existing.setdefault("sessionDefaultSettings", {})
        session_defaults["model"] = custom_id
        info(f"  sessionDefaultSettings.model → {custom_id}")
    settings_path.parent.mkdir(parents=True, exist_ok=True)
    write_text(settings_path, json.dumps(existing, indent=2) + "\n")



def _clear_factory_custom_models(settings_path: Path) -> None:
    """Remove customModels from ~/.factory/settings.json if present.
    Also resets sessionDefaultSettings.model if it was a custom model."""
    if not settings_path.exists():
        return
    try:
        existing = json.loads(settings_path.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, OSError):
        return
    changed = False
    if "customModels" in existing:
        del existing["customModels"]
        changed = True
    # Reset custom model default
    session_defaults = existing.get("sessionDefaultSettings", {})
    if isinstance(session_defaults, dict) and str(session_defaults.get("model", "")).startswith("custom:"):
        del session_defaults["model"]
        changed = True
    if changed:
        write_text(settings_path, json.dumps(existing, indent=2) + "\n")


def update_gemini_cli_env(provider: str, cfg: Config, keys: Dict[str, str], model: str = "") -> None:
    """Keep ~/.gemini/.env in sync with the current provider.
    Ensures GOOGLE_GEMINI_BASE_URL points to the same provider as GEMINI_API_KEY in ~/.env."""
    key_slot = GEMINI_CLI_KEY_MAP.get(provider)
    if not key_slot:
        return
    api_key = resolve_aiwave_gemini_key(keys) if provider == "aiwave" else keys.get(key_slot, "")
    if not api_key:
        warn(f"No API key for Gemini CLI ({provider}), skipping .gemini/.env update")
        return
    base_url = GEMINI_CLI_BASE_URLS.get(provider, DUCK_BASE_URL)
    target_model = model or GEMINI_CLI_MODELS.get(provider, "gemini-3.1-pro-preview")
    backup(cfg.gemini_env)
    cfg.gemini_env.parent.mkdir(parents=True, exist_ok=True)
    content = (
        f"GOOGLE_GEMINI_BASE_URL={base_url}\n"
        f"GEMINI_API_KEY={api_key}\n"
        f"GEMINI_MODEL={target_model}\n"
    )
    write_text(cfg.gemini_env, content)
    info(f"Synced ~/.gemini/.env → {provider} (GOOGLE_GEMINI_BASE_URL={base_url}, model={target_model})")


def update_gemini_balance_env(provider: str, cfg: Config, keys: Dict[str, str], model: str = "") -> None:
    env_path = cfg.gemini_balance_env
    if not env_path.exists():
        raise SwitchError(f"gemini-balance env not found: {env_path}")

    if provider != "gemini-balance":
        return

    info("tools/gemini-balance/.env kept in local service mode")


def switch_gemini_cli(provider: str, cfg: Config, keys: Dict[str, str], model: str = "") -> None:
    """Switch Gemini CLI to a different provider.
    Also updates ~/.env GEMINI_API_KEY (shared with Droid)."""
    if skip_redundant_switch("gemini", provider, cfg, model):
        return
    info(f"Switching Gemini CLI → {provider}")
    key_slot = GEMINI_CLI_KEY_MAP.get(provider)
    if not key_slot:
        raise SwitchError(f"No Gemini CLI key mapping for provider: {provider}")
    if provider == "aiwave":
        api_key = ensure_key(
            f"{AIWAVE_GEMINI_GCP_ENV_KEY}/{AIWAVE_GEMINI_ENV_KEY}",
            resolve_aiwave_gemini_key(keys),
            f"required for Gemini CLI {provider}",
        )
    elif provider == "gemini-balance":
        api_key = ensure_key(
            "GEMINI_BALANCE_AUTH_TOKEN",
            keys.get("gemini_balance_token", ""),
            f"required for Gemini CLI {provider}",
        )
    else:
        api_key = ensure_key(f"API key ({key_slot})", keys.get(key_slot, ""), f"required for Gemini CLI {provider}")

    update_gemini_cli_env(provider, cfg, keys, model=model)
    update_gemini_cli_settings(provider, cfg, model=model)
    if provider == "gemini-balance":
        update_gemini_balance_env(provider, cfg, keys, model=model)

    sync_shared_shell_env(cfg, {"GEMINI_API_KEY": api_key})
    warn("GEMINI_API_KEY in ~/.env updated — this also affects Droid")
    ok(f"Gemini CLI → {provider} (run 'source ~/.zshrc' in zsh if needed)")


def _ensure_hermes_custom_provider_entry(config: Dict[str, Any], name: str, base_url: str) -> Dict[str, Any]:
    providers = config.get("custom_providers")
    if not isinstance(providers, list):
        providers = []
        config["custom_providers"] = providers

    lowered = name.strip().lower()
    for entry in providers:
        if not isinstance(entry, dict):
            continue
        if str(entry.get("name") or "").strip().lower() == lowered:
            entry["name"] = name
            entry["base_url"] = base_url
            return entry

    entry = {"name": name, "base_url": base_url}
    providers.append(entry)
    return entry


def switch_hermes(
    provider: str,
    cfg: Config,
    keys: Dict[str, str],
    model: str = "",
    *,
    profile_name: str = "",
    all_profiles: bool = False,
) -> None:
    if not profile_name and not all_profiles and skip_redundant_switch("hermes", provider, cfg, model):
        return
    info(f"Switching Hermes → {provider}")

    if provider == "molifang":
        provider_name = "molifang"
        base_url = MOLIFANG_BASE_URL_V1
        api_key = ensure_key(MOLIFANG_ENV_KEY, keys["molifang"], "required for Hermes molifang")
        target_model = model or MOLIFANG_MODEL
        registered_m = target_model in model_override_entries(cfg, provider="molifang", tool="hermes")
        if target_model not in MOLIFANG_AVAILABLE_MODELS and not registered_m:
            raise SwitchError(f"Molifang only supports {MOLIFANG_MODEL}; requested: {target_model}")
        api_mode = "codex_responses"
    elif provider == "flames":
        provider_name = "flames"
        base_url = FLAMES_NEWAPI_BASE_URL_V1
        api_key = ensure_key("FLAMES_API_KEY", keys["flames"], "required for Hermes flames")
        target_model = model or FLAMES_DEFAULT_MODEL
        api_mode = "codex_responses"
    elif provider == "aiwave":
        provider_name = "aiwave"
        base_url = AIWAVE_BASE_URL_V1
        api_key = ensure_key(
            f"{AIWAVE_GEMINI_GCP_ENV_KEY}/{AIWAVE_GEMINI_ENV_KEY}",
            resolve_aiwave_gemini_key(keys),
            "required for Hermes aiwave Gemini",
        )
        target_model = model or AIWAVE_GEMINI_MODEL
        api_mode = "chat_completions"
    else:
        raise SwitchError(f"Hermes provider not supported yet: {provider}")

    config_paths = resolve_hermes_config_paths(
        cfg,
        profile_name=profile_name,
        all_profiles=all_profiles,
    )

    for config_path in config_paths:
        backup(config_path)
        data = load_yaml(config_path)
        model_cfg = data.get("model")
        if not isinstance(model_cfg, dict):
            model_cfg = {"default": str(model_cfg or "").strip()} if model_cfg else {}
            data["model"] = model_cfg
        model_cfg["default"] = target_model
        model_cfg["provider"] = f"custom:{provider_name}"
        model_cfg["base_url"] = base_url
        model_cfg["api_key"] = api_key
        model_cfg["api_mode"] = api_mode

        custom_entry = _ensure_hermes_custom_provider_entry(data, provider_name, base_url)
        custom_entry["api_key"] = api_key
        custom_entry["api_mode"] = api_mode
        custom_entry["model"] = target_model

        save_yaml(config_path, data)
        info(f"Updated {config_path}")

    scope = profile_name or ("all-profiles" if all_profiles else "root")
    ok(f"Hermes[{scope}] → {provider} / {target_model}")


def switch_droid(provider: str, cfg: Config, keys: Dict[str, str], profile: str = "", model: str = "") -> None:
    if skip_redundant_switch("droid", provider, cfg, model):
        return
    p = profile.lower() if profile else "default"
    info(f"Switching Droid → {provider}" + (f" (profile: {p})" if p != "default" else ""))

    if provider == "duck":
        _clear_factory_custom_models(cfg.factory_settings)
        d_key = ensure_key(
            "DUCK_GEMINI_API_KEY/GEMINI_API_KEY", keys["duck_gemini"], "required for Droid duck"
        )
        droid_model = model or DUCK_DROID_MODEL
        sync_shared_shell_env(
            cfg,
            {
                "GEMINI_BASE_URL": DUCK_BASE_URL_V1,
                "GEMINI_API_KEY": d_key,
                "GEMINI_MODEL": droid_model,
            },
        )
        ok(f"Droid → duck / {droid_model} (run 'source ~/.zshrc' or reopen shell to apply)")
        update_gemini_cli_env(provider, cfg, keys, model=droid_model)

    elif provider == "quotio":
        q_key = ensure_key("QUOTIO_API_KEY", keys["quotio"], "required for Droid quotio")

        if model:
            # Explicit model (e.g. gpt-5.3-codex) → customModels, same as quotio_local
            droid_model = model
            _write_factory_custom_models(cfg.factory_settings, [
                {
                    "model": droid_model,
                    "displayName": f"Quotio {droid_model}",
                    "baseUrl": QUOTIO_BASE_URL_V1,
                    "apiKey": q_key,
                    "provider": "openai",
                }
            ])
            ok(f"Droid → quotio / {droid_model}")
            info(f"  Written to {cfg.factory_settings}")
            info(f'  In Droid: /model → select "Quotio {droid_model}" under Custom Models')
        else:
            mode, droid_model = DROID_QUOTIO_PROFILE_TO_MODEL.get(p, ("gemini", QUOTIO_DROID_MODEL))

            if mode == "codex":
                # Codex profile → write to ~/.factory/settings.json customModels
                _write_factory_custom_models(cfg.factory_settings, [
                    {
                        "model": droid_model,
                        "displayName": f"Quotio {droid_model}",
                        "baseUrl": QUOTIO_BASE_URL_V1,
                        "apiKey": q_key,
                        "provider": "openai",
                    }
                ])
                ok(f"Droid → quotio codex / {droid_model}")
                info(f"  Written to {cfg.factory_settings}")
                info(f'  In Droid: /model → select "Quotio {droid_model}" under Custom Models')
                info(f'  Or: droid exec --model "custom:Quotio-{droid_model}-0" "prompt"')
            else:
                # Gemini mode → env vars (existing behavior)
                _clear_factory_custom_models(cfg.factory_settings)
                sync_shared_shell_env(
                    cfg,
                    {
                        "GEMINI_BASE_URL": QUOTIO_BASE_URL_V1,
                        "GEMINI_API_KEY": q_key,
                        "GEMINI_MODEL": droid_model,
                    },
                )
                ok(f"Droid → quotio / {droid_model} (run 'source ~/.zshrc' or reopen shell to apply)")
                update_gemini_cli_env(provider, cfg, keys)

    elif provider == "antigravity":
        _clear_factory_custom_models(cfg.factory_settings)
        a_key = ensure_key("ANTIGRAVITY_API_KEY", keys["antigravity"], "required for Droid antigravity")
        droid_model = model or ANTIGRAVITY_DROID_MODEL
        sync_shared_shell_env(
            cfg,
            {
                "GEMINI_BASE_URL": ANTIGRAVITY_BASE_URL_V1BETA,
                "GEMINI_API_KEY": a_key,
                "GEMINI_MODEL": droid_model,
            },
        )
        ok(f"Droid → antigravity / {droid_model} (run 'source ~/.zshrc' or reopen shell to apply)")
        update_gemini_cli_env(provider, cfg, keys, model=droid_model)

    elif provider == "xingyun":
        x_key = ensure_key("XINGYUN_API_KEY", keys["xingyun"], "required for Droid xingyun")
        droid_model = model or XINGYUN_DROID_MODEL
        _write_factory_custom_models(cfg.factory_settings, [
            {
                "model": droid_model,
                "displayName": f"Xingyun {droid_model}",
                "baseUrl": XINGYUN_BASE_URL_V1,
                "apiKey": x_key,
                "provider": "openai",
            }
        ])
        ok(f"Droid → xingyun / {droid_model}")
        info(f"  Written to {cfg.factory_settings}")
        info(f"  In Droid: /model → select \"Xingyun {droid_model}\" under Custom Models")

    elif provider == "molifang":
        m_key = ensure_key(MOLIFANG_ENV_KEY, keys["molifang"], "required for Droid molifang")
        droid_model = model or MOLIFANG_MODEL
        registered_m = droid_model in model_override_entries(cfg, provider="molifang", tool="droid")
        if droid_model not in MOLIFANG_AVAILABLE_MODELS and not registered_m:
            raise SwitchError(f"Molifang only supports {MOLIFANG_MODEL}; requested: {droid_model}")
        _write_factory_custom_models(cfg.factory_settings, [
            {
                "model": droid_model,
                "displayName": f"Molifang {droid_model}",
                "baseUrl": MOLIFANG_BASE_URL_V1,
                "apiKey": m_key,
                "provider": "openai",
            }
        ])
        ok(f"Droid → molifang / {droid_model}")
        info(f"  Written to {cfg.factory_settings}")
        info(f'  In Droid: /model → select "Molifang {droid_model}" under Custom Models')

    elif provider == "openrouter":
        or_key = ensure_key("OPENROUTER_API_KEY", keys["openrouter"], "required for Droid openrouter")
        droid_model = resolve_openrouter_model(model) if model else OPENROUTER_DROID_MODEL
        if not is_openrouter_free_model(droid_model):
            warn(
                "This OpenRouter model is paid — it uses account credits, "
                "not the :free daily quota (50/day, or 1000/day after $10 lifetime credits)."
            )
        _write_factory_custom_models(cfg.factory_settings, [
            {
                "model": droid_model,
                "displayName": f"OpenRouter {droid_model}",
                "baseUrl": OPENROUTER_BASE_URL_V1,
                "apiKey": or_key,
                "provider": "openai",
            }
        ])
        ok(f"Droid → openrouter / {droid_model}")
        info(f"  Written to {cfg.factory_settings}")
        info(f"  In Droid: /model → select \"OpenRouter {droid_model}\" under Custom Models")

    elif provider == "quotio_local":
        q_key = ensure_key("QUOTIO_API_KEY", keys["quotio"], "required for Droid quotio_local")
        droid_model = model or QUOTIO_LOCAL_DROID_MODEL
        _write_factory_custom_models(cfg.factory_settings, [
            {
                "model": droid_model,
                "displayName": f"Quotio-Local {droid_model}",
                "baseUrl": QUOTIO_LOCAL_BASE_URL_V1,
                "apiKey": q_key,
                "provider": "openai",
            }
        ])
        ok(f"Droid → quotio_local / {droid_model}")
        info(f"  Written to {cfg.factory_settings}")
        info(f"  In Droid: /model → select \"Quotio-Local {droid_model}\" under Custom Models")

    elif provider == "aiwave":
        aw_key = ensure_key(
            f"{AIWAVE_CODEX_ENV_KEY}/AIWAVE_API_KEY",
            keys["aiwave_codex"],
            "required for Droid aiwave",
        )
        droid_model = model or AIWAVE_DROID_CODEX_MODEL
        _write_factory_custom_models(cfg.factory_settings, [
            {
                "model": droid_model,
                "displayName": f"AI Wave {droid_model}",
                "baseUrl": AIWAVE_BASE_URL_V1,
                "apiKey": aw_key,
                "provider": "openai",
            }
        ])
        ok(f"Droid → aiwave codex / {droid_model}")
        info(f"  Written to {cfg.factory_settings}")
        info(f"  In Droid: /model → select \"AI Wave {droid_model}\" under Custom Models")

    elif provider == "openai" or provider in OPENAI_NAMED_PROVIDERS:
        key_slot = provider if provider in OPENAI_NAMED_PROVIDERS else "openai"
        tag = provider[7:] if provider in OPENAI_NAMED_PROVIDERS else ""
        display = f"OpenAI[{tag}]" if tag else "OpenAI"
        oa_key = ensure_key(f"{display}_API_KEY", keys[key_slot], f"required for Droid {provider}")
        droid_model = model or "gpt-5.3-codex"
        _write_factory_custom_models(cfg.factory_settings, [
            {
                "model": droid_model,
                "displayName": f"{display} {droid_model}",
                "baseUrl": OPENAI_BASE_URL_V1,
                "apiKey": oa_key,
                "provider": "openai",
            }
        ])
        ok(f"Droid → {provider} / {droid_model}")
        info(f"  Written to {cfg.factory_settings}")
        info(f"  In Droid: /model → select \"{display} {droid_model}\" under Custom Models")
        warn(f"需要 HTTPS_PROXY 走代理 ({XRAY_PROXY})")


