def restore_codex_model_catalog(cfg: Config, text: str) -> str:
    managed_paths = {
        str(cfg.codex_kimi_catalog),
        str(cfg.codex_flames_catalog),
        str(cfg.codex_deepseek_catalog),
        str(cfg.codex_openrouter_catalog),
    }
    if read_codex_top_level_string(text, "model_catalog_json") not in managed_paths:
        return text

    previous_path = ""
    if cfg.codex_catalog_state.exists():
        try:
            state = load_json(cfg.codex_catalog_state)
            previous_path = str(state.get("previous_model_catalog_json") or "").strip()
        except SwitchError:
            previous_path = ""
    if previous_path:
        return set_codex_top_level_string(text, "model_catalog_json", previous_path)
    return remove_codex_top_level_string(text, "model_catalog_json")


def skip_redundant_switch(tool: str, provider: str, cfg: Config, model: str = "") -> bool:
    """Skip config writes when the requested provider/model is already active."""
    try:
        current_provider = detect_provider(tool, cfg)
        current_model = detect_current_model(tool, cfg)
    except Exception:
        return False
    if current_provider != provider or (model and current_model != model):
        return False
    if tool == "codex" and provider == "flames":
        target_model = model or FLAMES_CODEX_DEFAULT_MODEL
        if current_model != target_model:
            return False
        if target_model == FLAMES_KIMI_CODEX_MODEL:
            text = read_text(cfg.cx_config) if cfg.cx_config.exists() else ""
            if not codex_kimi_catalog_is_ready(cfg, text):
                return False
        elif (
            model_family(target_model) == "deepseek"
            or target_model in FLAMES_OPENROUTER_MODELS
            or model_family(target_model) == "openrouter"
            or model_override_spec(cfg, "flames", target_model) is not None
        ):
            text = read_text(cfg.cx_config) if cfg.cx_config.exists() else ""
            if not codex_flames_catalog_is_ready(cfg, text):
                return False
    if tool == "codex" and provider == "deepseek":
        target_model = model or DEEPSEEK_CODEX_DEFAULT_MODEL
        if current_model != target_model:
            return False
        text = read_text(cfg.cx_config) if cfg.cx_config.exists() else ""
        if not codex_deepseek_catalog_is_ready(cfg, text):
            return False
    if tool == "codex" and provider == "openrouter":
        target_model = resolve_openrouter_model(model) if model else OPENROUTER_DEFAULT_MODEL
        if current_model != target_model:
            return False
        text = read_text(cfg.cx_config) if cfg.cx_config.exists() else ""
        if not codex_openrouter_catalog_is_ready(cfg, text):
            return False
    if tool == "grok":
        try:
            import tomllib

            tomllib.loads(read_text(cfg.grok_config))
        except Exception:
            return False
    if tool == "codex" and provider == "openai":
        text = read_text(cfg.cx_config) if cfg.cx_config.exists() else ""
        if re.search(r'^\s*model_provider\s*=\s*"', text, re.M):
            return False
    target = f"{provider} / {current_model}" if current_model not in ("", "?") else provider
    info(f"{tool} already uses {target}; skipping")
    return True


def repair_grok_config_text(text: str) -> str:
    """Recover the Grok config shape produced by older non-idempotent writes."""
    text = re.sub(r'("[^"\n]*")(\[model\.)', r'\1\n\2', text)
    headers = list(re.finditer(r'(?m)^\[model\.switch-api-provider\][ \t]*$', text))
    if len(headers) > 1:
        text = text[: headers[1].start()].rstrip() + "\n"
    return text


def remove_switch_api_managed_grok_tables(text: str) -> str:
    """Remove relay model tables previously written by switch-api."""
    text = repair_grok_config_text(text)
    section_re = re.compile(r"(?ms)^\[(?P<table>model\.[^\]\n]+)\][ \t]*$\n(?P<body>.*?)(?=^\[|\Z)")
    managed_marker = re.compile(
        r'^description[ \t]*=[ \t]*"Managed by switch-api \([^"\n]+\)"[ \t]*$',
        re.M,
    )
    spans: List[Tuple[int, int]] = []
    for section in section_re.finditer(text):
        if section.group("table") == f"model.{GROK_MANAGED_MODEL_NAME}" or managed_marker.search(section.group("body")):
            spans.append((section.start(), section.end()))
    for start, end in reversed(spans):
        text = text[:start].rstrip() + "\n\n" + text[end:].lstrip("\n")
    return text.rstrip() + "\n"


def stash_grok_auth_for_relay(cfg: Config) -> bool:
    """Keep Grok's cached xAI login from taking precedence over relay credentials."""
    if not cfg.grok_auth.exists():
        return False
    if cfg.grok_auth_relay_backup.exists():
        backup(cfg.grok_auth_relay_backup)
    cfg.grok_auth.replace(cfg.grok_auth_relay_backup)
    info(f"Saved xAI login state → {cfg.grok_auth_relay_backup}")
    return True


def restore_grok_auth_for_xai(cfg: Config) -> bool:
    """Restore the xAI login state saved while Grok used a relay."""
    if cfg.grok_auth.exists() or not cfg.grok_auth_relay_backup.exists():
        return False
    cfg.grok_auth_relay_backup.replace(cfg.grok_auth)
    info(f"Restored xAI login state → {cfg.grok_auth}")
    return True


def probe_model_curl(provider: str, model: str, keys: Dict[str, str]) -> Tuple[bool, str]:
    """Online verify a model by sending a minimal chat completion via curl."""
    endpoint_map = {
        "duck": (DUCK_BASE_URL_V1 + "/chat/completions", None),
        "quotio": (QUOTIO_BASE_URL_V1 + "/chat/completions", None),
        "antigravity": (ANTIGRAVITY_BASE_URL_V1 + "/chat/completions", None),
        "xingyun": (XINGYUN_BASE_URL_V1 + "/chat/completions", None),
        "molifang": (MOLIFANG_BASE_URL_V1 + "/chat/completions", None),
        "flames": (FLAMES_NEWAPI_BASE_URL_V1 + "/chat/completions", None),
        "deepseek": (DEEPSEEK_BASE_URL + "/v1/messages", None),
        "openai": (OPENAI_BASE_URL_V1 + "/chat/completions", XRAY_PROXY),
        "openrouter": (OPENROUTER_BASE_URL_V1 + "/chat/completions", None),
    }
    fam = model_family(model)
    if provider == "icodeeasy":
        proxy = None
        if fam == "claude":
            url = ICODEEASY_BASE_URL_V1 + "/messages"
        elif fam == "gemini":
            bare_model = model.split("/")[-1]
            url = f"{ICODEEASY_BASE_URL}/v1beta/models/{bare_model}:generateContent"
        else:
            url = ICODEEASY_BASE_URL_V1 + "/chat/completions"
    else:
        entry = endpoint_map.get(provider)
        if not entry:
            return False, f"unknown provider: {provider}"
        url, proxy = entry

    if provider != "icodeeasy" and provider not in endpoint_map:
        return False, f"unknown provider: {provider}"

    # Pick the right API key
    if provider == "duck":
        if fam == "claude":
            key = keys.get("duck_anthropic", "")
        elif fam == "gemini":
            key = keys.get("duck_gemini", "")
        else:
            key = keys.get("duck_codex", "")
    elif provider == "quotio":
        key = keys.get("quotio", "")
    elif provider == "antigravity":
        key = keys.get("antigravity", "")
    elif provider == "xingyun":
        key = keys.get("xingyun", "")
    elif provider == "molifang":
        key = keys.get("molifang", "")
    elif provider == "flames":
        key = keys.get("flames", "")
    elif provider == "deepseek":
        key = keys.get("deepseek", "")
    elif provider == "openai":
        key = keys.get("openai", "")
    elif provider == "openrouter":
        key = keys.get("openrouter", "")
    elif provider == "icodeeasy":
        key = keys.get("icodeeasy", "")
    else:
        key = ""

    if not key:
        return False, "no API key"

    bare_model = model.split("/")[-1]
    request_model = model if provider in ("flames", "openrouter") else bare_model
    if provider == "icodeeasy":
        if fam == "claude":
            payload = json.dumps({
                "model": bare_model,
                "messages": [{"role": "user", "content": "hi"}],
                "max_tokens": 1,
            })
            cmd = ["curl", "-s", "-w", "\n%{http_code}", "-X", "POST", url,
                   "-H", f"x-api-key: {key}",
                   "-H", "anthropic-version: 2023-06-01",
                   "-H", "Content-Type: application/json",
                   "-d", payload,
                   "--max-time", "10"]
        elif fam == "gemini":
            payload = json.dumps({
                "contents": [{"parts": [{"text": "hi"}]}],
            })
            cmd = ["curl", "-s", "-w", "\n%{http_code}", "-X", "POST", url,
                   "-H", f"x-goog-api-key: {key}",
                   "-H", "Content-Type: application/json",
                   "-d", payload,
                   "--max-time", "10"]
        else:
            payload = json.dumps({
                "model": bare_model,
                "messages": [{"role": "user", "content": "hi"}],
                "max_tokens": 1,
            })
            cmd = ["curl", "-s", "-w", "\n%{http_code}", "-X", "POST", url,
                   "-H", f"Authorization: Bearer {key}",
                   "-H", "Content-Type: application/json",
                   "-d", payload,
                   "--max-time", "10"]
    elif provider == "deepseek":
        payload = json.dumps({
            "model": bare_model,
            "messages": [{"role": "user", "content": "hi"}],
            "max_tokens": 1,
        })
        cmd = ["curl", "-s", "-w", "\n%{http_code}", "-X", "POST", url,
               "-H", f"x-api-key: {key}",
               "-H", "anthropic-version: 2023-06-01",
               "-H", "Content-Type: application/json",
               "-d", payload,
               "--max-time", "10"]
    else:
        payload = json.dumps({
            "model": request_model,
            "messages": [{"role": "user", "content": "hi"}],
            "max_tokens": 1,
        })
        cmd = ["curl", "-s", "-w", "\n%{http_code}", "-X", "POST", url,
               "-H", f"Authorization: Bearer {key}",
               "-H", "Content-Type: application/json",
               "-d", payload,
               "--max-time", "10"]
    if proxy:
        cmd.extend(["--proxy", proxy])

    try:
        result = subprocess.run(cmd, capture_output=True, text=True, timeout=15)
        lines = result.stdout.strip().rsplit("\n", 1)
        if len(lines) == 2:
            body, code = lines
        else:
            body, code = result.stdout.strip(), "0"
        code = code.strip()
        if code.startswith("2"):
            return True, ""
        # Parse error
        try:
            err_data = json.loads(body)
            err_msg = err_data.get("error", {}).get("message", body[:80]) if isinstance(err_data.get("error"), dict) else str(err_data.get("error", body[:80]))
        except Exception:
            err_msg = body[:80]
        return False, f"HTTP {code}: {err_msg}"
    except subprocess.TimeoutExpired:
        return False, "timeout"
    except Exception as e:
        return False, str(e)


def cmd_check(cfg: Config, keys: Dict[str, str], online: bool = False) -> None:
    """Show current model status for each tool, optionally with online verification."""
    custom_providers = load_custom_providers_for_cfg(cfg)
    print(f"{CYAN}═══ Model Status {'(online)' if online else ''} ═══{NC}")
    for tool in TOOLS:
        prov = detect_provider(tool, cfg)
        model = detect_current_model(tool, cfg)
        icon = {"duck": "🦆", "quotio": "🔗", "antigravity": "🚀", "xingyun": "☁️", "molifang": "🧩", "aiwave": "🌊", "flames": "🔥", "xai": "⚡", "deepseek": "🧠", "openai": "🔑", "openrouter": "🌐", "icodeeasy": "🧊"}.get(prov, "🛠" if prov in custom_providers else ("🔑" if prov.startswith("openai_") else "❓"))

        # Truncate model for display
        model_display = model if len(model) <= 32 else model[:29] + "..."

        # Local catalog check — OpenRouter IDs contain slashes, extract properly
        if prov == "openrouter" and model.startswith("openrouter/"):
            bare_model = model[len("openrouter/"):]
        else:
            bare_model = model.split("/")[-1]
        catalog_model = model if prov == "flames" else bare_model
        if prov in ("quotio", "antigravity", "duck", "openrouter", "icodeeasy", "molifang", "flames", "xai", "aiwave"):
            in_catalog = model_in_provider(catalog_model, prov, cfg=cfg)
            status = "✅" if in_catalog else "⚠️"
        elif prov in custom_providers:
            status = "—"
        else:
            status = "—"

        if online and prov in ("quotio", "antigravity", "duck", "molifang", "flames", "deepseek", "openai", "icodeeasy"):
            ok, reason = probe_model_curl(prov, catalog_model, keys)
            if ok:
                status = "✅ online"
            else:
                status = f"❌ {reason[:30]}"

        prov_display = prov
        if tool == "openclaw" and prov == "openai":
            mode = detect_openclaw_openai_mode(cfg)
            if mode:
                prov_display = f"{prov}({mode})"
        elif tool == "codex" and (prov == "openai" or prov.startswith("openai_")):
            mode = detect_codex_openai_mode(cfg)
            if mode:
                prov_display = f"{prov}({mode})"
        print(f"  {tool:<10} {icon} {prov_display:<14} {model_display:<34} {status}")
    print(f"{CYAN}═══════════════════════════════════════════════════════════{NC}")


# ----------------------------- model-level switch ----------------------
def validate_model_for_tool(
    tool: str,
    model: str,
    provider: str,
    force: bool = False,
    *,
    custom_provider: Dict[str, Any] | None = None,
    cfg: Config | None = None,
) -> None:
    """Validate model compatibility. Raises SwitchError on failure."""
    if custom_provider is not None:
        return

    fam = model_family(model)
    compatible = FAMILY_TOOLS.get(fam, ())
    registered = cfg is not None and model in model_override_entries(cfg, provider=provider, tool=tool)
    if registered:
        compatible = (tool,)
    if provider == "flames" and tool == "cc" and fam == "gpt":
        compatible = tuple(dict.fromkeys((*compatible, "cc")))
    if provider == "openrouter" and tool in ("codex", "openclaw", "droid", "all"):
        # OpenRouter is OpenAI-compatible, so Codex/Droid can take Claude/DS/GPT IDs.
        compatible = tuple(dict.fromkeys((*compatible, tool)))
    if provider == "flames" and tool == "codex" and (
        fam == "openrouter" or model in FLAMES_OPENROUTER_MODELS
    ):
        compatible = tuple(dict.fromkeys((*compatible, "codex")))

    if tool not in compatible:
        raise SwitchError(
            f"Model '{model}' (family: {fam}) is not compatible with tool '{tool}'.\n"
            f"  Compatible tools for {fam}: {', '.join(compatible) if compatible else 'none'}"
        )

    if provider == "icodeeasy" and tool == "openclaw" and fam != "claude":
        raise SwitchError(
            "Provider 'icodeeasy' 当前在 OpenClaw 中仍走 anthropic-messages 链路，"
            "只支持 claude-* 模型。"
        )

    if provider == "aiwave" and tool in ("openclaw", "gemini", "hermes") and fam != "gemini":
        raise SwitchError(
            f"Provider 'aiwave' 在 {tool} 当前只支持 gemini-* 模型。"
        )

    if provider == "flames" and tool == "hermes" and fam != "gpt":
        raise SwitchError("Provider 'flames' 在 Hermes 当前只支持 gpt-* 模型。")

    if not force and not registered and provider not in ("openai", "openrouter", "quotio_local") and provider not in OPENAI_NAMED_PROVIDERS:
        catalog_model = model if provider == "flames" else model.split("/")[-1]
        if not model_in_provider(catalog_model, provider, cfg=cfg):
            raise SwitchError(
                f"Model '{catalog_model}' not found in {provider} catalog.\n"
                f"  Run: switch-api list {provider}\n"
                f"  Or use --force to skip this check."
            )

# ----------------------------- switchers -----------------------------
def switch_cc(provider: str, cfg: Config, keys: Dict[str, str], model: str = "") -> None:
    if skip_redundant_switch("cc", provider, cfg, model):
        return
    info(f"Switching Claude Code → {provider}")
    backup(cfg.cc_settings)

    data = load_json(cfg.cc_settings)
    env = data.setdefault("env", {})
    current_model = str(data.get("model", "") or "").strip()
    clear_cc_custom_model_env(env)
    clear_cc_model_alias_env(env)

    if provider == "duck":
        env["ANTHROPIC_BASE_URL"] = DUCK_BASE_URL
        env["ANTHROPIC_AUTH_TOKEN"] = ensure_key(
            "DUCK_ANTHROPIC_API_KEY/ANTHROPIC_API_KEY", keys["duck_anthropic"]
        )
    elif provider == "duck_cc1":
        env["ANTHROPIC_BASE_URL"] = DUCK_BASE_URL
        env["ANTHROPIC_AUTH_TOKEN"] = ensure_key(
            "DUCK_CC1_API_KEY", keys["duck_cc1"]
        )
    elif provider == "duck_codex2cc":
        env["ANTHROPIC_BASE_URL"] = DUCK_BASE_URL
        env["ANTHROPIC_AUTH_TOKEN"] = ensure_key(
            "DUCK_CODEX2CC_API_KEY", keys["duck_codex2cc"]
        )
        # Ensure model is one of the mapped Claude names
        if current_model not in DUCK_CODEX2CC_AVAILABLE_MODELS:
            data["model"] = "claude-opus-4-6"
            info(f"Model set to claude-opus-4-6 (→ gpt-5.3-codex-xhigh)")
        else:
            mapped = DUCK_CODEX2CC_MODEL_MAP.get(current_model, "?")
            info(f"Keeping model {current_model} (→ {mapped})")
        info("duck_codex2cc 模型映射:")
        for cm, gm in DUCK_CODEX2CC_MODEL_MAP.items():
            info(f"  {cm} → {gm}")
    elif provider == "quotio":
        env["ANTHROPIC_BASE_URL"] = QUOTIO_BASE_URL
        env["ANTHROPIC_AUTH_TOKEN"] = ensure_key("QUOTIO_API_KEY", keys["quotio"])

        target_model, reason = resolve_cc_model_for_quotio(current_model)
        data["model"] = target_model
        if reason:
            warn(reason)
        info("Quotio Claude allowlist: claude-opus-4-6-thinking, claude-sonnet-4-6")

    elif provider == "antigravity":
        env["ANTHROPIC_BASE_URL"] = ANTIGRAVITY_BASE_URL
        env["ANTHROPIC_AUTH_TOKEN"] = ensure_key("ANTIGRAVITY_API_KEY", keys["antigravity"])

        # Reuse quotio model resolution (same model set)
        target_model, reason = resolve_cc_model_for_quotio(current_model)
        data["model"] = target_model
        if reason:
            warn(reason)
        info("Antigravity Claude allowlist: claude-opus-4-6-thinking, claude-sonnet-4-6")

    elif provider == "flames":
        env["ANTHROPIC_BASE_URL"] = FLAMES_NEWAPI_BASE_URL
        env["ANTHROPIC_AUTH_TOKEN"] = ensure_key("FLAMES_API_KEY", keys["flames"])
        env["CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC"] = "1"
        env["CLAUDE_CODE_ATTRIBUTION_HEADER"] = "0"

        target_model, reason = resolve_cc_model_for_flames(current_model, model)
        data["model"] = target_model
        env["ANTHROPIC_CUSTOM_MODEL_OPTION"] = target_model
        env["ANTHROPIC_CUSTOM_MODEL_OPTION_NAME"] = FLAMES_CC_MODEL_NAMES.get(
            target_model, target_model
        )
        env["ANTHROPIC_CUSTOM_MODEL_OPTION_DESCRIPTION"] = "Flames NewAPI custom model relay"
        if model_family(target_model) == "kimi":
            for alias_key in CC_MODEL_ALIAS_ENV_KEYS:
                env[alias_key] = target_model
            info("Flames Claude Code Kimi aliases → " + target_model)
        if reason:
            warn(reason)
        info("Flames Claude Code custom models: " + ", ".join(FLAMES_CC_ALLOWED_MODELS))

    elif provider == "deepseek":
        env["ANTHROPIC_BASE_URL"] = DEEPSEEK_BASE_URL
        env["ANTHROPIC_AUTH_TOKEN"] = ensure_key("DEEPSEEK_API_KEY", keys["deepseek"])
        env["CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC"] = "1"
        env["CLAUDE_CODE_ATTRIBUTION_HEADER"] = "0"

        target_model, reason = resolve_cc_model_for_deepseek(current_model, model)
        data["model"] = target_model
        env["ANTHROPIC_CUSTOM_MODEL_OPTION"] = target_model
        env["ANTHROPIC_CUSTOM_MODEL_OPTION_NAME"] = DEEPSEEK_CC_MODEL_NAMES.get(
            target_model, target_model
        )
        env["ANTHROPIC_CUSTOM_MODEL_OPTION_DESCRIPTION"] = "DeepSeek official Anthropic-compatible API"
        env["ANTHROPIC_MODEL"] = target_model
        for alias_key, alias_model in DEEPSEEK_CC_MODEL_ALIASES.items():
            env[alias_key] = alias_model
        if reason:
            warn(reason)
        info("DeepSeek Claude Code models: " + ", ".join(DEEPSEEK_AVAILABLE_MODELS))

    elif provider == "icodeeasy":
        env["ANTHROPIC_BASE_URL"] = ICODEEASY_BASE_URL
        env["ANTHROPIC_AUTH_TOKEN"] = ensure_key("ICODEEASY_API_KEY", keys["icodeeasy"])
        env["CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC"] = "1"
        env["CLAUDE_CODE_ATTRIBUTION_HEADER"] = "0"
        info("iCodeEasy: 统一网关（Claude/Gemini/GPT）；Claude Code 仍走 Anthropic 原生 API")

    if model and model in model_override_entries(cfg, provider=provider, tool="cc"):
        data["model"] = model
        env.setdefault("ANTHROPIC_CUSTOM_MODEL_OPTION", model)
        env.setdefault("ANTHROPIC_CUSTOM_MODEL_OPTION_NAME", model)
        env.setdefault("ANTHROPIC_CUSTOM_MODEL_OPTION_DESCRIPTION", "switch-api registered model override")

    save_json(cfg.cc_settings, data)
    ok(f"Claude Code → {provider}")


def append_registered_openclaw_model(
    payload: Dict[str, Any],
    cfg: Config,
    provider: str,
    model: str,
    api: str,
) -> None:
    spec = model_override_entries(cfg, provider=provider, tool="openclaw").get(model)
    models = payload.get("models")
    already_present = isinstance(models, list) and any(
        item.get("id") == model for item in models if isinstance(item, dict)
    )
    if spec is None or not isinstance(models, list) or already_present:
        return
    entry: Dict[str, Any] = {
        "id": model,
        "name": f"{model} ({provider})",
        "reasoning": True,
        "input": ["text", "image"] if spec.get("vision") else ["text"],
        "contextWindow": 200000,
        "maxTokens": 32768,
    }
    if any(isinstance(item, dict) and "cost" in item for item in models):
        entry["cost"] = {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0}
        entry["api"] = api
    models.append(entry)


