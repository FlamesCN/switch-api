                },
            },
        }
    }


def save_provider_model_catalog(path: Path) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(provider_model_catalog(), ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    try:
        tmp.chmod(0o600)
    except Exception:
        pass
    os.replace(tmp, path)


def resolve_cc_model_for_quotio(current_model: str) -> Tuple[str, str]:
    m = (current_model or "").strip()
    if not m:
        return QUOTIO_CC_DEFAULT_MODEL, "Claude Code model empty; set to quotio default claude-opus-4-6-thinking"

    if m in QUOTIO_CC_ALLOWED_MODELS:
        return m, ""

    if m in QUOTIO_CC_MODEL_FALLBACKS:
        return QUOTIO_CC_MODEL_FALLBACKS[m], f"Claude model {m} mapped to {QUOTIO_CC_MODEL_FALLBACKS[m]} for quotio"

    lm = m.lower()
    if "haiku" in lm:
        return "claude-sonnet-4-6", f"Claude model {m} mapped to claude-sonnet-4-6 (haiku fallback policy)"
    if "opus-4-5" in lm:
        return "claude-opus-4-6-thinking", f"Claude model {m} mapped to claude-opus-4-6-thinking (opus4.5 fallback policy)"

    return QUOTIO_CC_DEFAULT_MODEL, f"Claude model {m} is not in quotio allowlist; fallback to {QUOTIO_CC_DEFAULT_MODEL}"


def resolve_openclaw_primary_for_quotio(current_primary: str) -> Tuple[str, str]:
    p = (current_primary or "").strip()
    if not p:
        return QUOTIO_OPENCLAW_DEFAULT_PRIMARY, "OpenClaw primary empty; set to quotio default quotio/claude-opus-4-6-thinking"

    if p in QUOTIO_OPENCLAW_ALLOWED_PRIMARY:
        return p, ""

    if p in QUOTIO_OPENCLAW_PRIMARY_FALLBACKS:
        t = QUOTIO_OPENCLAW_PRIMARY_FALLBACKS[p]
        return t, f"OpenClaw primary {p} mapped to {t} for quotio"

    lp = p.lower()
    if "haiku" in lp:
        return "quotio/claude-sonnet-4-6", f"OpenClaw primary {p} mapped to quotio/claude-sonnet-4-6 (haiku fallback policy)"
    if "opus-4-5" in lp:
        return "quotio/claude-opus-4-6-thinking", f"OpenClaw primary {p} mapped to quotio/claude-opus-4-6-thinking (opus4.5 fallback policy)"

    return QUOTIO_OPENCLAW_DEFAULT_PRIMARY, f"OpenClaw primary {p} is not in quotio allowlist; fallback to {QUOTIO_OPENCLAW_DEFAULT_PRIMARY}"


def resolve_openclaw_duck_profile(profile: str) -> Tuple[str, str]:
    p = profile.lower().strip() if profile else "default"
    if not p or p == "default":
        target = OPENCLAW_DUCK_PROFILE_TO_PRIMARY["default"]
        return target, f"OpenClaw duck profile default -> {target}"
    if p not in OPENCLAW_DUCK_PROFILE_TO_PRIMARY:
        raise SwitchError(
            f"Unknown openclaw duck profile: {profile} (use one of: {', '.join(OPENCLAW_DUCK_PROFILE_NAMES)})"
        )
    target = OPENCLAW_DUCK_PROFILE_TO_PRIMARY[p]
    return target, f"OpenClaw duck profile {profile} -> {target}"


def resolve_openclaw_quotio_profile(profile: str) -> Tuple[str, str]:
    p = (profile or "").strip().lower()
    if not p:
        target = OPENCLAW_QUOTIO_PROFILE_TO_PRIMARY["default"]
        return target, f"OpenClaw quotio profile default -> {target}"

    if p not in OPENCLAW_QUOTIO_PROFILE_TO_PRIMARY:
        raise SwitchError(
            f"Unknown openclaw quotio profile: {profile} (use one of: {', '.join(OPENCLAW_QUOTIO_PROFILE_NAMES)})"
        )

    target = OPENCLAW_QUOTIO_PROFILE_TO_PRIMARY[p]
    return target, f"OpenClaw quotio profile {p} -> {target}"



