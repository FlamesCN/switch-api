    return target, f"OpenClaw antigravity profile {p} -> {target}"


def resolve_openrouter_model(model: str) -> str:
    raw = (model or "").strip()
    if not raw:
        return raw
    return OPENROUTER_MODEL_ALIASES.get(raw.lower(), raw)


def is_openrouter_free_model(model: str) -> bool:
    m = (model or "").strip()
    if not m:
        return False
    if m == "openrouter/free" or m.endswith(":free"):
        return True
    return m in OPENROUTER_FREE_MODELS


def openrouter_codex_display_name(slug: str) -> str:
    if slug in OPENROUTER_CODEX_DISPLAY_NAMES:
        return OPENROUTER_CODEX_DISPLAY_NAMES[slug]
    name = slug.split("/", 1)[-1].replace(":free", " (Free)").replace("-", " ")
    return name


def openrouter_codex_catalog_slugs(cfg: Config | None = None) -> List[str]:
    slugs: List[str] = []
    for model in (*OPENROUTER_PAID_MODELS, *OPENROUTER_FREE_MODELS):
        if model in OPENROUTER_CODEX_SKIP_MODELS or model in slugs:
            continue
        slugs.append(model)
    if cfg is not None:
        for model_id in model_override_entries(cfg, provider="openrouter", tool="codex"):
            if model_id not in slugs:
                slugs.append(model_id)
    return slugs


def resolve_openclaw_openrouter_profile(profile: str) -> Tuple[str, str]:
    p = (profile or "").strip().lower()
    if not p:
        target = OPENCLAW_OPENROUTER_PROFILE_TO_PRIMARY["default"]
        return target, f"OpenClaw openrouter profile default -> {target}"

    if p not in OPENCLAW_OPENROUTER_PROFILE_TO_PRIMARY:
        raise SwitchError(
            f"Unknown openclaw openrouter profile: {profile} (use one of: {', '.join(OPENCLAW_OPENROUTER_PROFILE_NAMES)})"
        )

    target = OPENCLAW_OPENROUTER_PROFILE_TO_PRIMARY[p]
    return target, f"OpenClaw openrouter profile {p} -> {target}"


def configure_openclaw_agent_paths(cfg: "Config", agent_id: str) -> None:
    cfg.oc_agent_id = agent_id
    cfg.oc_agent_dir = cfg.home / f".openclaw/agents/{agent_id}/agent"
    cfg.oc_models = cfg.oc_agent_dir / "models.json"
    cfg.oc_auth = cfg.oc_agent_dir / "auth.json"
    cfg.oc_auth_profiles = cfg.oc_agent_dir / "auth-profiles.json"


