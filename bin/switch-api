RED = "\033[0;31m"
GREEN = "\033[0;32m"
YELLOW = "\033[1;33m"
BLUE = "\033[0;34m"
CYAN = "\033[0;36m"
NC = "\033[0m"


class SwitchError(RuntimeError):
    pass


def info(msg: str) -> None:
    print(f"{BLUE}[INFO]{NC} {msg}")


def ok(msg: str) -> None:
    print(f"{GREEN}[OK]{NC} {msg}")


def warn(msg: str) -> None:
    print(f"{YELLOW}[WARN]{NC} {msg}")


def err(msg: str) -> None:
    print(f"{RED}[ERROR]{NC} {msg}", file=sys.stderr)


def resolve_home() -> Path:
    home = os.environ.get("HOME", "")
    if home and Path(home).is_dir():
        return Path(home)

    user = ""
    try:
        user = subprocess.run(
            ["id", "-un"], capture_output=True, text=True, check=False
        ).stdout.strip()
    except Exception:
        user = ""

    if user:
        try:
            passwd = subprocess.run(
                ["getent", "passwd", user], capture_output=True, text=True, check=False
            ).stdout.strip()
            if passwd:
                fields = passwd.split(":")
                if len(fields) >= 6 and fields[5] and Path(fields[5]).is_dir():
                    os.environ["HOME"] = fields[5]
                    return Path(fields[5])
        except Exception:
            pass

        candidate = Path(f"/home/{user}")
        if candidate.is_dir():
            os.environ["HOME"] = str(candidate)
            return candidate

    raise SwitchError("Cannot resolve HOME directory")


def _load_exports_from_rc_file(rc_path: Path, target_vars: Iterable[str]) -> None:
    if not rc_path.exists():
        return

    target_var_set = set(target_vars)
    pattern = re.compile(r"^\s*export\s+([A-Za-z_][A-Za-z0-9_]*)=(.*)$")

    for raw_line in rc_path.read_text(encoding="utf-8", errors="ignore").splitlines():
        m = pattern.match(raw_line)
        if not m:
            continue

        key, value = m.group(1), m.group(2).strip()
        if key not in target_var_set:
            continue

        # Avoid evaluating shell expressions; keep only plain literal assignments
        if any(tok in value for tok in ("$(", "`", "&&", "||", ";")):
            continue

        if len(value) >= 2 and value[0] == value[-1] and value[0] in ("'", '"'):
            value = value[1:-1]
        else:
            # remove inline comments for unquoted values
            value = value.split(" #", 1)[0].strip()

        os.environ[key] = value


def load_exports_from_shell_rcs(home: Path) -> None:
    """
    Load simple `export KEY=value` lines from shell rc files without sourcing shell logic.
    We only load specific variables used by this switch tool.
    """
    target_vars = {
        "ANTHROPIC_API_KEY",
        "DUCK_ANTHROPIC_API_KEY",
        "GEMINI_API_KEY",
        "DUCK_GEMINI_API_KEY",
        "DUCKCODING_API_KEY",
        "QUOTIO_API_KEY",
        "GEMINI_BASE_URL",
        "GEMINI_MODEL",
        "ANTIGRAVITY_API_KEY",
        "XINGYUN_API_KEY",
        MOLIFANG_ENV_KEY,
        "OPENAI_API_KEY",
        "OPENROUTER_API_KEY",
        "AIWAVE_API_KEY",
        AIWAVE_CODEX_ENV_KEY,
        AIWAVE_GEMINI_GCP_ENV_KEY,
        AIWAVE_GEMINI_ENV_KEY,
        AIWAVE_CLAUDE_ANTI_ENV_KEY,
        AIWAVE_CLAUDE_OMG_ENV_KEY,
        "DUCK_CC1_API_KEY",
        "DUCK_CODEX2CC_API_KEY",
        "FLAMES_API_KEY",
        "OPENAI_GQ80_API_KEY",
        "OPENAI_V420_API_KEY",
        "ICODEEASY_API_KEY",
        "XAI_API_KEY",
        "GROK_CODE_XAI_API_KEY",
        "CODEX_HOME",
    }
    _load_exports_from_rc_file(home / ".env", target_vars)
    _load_exports_from_rc_file(home / ".bashrc", target_vars)
    _load_exports_from_rc_file(home / ".zshrc", target_vars)


def timestamp() -> str:
    return datetime.now().strftime("%Y%m%d-%H%M%S")


def backup(path: Path, destination_dir: Path | None = None) -> None:
    if path.exists():
        if destination_dir is not None:
            destination_dir.mkdir(parents=True, exist_ok=True)
            dst = destination_dir / f"{path.name}.bak.switch-{timestamp()}"
        else:
            dst = path.with_name(f"{path.name}.bak.switch-{timestamp()}")
        shutil.copy2(path, dst)


def load_json(path: Path) -> Dict[str, Any]:
    if not path.exists():
        raise SwitchError(f"Config file not found: {path}")
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception as ex:
        raise SwitchError(f"Failed to parse JSON: {path}: {ex}")


def save_json(path: Path, data: Dict[str, Any]) -> None:
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(
        json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8"
    )
    os.replace(tmp, path)


def load_yaml(path: Path) -> Dict[str, Any]:
    if not path.exists():
        raise SwitchError(f"Config file not found: {path}")
    try:
        data = yaml.safe_load(path.read_text(encoding="utf-8"))
    except Exception as ex:
        raise SwitchError(f"Failed to parse YAML: {path}: {ex}")
    return data if isinstance(data, dict) else {}


def save_yaml(path: Path, data: Dict[str, Any]) -> None:
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(
        yaml.safe_dump(data, allow_unicode=True, sort_keys=False),
        encoding="utf-8",
    )
    os.replace(tmp, path)


def read_text(path: Path) -> str:
    if not path.exists():
        raise SwitchError(f"Config file not found: {path}")
    return path.read_text(encoding="utf-8", errors="ignore")


def write_text(path: Path, content: str) -> None:
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(content, encoding="utf-8")
    os.replace(tmp, path)


def resolve_hermes_config_paths(
    cfg: "Config",
    *,
    profile_name: str = "",
    all_profiles: bool = False,
) -> List[Path]:
    if profile_name and all_profiles:
        raise SwitchError("--profile and --all-profiles cannot be used together")

    if profile_name:
        candidate = cfg.hermes_profiles_dir / profile_name / "config.yaml"
        if not candidate.exists():
            raise SwitchError(f"Unknown Hermes profile: {profile_name}")
        return [candidate]

    if all_profiles:
        paths = sorted(cfg.hermes_profiles_dir.glob("*/config.yaml")) if cfg.hermes_profiles_dir.exists() else []
        if not paths:
            raise SwitchError(f"No Hermes profiles found under {cfg.hermes_profiles_dir}")
        return list(paths)

    if not cfg.hermes_config.exists():
        raise SwitchError(f"Hermes config not found: {cfg.hermes_config}")
    return [cfg.hermes_config]


def normalize_path(home: Path, raw: str) -> Path:
    path = Path(raw).expanduser()
    if not path.is_absolute():
        path = home / path
    return Path(os.path.abspath(str(path)))


def resolve_cli_path(raw: str) -> Path:
    path = Path(raw).expanduser()
    if not path.is_absolute():
        path = Path.cwd() / path
    return Path(os.path.abspath(str(path)))


def resolve_codex_home(home: Path) -> Path:
    raw = os.environ.get("CODEX_HOME", "").strip()
    if raw:
        return normalize_path(home, raw)
    return home / ".codex"


def resolve_openclaw_agent_metadata(home: Path) -> Tuple[List[str], str]:
    oc_config = home / ".openclaw/openclaw.json"
    if not oc_config.exists():
        return ["main"], "main"

    try:
        oc = load_json(oc_config)
    except Exception:
        return ["main"], "main"

    agent_ids: List[str] = []
    default_agent_id = ""
    agents = oc.get("agents") or {}
    agent_list = agents.get("list") or []
    if isinstance(agent_list, list):
        for item in agent_list:
            if not isinstance(item, dict):
                continue
            agent_id = str(item.get("id") or "").strip()
            if not agent_id:
                continue
            if agent_id not in agent_ids:
                agent_ids.append(agent_id)
            if item.get("default") is True and not default_agent_id:
                default_agent_id = agent_id

    if not agent_ids:
        agent_ids = ["main"]
    if not default_agent_id:
        default_agent_id = agent_ids[0]

    return agent_ids, default_agent_id


def resolve_openclaw_agent_ids(home: Path) -> List[str]:
    agent_ids, _default_agent_id = resolve_openclaw_agent_metadata(home)
    return agent_ids


def resolve_openclaw_default_agent_id(home: Path) -> str:
    _agent_ids, default_agent_id = resolve_openclaw_agent_metadata(home)
    return default_agent_id


def extract_openclaw_model_primary(model_cfg: Any) -> str:
    if isinstance(model_cfg, str):
        return model_cfg.strip()
    if isinstance(model_cfg, dict):
        return str(model_cfg.get("primary") or "").strip()
    return ""


def find_openclaw_agent_entry(data: Dict[str, Any], agent_id: str) -> Dict[str, Any] | None:
    target = agent_id.strip()
    if not target:
        return None

    agent_list = ((data.get("agents") or {}).get("list") or [])
    if not isinstance(agent_list, list):
        return None

    for item in agent_list:
        if not isinstance(item, dict):
            continue
        if str(item.get("id") or "").strip() == target:
            return item
    return None


def resolve_openclaw_primary_model(data: Dict[str, Any], agent_id: str = "") -> str:
    if agent_id.strip():
        agent_entry = find_openclaw_agent_entry(data, agent_id)
        primary = extract_openclaw_model_primary((agent_entry or {}).get("model"))
        if primary:
            return primary

    defaults = ((data.get("agents") or {}).get("defaults") or {})
    return extract_openclaw_model_primary(defaults.get("model"))


def ensure_openclaw_defaults_model_config(data: Dict[str, Any]) -> Dict[str, Any]:
    agents = data.setdefault("agents", {})
    defaults = agents.setdefault("defaults", {})
    model_cfg = defaults.get("model")
    if isinstance(model_cfg, dict):
        return model_cfg
    if isinstance(model_cfg, str):
        normalized = {"primary": model_cfg.strip()}
        defaults["model"] = normalized
        return normalized
    normalized: Dict[str, Any] = {}
    defaults["model"] = normalized
    return normalized


def get_or_create_openclaw_agent_entry(data: Dict[str, Any], agent_id: str) -> Dict[str, Any]:
    existing = find_openclaw_agent_entry(data, agent_id)
    if existing is not None:
        return existing

    agents = data.setdefault("agents", {})
    agent_list = agents.get("list")
    if not isinstance(agent_list, list):
        agent_list = []
        agents["list"] = agent_list

    entry: Dict[str, Any] = {"id": agent_id.strip()}
    agent_list.append(entry)
    return entry


def set_openclaw_target_primary_model(
    data: Dict[str, Any],
    agent_id: str,
    primary: str,
    *,
    use_agent_override: bool,
) -> None:
    defaults_model = ensure_openclaw_defaults_model_config(data)
    if use_agent_override:
        entry = get_or_create_openclaw_agent_entry(data, agent_id)
        entry["model"] = primary
        return

    defaults_model["primary"] = primary
    entry = find_openclaw_agent_entry(data, agent_id)
    if entry is not None and "model" in entry:
        del entry["model"]


def ensure_key(name: str, value: str, extra: str = "") -> str:
    if value:
        return value
    hint = f" ({extra})" if extra else ""
    raise SwitchError(f"{name} is not set{hint}")



def _is_cloudflare_error(body: str) -> str:
    """Detect Cloudflare tunnel/origin error pages.
    Returns error description if CF error, empty string if not."""
    # Cloudflare error codes: 502, 520-530, 1000-1099 etc.
    # Body patterns: "error code: 1010", "error code: 1033", "cloudflare" in HTML
    import re
    m = re.search(r"error code:\s*(\d{3,4})", body, re.IGNORECASE)
    if m:
        return f"Cloudflare error code {m.group(1)}"
    low = body.lower()
    if "cloudflare" in low and ("tunnel" in low or "origin" in low or "unreachable" in low):
        return "Cloudflare tunnel/origin error"
    return ""


def _read_error_body(e) -> str:
    """Safely read up to 500 bytes from an HTTPError response."""
    try:
        return e.read().decode("utf-8", errors="replace")[:500]
    except Exception:
        return ""


def probe_provider(provider: str, keys: Dict[str, str], timeout: int = 8) -> Tuple[bool, str]:
    """Pre-flight: test if the target provider API endpoint is reachable.
    Returns (ok, reason).
    Detects Cloudflare tunnel errors (e.g. 403+1010, 530+1033, 502) even when
    HTTP status looks benign."""
    import urllib.request
    import urllib.error

    endpoints: Dict[str, Tuple[str, str]] = {
        "duck": (DUCK_BASE_URL_V1 + "/models", keys.get("duck_gemini", "") or keys.get("duck_codex", "") or keys.get("duck_anthropic", "")),
        "quotio": (QUOTIO_BASE_URL_V1 + "/models", keys.get("quotio", "")),
        "quotio_local": (QUOTIO_LOCAL_BASE_URL_V1 + "/models", keys.get("quotio", "")),
        "antigravity": (ANTIGRAVITY_BASE_URL_V1 + "/models", keys.get("antigravity", "")),
        "xingyun": (XINGYUN_BASE_URL_V1 + "/models", keys.get("xingyun", "")),
        "molifang": (MOLIFANG_BASE_URL_V1 + "/models", keys.get("molifang", "")),
        "flames": (FLAMES_NEWAPI_BASE_URL_V1 + "/models", keys.get("flames", "")),
        "openai": ("https://api.openai.com/v1/models", keys.get("openai", "")),
        "openai_Gq80": ("https://api.openai.com/v1/models", keys.get("openai_Gq80", "")),
        "openai_V420": ("https://api.openai.com/v1/models", keys.get("openai_V420", "")),
        "openrouter": (OPENROUTER_BASE_URL_V1 + "/models", keys.get("openrouter", "")),
        "aiwave": (
            AIWAVE_BASE_URL_V1 + "/models",
            keys.get("aiwave_codex", "") or keys.get("aiwave_gemini", "") or keys.get("aiwave", ""),
        ),
        "duck_cc1": (DUCK_BASE_URL_V1 + "/models", keys.get("duck_cc1", "")),
        "duck_codex2cc": (DUCK_BASE_URL_V1 + "/models", keys.get("duck_codex2cc", "")),
        "icodeeasy": (ICODEEASY_BASE_URL_V1 + "/models", keys.get("icodeeasy", "")),
    }
    entry = endpoints.get(provider)
    if not entry:
        return True, ""

    url, api_key = entry
    headers: Dict[str, str] = {"User-Agent": "switch-api/" + APP_VERSION}
    if provider == "icodeeasy":
        if api_key:
            headers["x-api-key"] = api_key
        headers["anthropic-version"] = "2023-06-01"
    elif api_key:
        headers["Authorization"] = f"Bearer {api_key}"

    try:
        req = urllib.request.Request(url, headers=headers)
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            body = resp.read().decode("utf-8", errors="replace")[:500]
            cf = _is_cloudflare_error(body)
            if cf:
                return False, f"{cf} (HTTP {resp.status})"
            return True, ""
    except urllib.error.HTTPError as e:
        body = _read_error_body(e)
        cf = _is_cloudflare_error(body)
        if cf:
            return False, f"{cf} (HTTP {e.code})"
        # Real 401/403 from the API server (not Cloudflare) = server is up
        # 400 can also mean server is up but request is malformed (e.g. icodeeasy /v1/messages GET)
        if e.code in (400, 401, 403):
            return True, ""
        return False, f"HTTP {e.code} from {url}"
    except urllib.error.URLError as e:
        return False, f"{e.reason}"
    except Exception as e:
        return False, str(e)


def load_credential_store(path: Path) -> Dict[str, str]:
    if not path.exists():
        return {}
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
        if isinstance(data, dict):
            return {str(k): str(v) for k, v in data.items() if isinstance(v, str) and v}
    except Exception:
        pass
    return {}


def save_credential_store(path: Path, data: Dict[str, str]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    try:
        path.parent.chmod(0o700)
    except Exception:
        pass

    payload = {k: v for k, v in data.items() if isinstance(v, str) and v}
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(payload, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    try:
        tmp.chmod(0o600)
    except Exception:
        pass
    os.replace(tmp, path)


def validate_env_key_name(name: str) -> str:
    key = (name or "").strip()
    if not ENV_KEY_NAME_RE.match(key):
        raise SwitchError(
            "Environment key must match shell env style, e.g. MY_PROVIDER_API_KEY"
        )
    return key


def validate_custom_provider_name(name: str) -> str:
    provider_name = (name or "").strip().lower()
    if not CUSTOM_PROVIDER_NAME_RE.match(provider_name):
        raise SwitchError(
            "Custom provider name must match ^[a-z0-9][a-z0-9_-]*$"
        )
    if provider_name in PROVIDERS or provider_name in TOOLS_WITH_ALL or provider_name in (
        "status",
        "check",
        "list",
        "help",
        "version",
        "provider",
        "key",
        "codex-account",
    ):
        raise SwitchError(f"Custom provider name is reserved: {provider_name}")
    return provider_name


def normalize_base_url(url: str) -> str:
    value = (url or "").strip().rstrip("/")
    if not value.startswith("http://") and not value.startswith("https://"):
        raise SwitchError("base_url must start with http:// or https://")
    return value


def custom_provider_enabled_tools(spec: Dict[str, Any]) -> List[str]:
    tools = spec.get("tools") or []
    if not isinstance(tools, list):
        return []
    ordered = [tool for tool in TOOLS if tool in tools]
    extras = [str(tool).strip() for tool in tools if str(tool).strip() and str(tool).strip() not in ordered]
    return ordered + extras


def normalize_custom_env_map(provider_name: str, extra_env: Any) -> Dict[str, str]:
    if not extra_env:
        return {}
    if not isinstance(extra_env, dict):
        raise SwitchError(f"Custom provider {provider_name} extra_env must be an object")

    normalized: Dict[str, str] = {}
    for key, value in extra_env.items():
        env_key = validate_env_key_name(str(key))
        normalized[env_key] = str(value)
    return normalized


def normalize_available_models(raw: Any) -> List[str]:
    if not raw:
        return []
    if not isinstance(raw, list):
        raise SwitchError("available_models must be a list")
    models: List[str] = []
    for item in raw:
        value = str(item or "").strip()
        if value and value not in models:
            models.append(value)
    return models


def normalize_model_override_tools(raw: Any, provider: str = "") -> List[str]:
    tools = raw if isinstance(raw, list) else ["cc", "codex"]
    normalized = [str(tool).strip() for tool in tools if str(tool).strip()]
    if "all" in normalized:
        normalized = list(BUILTIN_PROVIDER_TOOLS.get(provider, TOOLS))
    invalid = [tool for tool in normalized if tool not in TOOLS]
    if invalid:
        raise SwitchError("Model override tools must be one of: " + ", ".join(TOOLS))
    unsupported = [tool for tool in normalized if provider and tool not in BUILTIN_PROVIDER_TOOLS.get(provider, ())]
    if unsupported:
        supported = ", ".join(BUILTIN_PROVIDER_TOOLS.get(provider, ())) or "none"
        raise SwitchError(
            f"Provider '{provider}' does not support model overrides for: {', '.join(unsupported)}; "
            f"supported tools: {supported}"
        )
    result: List[str] = []
    for tool in normalized:
        if tool not in result:
            result.append(tool)
    if not result:
        raise SwitchError("Model override must enable at least one tool")
    return result


def load_model_overrides(cfg: "Config") -> Dict[str, Dict[str, Dict[str, Any]]]:
    path = cfg.model_overrides_file
    if not path.exists():
        return {}
    try:
        raw = json.loads(path.read_text(encoding="utf-8"))
    except Exception as ex:
        raise SwitchError(f"Failed to parse model overrides: {path}: {ex}")
    providers = raw.get("providers") if isinstance(raw, dict) else None
    if not isinstance(providers, dict):
        raise SwitchError(f"Invalid model overrides file: {path}")
    result: Dict[str, Dict[str, Dict[str, Any]]] = {}
    for provider, models in providers.items():
        if provider not in PROVIDERS or not isinstance(models, dict):
            continue
        result[provider] = {}
        for model, spec in models.items():
            model_id = str(model).strip()
            if not model_id or not isinstance(spec, dict):
                continue
            result[provider][model_id] = {
                "tools": normalize_model_override_tools(spec.get("tools"), provider),
                "vision": bool(spec.get("vision", False)),
            }
    return result


def save_model_overrides(cfg: "Config", overrides: Dict[str, Any]) -> None:
    cfg.model_overrides_file.parent.mkdir(parents=True, exist_ok=True)
    tmp = cfg.model_overrides_file.with_suffix(".tmp")
    tmp.write_text(
        json.dumps({"providers": overrides}, ensure_ascii=False, indent=2) + "\n",
        encoding="utf-8",
    )
    try:
        tmp.chmod(0o600)
    except Exception:
        pass
    os.replace(tmp, cfg.model_overrides_file)


def model_override_entries(cfg: "Config", provider: str = "", tool: str = "") -> Dict[str, Dict[str, Any]]:
    overrides = load_model_overrides(cfg)
    entries: Dict[str, Dict[str, Any]] = {}
    providers = [provider] if provider else list(overrides)
    for name in providers:
        for model, spec in overrides.get(name, {}).items():
            if not tool or tool in spec.get("tools", []):
                entries[model] = dict(spec)
    return entries


def model_override_spec(cfg: "Config", provider: str, model: str) -> Dict[str, Any] | None:
    return load_model_overrides(cfg).get(provider, {}).get(model)


def derive_model_discovery_url(base_url: str) -> str:
    value = normalize_base_url(base_url)
    if value.endswith("/models"):
        return value
    if value.endswith("/v1"):
        return value + "/models"
    if value.endswith("/v1beta"):
        return value[: -len("/v1beta")] + "/v1/models"
    if value.endswith("/v1/messages"):
        return value[: -len("/messages")] + "/models"
    if value.endswith("/chat/completions"):
        return value[: -len("/chat/completions")] + "/models"
    if value.endswith("/messages"):
        return value[: -len("/messages")] + "/models"
    if value.endswith("/anthropic"):
        return value[: -len("/anthropic")] + "/v1/models"
    return value + "/v1/models"


def derive_openai_chat_completions_url(base_url: str) -> str:
    value = normalize_base_url(base_url)
    if value.endswith("/chat/completions"):
        return value
    if value.endswith("/v1"):
        return value + "/chat/completions"
    return value + "/v1/chat/completions"


def derive_openai_responses_url(base_url: str) -> str:
    value = normalize_base_url(base_url)
    if value.endswith("/responses"):
        return value
    if value.endswith("/v1"):
        return value + "/responses"
    return value + "/v1/responses"


def derive_anthropic_messages_url(base_url: str) -> str:
    value = normalize_base_url(base_url)
    if value.endswith("/messages"):
        return value
    if value.endswith("/v1"):
        return value + "/messages"
    if value.endswith("/anthropic"):
        return value + "/v1/messages"
    return value + "/v1/messages"


def normalize_model_discovery_auth_modes(raw: Any, default_modes: Iterable[str]) -> List[str]:
    items: List[str] = []
    if raw is None or raw == "":
        items = list(default_modes)
    elif isinstance(raw, str):
        items = [part.strip() for part in raw.split(",") if part.strip()]
    elif isinstance(raw, list):
        items = [str(part).strip() for part in raw if str(part).strip()]
    else:
        raise SwitchError("model_discovery.auth_modes must be a string or list")

    normalized: List[str] = []
    for item in items:
        if item not in MODEL_DISCOVERY_AUTH_MODES:
            raise SwitchError(
                "model_discovery.auth_modes must be one of: "
                + ", ".join(MODEL_DISCOVERY_AUTH_MODES)
            )
        if item not in normalized:
            normalized.append(item)
    return normalized


def normalize_model_discovery_config(
    provider_name: str,
    base_url: str,
    raw: Any,
    *,
    default_auth_modes: Iterable[str],
) -> Dict[str, Any] | None:
    if raw is False:
        return None
    if raw in (None, ""):
        payload: Dict[str, Any] = {}
    elif isinstance(raw, dict):
        payload = dict(raw)
    else:
        raise SwitchError(f"Custom provider {provider_name} model_discovery must be an object or false")

    models_url = str(payload.get("models_url") or "").strip() or derive_model_discovery_url(base_url)
    auth_modes = normalize_model_discovery_auth_modes(payload.get("auth_modes"), default_auth_modes)
    result: Dict[str, Any] = {
        "models_url": normalize_base_url(models_url),
        "auth_modes": auth_modes,
    }
    for key in ("last_sync_at", "last_sync_error", "last_sync_auth_mode", "last_sync_status"):
        if key in payload and payload[key] not in (None, ""):
            result[key] = str(payload[key])
    return result


def normalize_custom_openai_provider_section(name: str, spec: Dict[str, Any]) -> Dict[str, Any]:
    provider_name = validate_custom_provider_name(name or str(spec.get("name") or ""))
    tools = spec.get("tools") or list(CUSTOM_OPENAI_COMPATIBLE_TOOLS)
    if not isinstance(tools, list):
        raise SwitchError(f"Invalid tools for custom provider {provider_name}")
    tools = [str(item).strip() for item in tools if str(item).strip()]
    invalid_tools = [tool for tool in tools if tool not in CUSTOM_OPENAI_COMPATIBLE_TOOLS]
    if invalid_tools:
        raise SwitchError(
            f"Custom provider {provider_name} has unsupported tools: {', '.join(invalid_tools)}"
        )
    if not tools:
        raise SwitchError(f"Custom provider {provider_name} must enable at least one tool")

    openclaw_api = str(spec.get("openclaw_api") or "openai-completions").strip()
    if openclaw_api not in CUSTOM_OPENCLAW_APIS:
        raise SwitchError(
            f"Custom provider {provider_name} openclaw_api must be one of: {', '.join(CUSTOM_OPENCLAW_APIS)}"
        )

    hermes_api_mode = str(spec.get("hermes_api_mode") or "codex_responses").strip()
    if hermes_api_mode not in CUSTOM_HERMES_API_MODES:
        raise SwitchError(
            f"Custom provider {provider_name} hermes_api_mode must be one of: {', '.join(CUSTOM_HERMES_API_MODES)}"
        )

    codex_wire_api = str(spec.get("codex_wire_api") or "responses").strip()
    if codex_wire_api != "responses":
        raise SwitchError(
            f"Custom provider {provider_name} codex_wire_api currently only supports 'responses'"
        )

    codex_features = spec.get("codex_features") or {}
    if not isinstance(codex_features, dict):
        raise SwitchError(f"Custom provider {provider_name} codex_features must be an object")
    normalized_features: Dict[str, bool] = {}
    for key, value in codex_features.items():
        if isinstance(value, bool):
            normalized_features[str(key)] = value

    return {
        "base_url": normalize_base_url(str(spec.get("base_url") or "")),
        "env_key": validate_env_key_name(str(spec.get("env_key") or "")),
        "default_model": str(spec.get("default_model") or "").strip(),
        "available_models": normalize_available_models(spec.get("available_models") or []),
        "model_discovery": normalize_model_discovery_config(
            provider_name,
            str(spec.get("base_url") or ""),
            spec.get("model_discovery"),
            default_auth_modes=("bearer", "anthropic", "none"),
        ),
        "tools": tools,
        "openclaw_api": openclaw_api,
        "hermes_api_mode": hermes_api_mode,
        "codex_wire_api": codex_wire_api,
        "codex_features": normalized_features,
    }


def normalize_custom_anthropic_provider_section(name: str, spec: Dict[str, Any]) -> Dict[str, Any]:
    provider_name = validate_custom_provider_name(name or str(spec.get("name") or ""))
    default_model = str(spec.get("default_model") or "").strip()
    if not default_model:
        raise SwitchError(f"Custom provider {provider_name} default_model must not be empty")

    extra_env = normalize_custom_env_map(provider_name, spec.get("extra_env") or {})
    return {
        "base_url": normalize_base_url(str(spec.get("base_url") or "")),
        "env_key": validate_env_key_name(str(spec.get("env_key") or "")),
        "default_model": default_model,
        "available_models": normalize_available_models(spec.get("available_models") or []),
        "model_discovery": normalize_model_discovery_config(
            provider_name,
            str(spec.get("base_url") or ""),
            spec.get("model_discovery"),
            default_auth_modes=("bearer", "anthropic", "none"),
        ),
        "extra_env": extra_env,
    }


def normalize_custom_provider_spec(name: str, spec: Dict[str, Any]) -> Dict[str, Any]:
    provider_name = validate_custom_provider_name(name or str(spec.get("name") or ""))

    openai_raw: Dict[str, Any] | None = None
    anthropic_raw: Dict[str, Any] | None = None

    raw_openai = spec.get("openai")
    if isinstance(raw_openai, dict):
        openai_raw = raw_openai

    raw_anthropic = spec.get("anthropic")
    if isinstance(raw_anthropic, dict):
        anthropic_raw = raw_anthropic

    if openai_raw is None and (
        spec.get("kind") == "openai-compatible"
        or any(key in spec for key in ("openclaw_api", "hermes_api_mode", "codex_wire_api", "codex_features"))
        or any(tool in CUSTOM_OPENAI_COMPATIBLE_TOOLS for tool in (spec.get("tools") or []))
    ):
        openai_raw = spec

    if anthropic_raw is None and spec.get("kind") == "anthropic-compatible":
        anthropic_raw = spec

    openai = normalize_custom_openai_provider_section(provider_name, openai_raw) if openai_raw else None
    anthropic = normalize_custom_anthropic_provider_section(provider_name, anthropic_raw) if anthropic_raw else None

    if openai is None and anthropic is None:
        raise SwitchError(f"Custom provider {provider_name} must define openai and/or anthropic config")

    tools: List[str] = []
    if anthropic is not None:
        tools.append("cc")
    if openai is not None:
        tools.extend(openai["tools"])
    tools = custom_provider_enabled_tools({"tools": tools})

    primary = openai or anthropic or {}
    result: Dict[str, Any] = {
        "kind": "custom-provider",
        "name": provider_name,
        "tools": tools,
        "base_url": str(primary.get("base_url") or ""),
        "env_key": str(primary.get("env_key") or ""),
        "default_model": str(primary.get("default_model") or ""),
    }

    if openai is not None:
        result.update(
            {
                "base_url": openai["base_url"],
                "env_key": openai["env_key"],
                "default_model": openai["default_model"],
                "openclaw_api": openai["openclaw_api"],
                "hermes_api_mode": openai["hermes_api_mode"],
                "codex_wire_api": openai["codex_wire_api"],
                "codex_features": dict(openai["codex_features"]),
                "openai": openai,
            }
        )
    else:
        result["openai"] = None

    if anthropic is not None:
        result["anthropic"] = anthropic
    else:
        result["anthropic"] = None

    return result


def normalize_custom_openai_provider_spec(name: str, spec: Dict[str, Any]) -> Dict[str, Any]:
    return normalize_custom_provider_spec(name, {"name": name, "openai": spec})


def load_custom_provider_store(path: Path) -> Dict[str, Any]:
    if not path.exists():
        return {"providers": {}}
    try:
        raw = json.loads(path.read_text(encoding="utf-8"))
    except Exception as ex:
        raise SwitchError(f"Failed to parse custom provider store: {path}: {ex}")

    if not isinstance(raw, dict):
        raise SwitchError(f"Invalid custom provider store: {path}")

    providers_raw = raw.get("providers") or {}
    if not isinstance(providers_raw, dict):
        raise SwitchError(f"Invalid custom provider store providers: {path}")

    providers: Dict[str, Any] = {}
    for name, spec in providers_raw.items():
        if not isinstance(spec, dict):
            continue
        normalized = normalize_custom_provider_spec(str(name), spec)
        providers[normalized["name"]] = normalized
    return {"providers": providers}


def save_custom_provider_store(path: Path, data: Dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    try:
        path.parent.chmod(0o700)
    except Exception:
        pass
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    try:
        tmp.chmod(0o600)
    except Exception:
        pass
    os.replace(tmp, path)


def custom_provider_map(store: Dict[str, Any]) -> Dict[str, Any]:
    providers = store.get("providers") or {}
    return providers if isinstance(providers, dict) else {}


def resolve_store_secret(store: Dict[str, str], env_key: str) -> str:
    return os.environ.get(env_key, "").strip() or str(store.get(env_key) or "").strip()


def build_model_discovery_headers(api_key: str, auth_mode: str) -> Dict[str, str]:
    headers: Dict[str, str] = {"User-Agent": HTTP_USER_AGENT}
    if auth_mode == "bearer":
        if api_key:
            headers["Authorization"] = f"Bearer {api_key}"
    elif auth_mode == "anthropic":
        if api_key:
            headers["x-api-key"] = api_key
        headers["anthropic-version"] = "2023-06-01"
    elif auth_mode == "none":
        pass
    else:
        raise SwitchError(f"Unsupported model discovery auth mode: {auth_mode}")
    return headers


def extract_model_ids_from_payload(payload: Any) -> List[str]:
    items: Any = payload
    if isinstance(payload, dict):
        if isinstance(payload.get("data"), list):
            items = payload.get("data")
        elif isinstance(payload.get("models"), list):
            items = payload.get("models")
        else:
            items = []

    models: List[str] = []
    if isinstance(items, list):
        for item in items:
            model_id = ""
            if isinstance(item, dict):
                for key in ("id", "name", "model"):
                    value = str(item.get(key) or "").strip()
                    if value:
                        model_id = value
                        break
            elif isinstance(item, str):
                model_id = item.strip()
            if model_id and model_id not in models:
                models.append(model_id)
    return models


def fetch_remote_model_catalog(
    models_url: str,
    api_key: str,
    auth_modes: Iterable[str],
    *,
    timeout: int = 10,
) -> Tuple[List[str], str, str]:
    import urllib.error
    import urllib.request

    last_error = "unknown error"
    for auth_mode in auth_modes:
        headers = build_model_discovery_headers(api_key, auth_mode)
        try:
            req = urllib.request.Request(models_url, headers=headers)
            with urllib.request.urlopen(req, timeout=timeout) as resp:
                body = resp.read().decode("utf-8", errors="replace")
            payload = json.loads(body)
            models = extract_model_ids_from_payload(payload)
            if models:
                return models, auth_mode, ""
            last_error = f"{auth_mode}: no model ids found"
        except urllib.error.HTTPError as e:
            body = _read_error_body(e)
            last_error = f"{auth_mode}: HTTP {e.code}" + (f" {body}" if body else "")
        except urllib.error.URLError as e:
            last_error = f"{auth_mode}: {e.reason}"
        except json.JSONDecodeError as e:
            last_error = f"{auth_mode}: invalid JSON ({e})"
        except Exception as e:
            last_error = f"{auth_mode}: {e}"
    return [], "", last_error


def pick_preferred_model(
    models: Iterable[str],
    preferred: Iterable[str],
    *,
    family: str = "",
) -> str:
    available: List[str] = []
    for item in models:
        model_id = str(item or "").strip()
        if model_id and model_id not in available:
            available.append(model_id)

    for candidate in preferred:
        preferred_id = str(candidate or "").strip()
        if preferred_id and preferred_id in available:
            return preferred_id

    if family:
        for model_id in available:
            if model_family(model_id) == family:
                return model_id

    return ""


def resolve_flames_grok_model(requested_model: str, api_key: str) -> Tuple[str, str]:
    requested = (requested_model or "").strip()
    if requested:
        return requested, ""

    models, auth_mode, error_text = fetch_remote_model_catalog(
        derive_model_discovery_url(FLAMES_NEWAPI_BASE_URL_V1),
        api_key,
        ("bearer",),
        timeout=8,
    )
    discovered = pick_preferred_model(models, FLAMES_GROK_AVAILABLE_MODELS, family="grok")
    if discovered:
        if discovered == FLAMES_GROK_DEFAULT_MODEL:
            return discovered, ""
        return discovered, (
            f"Flames /models discovered Grok default {discovered}"
            + (f" via {auth_mode}" if auth_mode else "")
        )

    if models:
        return FLAMES_GROK_DEFAULT_MODEL, (
            f"Flames /models returned no grok-* model; fallback to {FLAMES_GROK_DEFAULT_MODEL}"
        )

    if error_text:
        return FLAMES_GROK_DEFAULT_MODEL, (
            f"Flames /models discovery failed ({error_text[:120]}); "
            f"fallback to {FLAMES_GROK_DEFAULT_MODEL}"
        )

    return FLAMES_GROK_DEFAULT_MODEL, ""


def perform_json_http_request(
    method: str,
    url: str,
    headers: Dict[str, str],
    payload: Dict[str, Any] | None = None,
    *,
    timeout: int = 12,
) -> Tuple[bool, int, str]:
    import urllib.error
    import urllib.request

    body_bytes = None
    req_headers = dict(headers)
    req_headers.setdefault("User-Agent", HTTP_USER_AGENT)
    if payload is not None:
        req_headers.setdefault("Content-Type", "application/json")
        body_bytes = json.dumps(payload).encode("utf-8")

    try:
        req = urllib.request.Request(url, data=body_bytes, headers=req_headers, method=method.upper())
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            body = resp.read().decode("utf-8", errors="replace")
            return 200 <= resp.status < 300, int(resp.status), body[:1200]
    except urllib.error.HTTPError as e:
        return False, int(e.code), _read_error_body(e)
    except urllib.error.URLError as e:
        return False, 0, str(e.reason)
    except Exception as e:
        return False, 0, str(e)


def anthropic_extra_headers(extra_env: Dict[str, str] | None = None) -> Dict[str, str]:
    payload: Dict[str, str] = {}
    extra = extra_env or {}
    betas = str(extra.get("ANTHROPIC_BETAS") or "").strip()
    if betas:
        payload["anthropic-beta"] = betas
    version = str(extra.get("ANTHROPIC_VERSION") or "").strip() or "2023-06-01"
    payload["anthropic-version"] = version
    return payload


def probe_custom_openai_provider(spec: Dict[str, Any], store: Dict[str, str]) -> List[Tuple[str, bool, str]]:
    provider_name = spec["name"]
    openai_cfg = spec.get("openai") if isinstance(spec.get("openai"), dict) else None
    if openai_cfg is None:
        return []

    api_key = resolve_store_secret(store, str(openai_cfg.get("env_key") or ""))
    if not api_key:
        return [("openai key", False, f"missing {openai_cfg.get('env_key')}")]

    results: List[Tuple[str, bool, str]] = []
    discovery = openai_cfg.get("model_discovery") if isinstance(openai_cfg.get("model_discovery"), dict) else None
    if discovery is not None:
        models, auth_mode, error_text = fetch_remote_model_catalog(
            str(discovery.get("models_url") or derive_model_discovery_url(openai_cfg["base_url"])),
            api_key,
            discovery.get("auth_modes") or ("bearer",),
        )
        if models:
            results.append(("openai /models", True, f"{len(models)} models via {auth_mode}"))
        else:
            results.append(("openai /models", False, error_text))

    target_model = str(openai_cfg.get("default_model") or "").strip()
    ok_chat, status_chat, detail_chat = perform_json_http_request(
        "POST",
        derive_openai_chat_completions_url(openai_cfg["base_url"]),
        {"Authorization": f"Bearer {api_key}"},
        {
            "model": target_model,
            "messages": [{"role": "user", "content": "Reply with exactly: ok"}],
            "max_tokens": 1,
        },
    )
    results.append(("openai /chat/completions", ok_chat, f"HTTP {status_chat}: {detail_chat[:220]}"))

    if str(openai_cfg.get("codex_wire_api") or "") == "responses":
        ok_resp, status_resp, detail_resp = perform_json_http_request(
            "POST",
            derive_openai_responses_url(openai_cfg["base_url"]),
            {"Authorization": f"Bearer {api_key}"},
            {
                "model": target_model,
                "input": "Reply with exactly: ok",
                "max_output_tokens": 1,
            },
        )
        results.append(("openai /responses", ok_resp, f"HTTP {status_resp}: {detail_resp[:220]}"))

    return results


def probe_custom_anthropic_provider(spec: Dict[str, Any], store: Dict[str, str]) -> List[Tuple[str, bool, str]]:
    provider_name = spec["name"]
    anthropic_cfg = spec.get("anthropic") if isinstance(spec.get("anthropic"), dict) else None
    if anthropic_cfg is None:
        return []

    api_key = resolve_store_secret(store, str(anthropic_cfg.get("env_key") or ""))
    if not api_key:
        return [("anthropic key", False, f"missing {anthropic_cfg.get('env_key')}")]

    results: List[Tuple[str, bool, str]] = []
    discovery = anthropic_cfg.get("model_discovery") if isinstance(anthropic_cfg.get("model_discovery"), dict) else None
    auth_modes = discovery.get("auth_modes") if discovery else ("bearer", "anthropic", "none")
    models_url = str(discovery.get("models_url") or derive_model_discovery_url(anthropic_cfg["base_url"])) if discovery else derive_model_discovery_url(anthropic_cfg["base_url"])
    models, auth_mode, error_text = fetch_remote_model_catalog(models_url, api_key, auth_modes)
    if models:
        results.append(("anthropic /models", True, f"{len(models)} models via {auth_mode}"))
    else:
        results.append(("anthropic /models", False, error_text))

    headers = build_model_discovery_headers(api_key, auth_mode or "bearer")
    headers.update(anthropic_extra_headers(anthropic_cfg.get("extra_env") if isinstance(anthropic_cfg.get("extra_env"), dict) else {}))
    ok_msg, status_msg, detail_msg = perform_json_http_request(
        "POST",
        derive_anthropic_messages_url(anthropic_cfg["base_url"]),
        headers,
        {
            "model": str(anthropic_cfg.get("default_model") or ""),
            "messages": [{"role": "user", "content": "Reply with exactly: ok"}],
            "max_tokens": 32,
        },
    )
    results.append(("anthropic /v1/messages", ok_msg, f"HTTP {status_msg}: {detail_msg[:220]}"))
    return results


def cmd_probe_provider(cfg: "Config", store: Dict[str, str], provider_name: str, *, doctor: bool = False) -> None:
    providers = custom_provider_map(load_custom_provider_store(cfg.custom_providers_file))
    name = validate_custom_provider_name(provider_name)
    spec = providers.get(name)
    if spec is None:
        raise SwitchError(f"Custom provider not found: {name}")

    if doctor:
        info(f"Refreshing model catalog for {name} before probe")
        synced_store = sync_custom_provider_specs(cfg, store, provider_name=name)
        spec = custom_provider_map(synced_store)[name]

    print(f"{CYAN}═══ {'Doctor' if doctor else 'Probe'} {name} ═══{NC}")
    sections: List[Tuple[str, bool, str]] = []
    sections.extend(probe_custom_openai_provider(spec, store))
    sections.extend(probe_custom_anthropic_provider(spec, store))
    if not sections:
        raise SwitchError(f"Custom provider '{name}' has no probeable config")

    failures = 0
    for label, ok_flag, detail in sections:
        icon = f"{GREEN}OK{NC}" if ok_flag else f"{RED}FAIL{NC}"
        if not ok_flag:
            failures += 1
        print(f"  {label:<28} {icon}  {detail}")

    if doctor:
        refreshed = load_custom_provider_store(cfg.custom_providers_file)
        current = custom_provider_map(refreshed).get(name, {})
        openai_cfg = current.get("openai") if isinstance(current.get("openai"), dict) else None
        anthropic_cfg = current.get("anthropic") if isinstance(current.get("anthropic"), dict) else None
        if openai_cfg:
            md = openai_cfg.get("model_discovery") or {}
            print(f"  {'openai cache':<28} {CYAN}INFO{NC}  models={len(openai_cfg.get('available_models') or [])} status={md.get('last_sync_status','?')}")
        if anthropic_cfg:
            md = anthropic_cfg.get("model_discovery") or {}
            print(f"  {'anthropic cache':<28} {CYAN}INFO{NC}  models={len(anthropic_cfg.get('available_models') or [])} status={md.get('last_sync_status','?')}")
    print(f"{CYAN}═══════════════════════{NC}")

    if failures:
        raise SwitchError(f"Provider {name} probe failed: {failures} checks failed")


def sync_custom_provider_model_cache(
    spec: Dict[str, Any],
    store: Dict[str, str],
    *,
    timeout: int = 10,
) -> Tuple[Dict[str, Any], List[str]]:
    updated = json.loads(json.dumps(spec))
    notes: List[str] = []

    for section_name in ("openai", "anthropic"):
        section = updated.get(section_name) if isinstance(updated.get(section_name), dict) else None
        if section is None:
            continue
        discovery = section.get("model_discovery") if isinstance(section.get("model_discovery"), dict) else None
        if discovery is None:
            continue

        env_key = str(section.get("env_key") or "").strip()
        api_key = resolve_store_secret(store, env_key)
        if not api_key:
            discovery["last_sync_status"] = "skipped"
            discovery["last_sync_error"] = f"missing {env_key}"
            discovery["last_sync_at"] = datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")
            notes.append(f"{section_name}: skipped (missing {env_key})")
            continue

        models_url = str(discovery.get("models_url") or "").strip()
        auth_modes = discovery.get("auth_modes") or []
        models, auth_mode, error_text = fetch_remote_model_catalog(
            models_url,
            api_key,
            auth_modes,
            timeout=timeout,
        )
        discovery["last_sync_at"] = datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")
        if models:
            section["available_models"] = models
            discovery["last_sync_status"] = "ok"
            discovery["last_sync_auth_mode"] = auth_mode
            discovery.pop("last_sync_error", None)
            notes.append(f"{section_name}: synced {len(models)} models via {auth_mode}")
        else:
            discovery["last_sync_status"] = "error"
            if auth_mode:
                discovery["last_sync_auth_mode"] = auth_mode
            discovery["last_sync_error"] = error_text
            notes.append(f"{section_name}: {error_text}")

    return normalize_custom_provider_spec(updated["name"], updated), notes


def custom_provider_required_env_keys(spec: Dict[str, Any], tool: str) -> List[str]:
    keys: List[str] = []
    openai_cfg = spec.get("openai") if isinstance(spec.get("openai"), dict) else None
    anthropic_cfg = spec.get("anthropic") if isinstance(spec.get("anthropic"), dict) else None

    if tool in ("all", "cc") and anthropic_cfg and "cc" in spec["tools"]:
        keys.append(str(anthropic_cfg["env_key"]))
    if tool in ("all", *CUSTOM_OPENAI_COMPATIBLE_TOOLS) and openai_cfg:
        if tool == "all" or tool in openai_cfg["tools"]:
            keys.append(str(openai_cfg["env_key"]))

    deduped: List[str] = []
    for key in keys:
        if key and key not in deduped:
            deduped.append(key)
    return deduped


def build_provider_export_bundle(
    providers: Dict[str, Any],
    store: Dict[str, str],
    *,
    names: List[str] | None = None,
    include_secrets: bool = False,
) -> Dict[str, Any]:
    selected_names = names or sorted(providers)
    selected: Dict[str, Any] = {}
    for name in selected_names:
        if name not in providers:
            raise SwitchError(f"Custom provider not found: {name}")
        selected[name] = providers[name]

    bundle: Dict[str, Any] = {
        "format": "switch-api/provider-bundle",
        "schema_version": 1,
        "exported_at": datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z"),
        "providers": selected,
    }

    if include_secrets:
        env_values: Dict[str, str] = {}
        for spec in selected.values():
            for env_key in custom_provider_required_env_keys(spec, "all"):
                secret = resolve_store_secret(store, env_key)
                if secret:
                    env_values[env_key] = secret
        if env_values:
            bundle["env_values"] = env_values

    return bundle


def normalize_provider_import_bundle(raw: Any) -> Dict[str, Any]:
    if not isinstance(raw, dict):
        raise SwitchError("Provider import payload must be a JSON object")

    providers_raw = raw.get("providers")
    if not isinstance(providers_raw, dict):
        raise SwitchError("Provider import payload must contain a providers object")

    providers: Dict[str, Any] = {}
    for name, spec in providers_raw.items():
        if not isinstance(spec, dict):
            raise SwitchError(f"Invalid custom provider spec for {name}")
        normalized = normalize_custom_provider_spec(str(name), spec)
        providers[normalized["name"]] = normalized

    if not providers:
        raise SwitchError("Provider import payload must contain at least one provider")

    env_values_raw = raw.get("env_values") or {}
    if not isinstance(env_values_raw, dict):
        raise SwitchError("Provider import env_values must be an object")

    env_values: Dict[str, str] = {}
    for key, value in env_values_raw.items():
        env_key = validate_env_key_name(str(key))
        env_values[env_key] = str(value)

    return {"providers": providers, "env_values": env_values}


def load_codex_account_store(path: Path) -> Dict[str, Any]:
    if not path.exists():
        return {"active": "", "accounts": {}}

    try:
        raw = json.loads(path.read_text(encoding="utf-8"))
    except Exception as ex:
        raise SwitchError(f"Failed to parse codex account store: {path}: {ex}")

    if not isinstance(raw, dict):
        raise SwitchError(f"Invalid codex account store: {path}")

    accounts_raw = raw.get("accounts", {})
    accounts: Dict[str, Dict[str, str]] = {}
    if isinstance(accounts_raw, dict):
        for name, meta in accounts_raw.items():
            if not isinstance(name, str):
                continue
            if isinstance(meta, str) and meta:
                accounts[name] = {"path": meta}
                continue
            if isinstance(meta, dict):
                path_value = meta.get("path", "")
                if isinstance(path_value, str) and path_value:
                    accounts[name] = {"path": path_value}

    active = raw.get("active", "")
    if not isinstance(active, str):
        active = ""

    return {"active": active, "accounts": accounts}


def save_codex_account_store(path: Path, data: Dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    try:
        path.parent.chmod(0o700)
    except Exception:
        pass

    payload = {
        "active": str(data.get("active", "") or ""),
        "accounts": data.get("accounts", {}) or {},
    }
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(payload, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    try:
        tmp.chmod(0o600)
    except Exception:
        pass
    os.replace(tmp, path)


def ensure_codex_account_name(name: str) -> str:
    value = (name or "").strip()
    if not value:
        raise SwitchError("Codex account name cannot be empty")
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", value):
        raise SwitchError("Codex account name must match [A-Za-z0-9][A-Za-z0-9._-]*")
    return value


def normalize_codex_account_path(cfg: Config, raw: str) -> Path:
    candidate = (raw or "").strip()
    if candidate.lower() in ("@current", "current"):
        return cfg.codex_home
    if candidate:
        return normalize_path(cfg.home, candidate)
    return cfg.home / ".codex-profiles" / "default"


def codex_auth_file_summary(auth_file: Path) -> str:
    if not auth_file.exists():
        return "未登录"

    try:
        data = json.loads(auth_file.read_text(encoding="utf-8"))
    except Exception:
        return "auth.json 损坏"

    auth_mode = str(data.get("auth_mode", "") or "").strip()
    if auth_mode == "chatgpt":
        return "ChatGPT OAuth"
    if auth_mode == "api_key":
        return "API key"
    if data.get("OPENAI_API_KEY"):
        return "API key"
    if auth_mode:
        return auth_mode
    return "未知"


def codex_account_auth_summary(path: Path) -> str:
    return codex_auth_file_summary(path / "auth.json")


def codex_backup(cfg: Config, path: Path) -> None:
    backup(path, cfg.codex_backup_dir)


def codex_auth_snapshot_dirs(cfg: Config) -> Iterable[Path]:
    # Prefer the dedicated accounts directory, but keep legacy root-level files readable.
    yield cfg.codex_accounts_dir
    yield cfg.codex_home


def codex_auth_backup_files(cfg: Config) -> Dict[str, Path]:
    backups: Dict[str, Path] = {}
    for directory in codex_auth_snapshot_dirs(cfg):
        if not directory.exists():
            continue
        for path in sorted(directory.glob("auth.json_*")):
            if not path.is_file():
                continue
            suffix = path.name[len("auth.json_") :]
            if suffix and suffix not in backups:
                backups[suffix] = path
    return backups


def codex_auth_account_id(path: Path) -> str:
    if not path.exists():
        return ""
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return ""
    tokens = data.get("tokens") or {}
    if isinstance(tokens, dict):
        account_id = str(tokens.get("account_id") or "").strip()
        if account_id:
            return account_id
    return str(data.get("account_id") or "").strip()


def find_current_codex_auth_backup_name(cfg: Config) -> str:
    current_id = codex_auth_account_id(cfg.codex_home / "auth.json")
    if not current_id:
        return ""
    for name, path in codex_auth_backup_files(cfg).items():
        if codex_auth_account_id(path) == current_id:
            return name
    return ""


def read_codex_model_provider(text: str) -> str:
    m = re.search(r'^\s*model_provider\s*=\s*"([^"]+)"\s*$', text, re.M)
    return m.group(1).strip() if m else ""


def set_codex_model_provider(text: str, provider: str) -> str:
    line = f'model_provider = "{provider}"'
    if re.search(r'^\s*model_provider\s*=\s*"[^"]+"\s*$', text, flags=re.M):
        return re.sub(
            r'^\s*model_provider\s*=\s*"[^"]+"\s*$',
            line,
            text,
            count=1,
            flags=re.M,
        )
    return line + "\n" + text


def read_codex_top_level_string(text: str, key: str) -> str:
    match = re.search(
        rf'^\s*{re.escape(key)}\s*=\s*"([^"]*)"\s*$',
        text,
        re.M,
    )
    return match.group(1).strip() if match else ""


def set_codex_top_level_string(text: str, key: str, value: str) -> str:
    line = f"{key} = {json.dumps(value)}"
    pattern = rf'^\s*{re.escape(key)}\s*=\s*"[^"]*"\s*$'
    if re.search(pattern, text, re.M):
        return re.sub(pattern, line, text, count=1, flags=re.M)
    return line + "\n" + text


def remove_codex_top_level_string(text: str, key: str) -> str:
    pattern = rf'^\s*{re.escape(key)}\s*=\s*"[^"]*"\s*\n?'
    return re.sub(pattern, "", text, count=1, flags=re.M)


def comment_codex_model_provider(text: str) -> str:
    m = re.search(r'^(?P<indent>\s*)model_provider\s*=\s*"(?P<provider>[^"]+)"\s*$', text, re.M)
    if not m:
        return text
    replacement = f'{m.group("indent")}# model_provider = "{m.group("provider").strip()}"'
    return text[: m.start()] + replacement + text[m.end() :]


def read_codex_provider_env_key(text: str, provider_name: str) -> str:
    section_re = re.compile(
        rf'(?ms)^\[model_providers\.{re.escape(provider_name)}\]\s*$\n(?P<body>.*?)(?=^\[|\Z)'
    )
    section = section_re.search(text)
    if not section:
        return ""
    body = section.group("body")
    m = re.search(r'^\s*env_key\s*=\s*"([^"]+)"\s*$', body, re.M)
    return m.group(1).strip() if m else ""


def set_codex_provider_env_key(text: str, provider_name: str, env_key_name: str) -> str:
    section_re = re.compile(
        rf'(?ms)^(?P<header>\[model_providers\.{re.escape(provider_name)}\]\s*$\n)(?P<body>.*?)(?=^\[|\Z)'
    )
    section = section_re.search(text)
    if section:
        body = section.group("body")
        if re.search(r'^\s*env_key\s*=\s*"[^"]+"\s*$', body, re.M):
            body = re.sub(
                r'^\s*env_key\s*=\s*"[^"]+"\s*$',
                f'env_key = "{env_key_name}"',
                body,
                count=1,
                flags=re.M,
            )
        elif re.search(r'^\s*wire_api\s*=\s*"[^"]+"\s*$', body, re.M):
            body = re.sub(
                r'^(\s*wire_api\s*=\s*"[^"]+"\s*$)',
                f'env_key = "{env_key_name}"\n\\1',
                body,
                count=1,
                flags=re.M,
            )
        else:
            if body and not body.endswith("\n"):
                body += "\n"
            body += f'env_key = "{env_key_name}"\n'
        return text[: section.start()] + section.group("header") + body + text[section.end() :]

    block = (
        "\n\n# Flames NewAPI\n"
        "[model_providers.flames_newapi]\n"
        'name = "Flames NewAPI"\n'
        f'base_url = "{FLAMES_NEWAPI_BASE_URL_V1}"\n'
        f'env_key = "{env_key_name}"\n'
        'wire_api = "responses"\n'
    )
    return text.rstrip() + block + "\n"


def read_toml_table_string(text: str, table_name: str, key: str) -> str:
    section_re = re.compile(
        rf'(?ms)^\[{re.escape(table_name)}\][ \t]*$\n(?P<body>.*?)(?=^\[|\Z)'
    )
    section = section_re.search(text)
    if not section:
        return ""
    body = section.group("body")
    m = re.search(rf'^[ \t]*{re.escape(key)}[ \t]*=[ \t]*"([^"]*)"[ \t]*$', body, re.M)
    return m.group(1).strip() if m else ""


def grok_model_table_name(model_id: str) -> str:
    """Return the TOML table path for a Grok model ID."""
    if re.fullmatch(r"[A-Za-z0-9_-]+", model_id):
        return f"model.{model_id}"
    return f"model.{json.dumps(model_id)}"


def set_toml_table_bool(text: str, table_name: str, key: str, value: bool) -> str:
    """Set a simple boolean key under a TOML table, creating the table if needed."""
    rendered = "true" if value else "false"
    section_re = re.compile(
        rf'(?ms)^(?P<header>\[{re.escape(table_name)}\][ \t]*$\n)(?P<body>.*?)(?=^\[|\Z)'
    )
    section = section_re.search(text)
    if section:
        body = section.group("body")
        if re.search(rf'^[ \t]*{re.escape(key)}[ \t]*=[ \t]*(true|false)[ \t]*$', body, re.M):
            body = re.sub(
                rf'^[ \t]*{re.escape(key)}[ \t]*=[ \t]*(true|false)[ \t]*$',
                f'{key} = {rendered}',
                body,
                count=1,
                flags=re.M,
            )
        else:
            if body and not body.endswith("\n"):
                body += "\n"
            body += f'{key} = {rendered}\n'
        return text[: section.start()] + section.group("header") + body + text[section.end() :]

    return text.rstrip() + f'\n\n[{table_name}]\n{key} = {rendered}\n'


def set_toml_table_string(text: str, table_name: str, key: str, value: str) -> str:
    """Set a simple string key under a TOML table, creating the table if needed."""
    rendered = json.dumps(value)
    section_re = re.compile(
        rf'(?ms)^(?P<header>\[{re.escape(table_name)}\][ \t]*$\n)(?P<body>.*?)(?=^\[|\Z)'
    )
    section = section_re.search(text)
    if section:
        body = section.group("body")
        if re.search(rf'^[ \t]*{re.escape(key)}[ \t]*=[ \t]*"[^"]*"[ \t]*$', body, re.M):
            body = re.sub(
                rf'^[ \t]*{re.escape(key)}[ \t]*=[ \t]*"[^"]*"[ \t]*$',
                f"{key} = {rendered}",
                body,
                count=1,
                flags=re.M,
            )
        else:
            if body and not body.endswith("\n"):
                body += "\n"
            body += f"{key} = {rendered}\n"
        return text[: section.start()] + section.group("header") + body + text[section.end() :]

    return text.rstrip() + f"\n\n[{table_name}]\n{key} = {rendered}\n"


def shell_rc_sources_home_env(rc_text: str) -> bool:
    patterns = (
        r'(^|\s)source\s+~\/\.env(\s|$)',
        r'(^|\s)source\s+"\$HOME/\.env"(\s|$)',
        r"(^|\s)\.\s+~/\.env(\s|$)",
        r'(^|\s)\.\s+"\$HOME/\.env"(\s|$)',
        r'(^|\s)\[\s*-f\s+"\$HOME/\.env"\s*\]\s*&&\s*source\s+"\$HOME/\.env"(\s|$)',
    )
    return any(re.search(pattern, rc_text, re.M) for pattern in patterns)


def ensure_shell_rc_sources_home_env(rc_path: Path) -> bool:
    existing = rc_path.read_text(encoding="utf-8", errors="ignore") if rc_path.exists() else ""
    if shell_rc_sources_home_env(existing):
        return False

    block = (
        "\n# switch-api shared env\n"
        f"{SHELL_ENV_SOURCE_LINE}\n"
    )
    if existing and not existing.endswith("\n"):
        existing += "\n"
    write_text(rc_path, existing + block)
    return True


def sync_shared_shell_env(cfg: "Config", updates: Dict[str, str]) -> None:
    if not updates:
        return
    update_bashrc_exports(cfg.home / ".env", updates)
    ensure_shell_rc_sources_home_env(cfg.zshrc)
    ensure_shell_rc_sources_home_env(cfg.bashrc)
    for key, value in updates.items():
        os.environ[key] = value


def sync_env_key_to_shell_files(cfg: "Config", key: str, value: str) -> None:
    """Persist an API key to ~/.env and ensure login shells source it."""
    if not value:
        return
    sync_shared_shell_env(cfg, {key: value})

def detect_codex_openai_mode(cfg: Config) -> str:
    if not cfg.cx_config.exists():
        return ""
    text = read_text(cfg.cx_config)
    provider = read_codex_model_provider(text)
    if provider == "flames_newapi":
        env_key = read_codex_provider_env_key(text, "flames_newapi")
        if env_key == "OPENAI_GQ80_API_KEY":
            return "flames_newapi:Gq80"
        if env_key == "OPENAI_V420_API_KEY":
            return "flames_newapi:V420"
        if env_key:
            return f"flames_newapi:{env_key}"
        return "flames_newapi"

    auth_file = cfg.codex_home / "auth.json"
    if not auth_file.exists():
        return ""
    try:
        data = json.loads(auth_file.read_text(encoding="utf-8"))
    except Exception:
        return ""
    auth_mode = str(data.get("auth_mode", "") or "").strip()
    if auth_mode == "chatgpt":
        backup_name = find_current_codex_auth_backup_name(cfg)
        return f"official:{backup_name}" if backup_name else "official"
    if auth_mode == "api_key" or data.get("OPENAI_API_KEY"):
        return "api_key"
    return ""


def find_codex_account_name(store: Dict[str, Any], path: Path) -> str:
    current = os.path.abspath(str(path))
    accounts = store.get("accounts", {})
    if not isinstance(accounts, dict):
        return ""
    for name, meta in accounts.items():
        if not isinstance(meta, dict):
            continue
        target = meta.get("path", "")
        if isinstance(target, str) and target and os.path.abspath(target) == current:
            return name
    return ""


def cmd_codex_account_status(cfg: Config) -> None:
    store = load_codex_account_store(cfg.codex_accounts_file)
    active = str(store.get("active", "") or "")
    current_name = find_codex_account_name(store, cfg.codex_home)
    accounts = store.get("accounts", {})
    auth_backup = find_current_codex_auth_backup_name(cfg)

    print(f"{CYAN}═══ Codex Account Status ═══{NC}")
    print(f"  CODEX_HOME   {cfg.codex_home}")
    print(f"  accounts_dir {cfg.codex_accounts_dir}")
    print(f"  backup_dir   {cfg.codex_backup_dir}")
    print(f"  auth         {codex_account_auth_summary(cfg.codex_home)}")
    print(f"  auth_backup  {auth_backup or '(none)'}")
    print(f"  registered   {'yes' if current_name else 'no'}")
    print(f"  current      {current_name or '(unregistered)'}")
    print(f"  selected     {active or '(none)'}")
    print(f"  accounts     {len(accounts) if isinstance(accounts, dict) else 0}")
    print(f"{CYAN}═══════════════════════════{NC}")


def cmd_codex_account_list(cfg: Config) -> None:
    store = load_codex_account_store(cfg.codex_accounts_file)
    accounts = store.get("accounts", {})
    active = str(store.get("active", "") or "")
    current_name = find_codex_account_name(store, cfg.codex_home)
    auth_backups = codex_auth_backup_files(cfg)
    current_auth_name = find_current_codex_auth_backup_name(cfg)

    print(f"{CYAN}═══ Codex Accounts ═══{NC}")
    has_registered = isinstance(accounts, dict) and bool(accounts)
    if not has_registered and not auth_backups:
        print("  (no accounts registered)")
        print(f"{CYAN}══════════════════════{NC}")
        return

    if has_registered:
        for name in sorted(accounts):
            meta = accounts.get(name, {})
            if not isinstance(meta, dict):
                continue
            path_value = str(meta.get("path", "") or "")
            marker = []
            if name == current_name:
                marker.append("current")
            if name == active:
                marker.append("selected")
            status = ", ".join(marker) if marker else "-"
            auth = codex_account_auth_summary(Path(path_value)) if path_value else "未配置"
            print(f"  {name:<16} {status:<18} {auth:<14} {path_value}")

    if auth_backups:
        if has_registered:
            print("  -- auth snapshots --")
        for name, path in auth_backups.items():
            marker = []
            if name == current_auth_name:
                marker.append("current-auth")
            if name == active:
                marker.append("selected")
            status = ", ".join(marker) if marker else "-"
            auth = codex_auth_file_summary(path)
            print(f"  {name:<16} {status:<18} {auth:<14} {path}")
    print(f"{CYAN}══════════════════════{NC}")


def cmd_codex_account_add(cfg: Config, name: str, path_arg: str = "") -> None:
    account_name = ensure_codex_account_name(name)
    target = normalize_codex_account_path(cfg, path_arg or f".codex-profiles/{account_name}")
    target.mkdir(parents=True, exist_ok=True)

    store = load_codex_account_store(cfg.codex_accounts_file)
    accounts = store.setdefault("accounts", {})
    if not isinstance(accounts, dict):
        accounts = {}
        store["accounts"] = accounts

    accounts[account_name] = {"path": str(target)}
    if not store.get("active"):
        current_name = find_codex_account_name(store, cfg.codex_home)
        if current_name:
            store["active"] = current_name

    save_codex_account_store(cfg.codex_accounts_file, store)

    ok(f"Codex account registered: {account_name}")
    info(f"  path: {target}")
    info(f"  auth: {codex_account_auth_summary(target)}")
    if codex_account_auth_summary(target) == "未登录":
        warn(f'可运行: CODEX_HOME="{target}" codex login --device-auth')


def cmd_codex_account_use(cfg: Config, name: str) -> None:
    raw_name = (name or "").strip()
    if not raw_name:
        raise SwitchError("Codex account name cannot be empty")
    auth_backups = codex_auth_backup_files(cfg)
    if raw_name in auth_backups:
        source = auth_backups[raw_name]
        target = cfg.codex_home / "auth.json"
        target.parent.mkdir(parents=True, exist_ok=True)
        codex_backup(cfg, target)
        shutil.copy2(source, target)
        try:
            target.chmod(0o600)
        except Exception:
            pass

        store = load_codex_account_store(cfg.codex_accounts_file)
        store["active"] = raw_name
        save_codex_account_store(cfg.codex_accounts_file, store)

        ok(f"Codex auth → {raw_name}")
        info(f"  copied: {source} -> {target}")
        warn("如果当前使用 Codex 官方模式，请重新启动 codex 会话使新的 auth.json 生效")
        return

    account_name = ensure_codex_account_name(raw_name)
    store = load_codex_account_store(cfg.codex_accounts_file)
    accounts = store.get("accounts", {})
    if not isinstance(accounts, dict) or account_name not in accounts:
        raise SwitchError(f"Unknown codex account: {account_name}")

    meta = accounts.get(account_name, {})
    if not isinstance(meta, dict):
        raise SwitchError(f"Invalid codex account entry: {account_name}")

    target_raw = str(meta.get("path", "") or "")
    if not target_raw:
        raise SwitchError(f"Codex account '{account_name}' has no path configured")

    target = normalize_path(cfg.home, target_raw)
    target.mkdir(parents=True, exist_ok=True)

    store["active"] = account_name
    accounts[account_name] = {"path": str(target)}
    save_codex_account_store(cfg.codex_accounts_file, store)

    os.environ["CODEX_HOME"] = str(target)
    update_bashrc_exports(cfg.bashrc, {"CODEX_HOME": str(target)})
    update_bashrc_exports(cfg.zshrc, {"CODEX_HOME": str(target)})

    ok(f"Codex account → {account_name}")
    info(f"  CODEX_HOME={target}")
    info(f"  auth={codex_account_auth_summary(target)}")
    warn("当前 shell 需要执行 `source ~/.zshrc` 或重新打开终端，普通 `codex` 才会切到该账号")


def enrich_store_from_env(store: Dict[str, str]) -> Dict[str, str]:
    merged = dict(store)

    # explicit env vars always take precedence for persistence
    explicit = {
        "duck_anthropic": os.environ.get("DUCK_ANTHROPIC_API_KEY", ""),
        "duck_gemini": os.environ.get("DUCK_GEMINI_API_KEY", ""),
        "duck_codex": os.environ.get("DUCKCODING_API_KEY", ""),
        "quotio": os.environ.get("QUOTIO_API_KEY", ""),
        "antigravity": os.environ.get("ANTIGRAVITY_API_KEY", ""),
        "xingyun": os.environ.get("XINGYUN_API_KEY", ""),
        "molifang": os.environ.get(MOLIFANG_ENV_KEY, ""),
        "flames": os.environ.get("FLAMES_API_KEY", ""),
        "deepseek": os.environ.get("DEEPSEEK_API_KEY", ""),
        "openrouter": os.environ.get("OPENROUTER_API_KEY", ""),
        "aiwave": os.environ.get("AIWAVE_API_KEY", ""),
        "aiwave_codex": os.environ.get(AIWAVE_CODEX_ENV_KEY, "") or os.environ.get("AIWAVE_API_KEY", ""),
        "aiwave_gemini_gcp": os.environ.get(AIWAVE_GEMINI_GCP_ENV_KEY, ""),
        "aiwave_gemini": os.environ.get(AIWAVE_GEMINI_GCP_ENV_KEY, "")
        or os.environ.get(AIWAVE_GEMINI_ENV_KEY, "")
        or os.environ.get("AIWAVE_API_KEY", ""),
        "aiwave_claude_anti": os.environ.get(AIWAVE_CLAUDE_ANTI_ENV_KEY, ""),
        "aiwave_claude_omg": os.environ.get(AIWAVE_CLAUDE_OMG_ENV_KEY, ""),
        "duck_cc1": os.environ.get("DUCK_CC1_API_KEY", ""),
        "duck_codex2cc": os.environ.get("DUCK_CODEX2CC_API_KEY", ""),
        "openai_Gq80": os.environ.get("OPENAI_GQ80_API_KEY", ""),
        "openai_V420": os.environ.get("OPENAI_V420_API_KEY", ""),
        "icodeeasy": os.environ.get("ICODEEASY_API_KEY", ""),
    }
    for k, v in explicit.items():
        if v:
            merged[k] = v

    # conservative inference only when target slot is still empty
    if not merged.get("duck_anthropic") and os.environ.get("ANTHROPIC_API_KEY"):
        merged["duck_anthropic"] = os.environ["ANTHROPIC_API_KEY"]

    if not merged.get("duck_gemini"):
        base = os.environ.get("GEMINI_BASE_URL", "")
        gkey = os.environ.get("GEMINI_API_KEY", "")
        if gkey and "duckcoding" in base:
            merged["duck_gemini"] = gkey

    if not merged.get("quotio"):
        base = os.environ.get("GEMINI_BASE_URL", "")
        gkey = os.environ.get("GEMINI_API_KEY", "")
        if gkey and "ancientechoes" in base:
            merged["quotio"] = gkey

    return merged


