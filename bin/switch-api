        anthropic_cfg = spec.get("anthropic") if isinstance(spec.get("anthropic"), dict) else None
        entry: Dict[str, Any] = {
            "custom": True,
            "kind": spec["kind"],
            "base_url": spec["base_url"],
            "env_key": spec["env_key"],
            "tools": list(spec["tools"]),
        }
