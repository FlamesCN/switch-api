    print("       switch-api cc duck_codex2cc      # CC → Duck CodeX (opus→xhigh, sonnet→high)")
    print()
    print("  switch-api list [provider]             # 列出可用模型")
    print("  switch-api list [provider] --online    # 在线刷新 custom provider 模型后再列出")
    print("  switch-api check [--online]            # 检查当前模型状态")
    print("  switch-api codex-account use <name>    # 切换 accounts/auth.json_* 或官方账号目录")
    print("  switch-api key set <ENV_KEY> <VALUE>   # 写入 credentials.json + ~/.env，并确保 shell source ~/.env")
    print("  switch-api provider add-openai ...     # 注册自定义 OpenAI-compatible provider（codex/openclaw/droid/hermes/grok）")
    print("  switch-api provider add-anthropic ...  # 注册自定义 Anthropic-compatible provider（cc）")
    print("  switch-api provider sync-models ...    # 同步 custom provider 的 /models 列表到 provider-models.json")
    print("  switch-api provider export ...         # 导出 provider bundle（默认不带 secrets）")
    print("  switch-api provider import ...         # 导入 provider bundle（默认 merge，可 --replace）")
    print("  switch-api <tool> <provider> <model>   # 指定模型切换")


def parse_global_flags(argv: Iterable[str]) -> Tuple[List[str], bool, str, bool, str, bool]:
    args = list(argv)
    positional: List[str] = []
    force = False
    agent_id = ""
    all_agents = False
    hermes_profile = ""
    all_hermes_profiles = False

    idx = 0
    while idx < len(args):
        arg = args[idx]
        if arg == "--force":
            force = True
            idx += 1
            continue
        if arg == "--all-agents":
            all_agents = True
            idx += 1
            continue
        if arg == "--all-profiles":
            all_hermes_profiles = True
            idx += 1
            continue
        if arg == "--agent":
            if idx + 1 >= len(args):
                err("Missing value for --agent")
                raise SystemExit(1)
            agent_id = args[idx + 1].strip()
            if not agent_id:
                err("--agent requires a non-empty agent id")
                raise SystemExit(1)
            idx += 2
            continue
        if arg.startswith("--agent="):
            agent_id = arg.split("=", 1)[1].strip()
            if not agent_id:
                err("--agent requires a non-empty agent id")
                raise SystemExit(1)
            idx += 1
            continue
        if arg == "--profile":
            if idx + 1 >= len(args):
                err("Missing value for --profile")
                raise SystemExit(1)
            hermes_profile = args[idx + 1].strip()
            if not hermes_profile:
                err("--profile requires a non-empty profile name")
                raise SystemExit(1)
            idx += 2
            continue
        if arg.startswith("--profile="):
            hermes_profile = arg.split("=", 1)[1].strip()
            if not hermes_profile:
                err("--profile requires a non-empty profile name")
                raise SystemExit(1)
            idx += 1
            continue
        positional.append(arg)
        idx += 1

    if agent_id and all_agents:
        err("--agent and --all-agents cannot be used together")
        raise SystemExit(1)
    if hermes_profile and all_hermes_profiles:
        err("--profile and --all-profiles cannot be used together")
        raise SystemExit(1)

    return positional, force, agent_id, all_agents, hermes_profile, all_hermes_profiles


def switch_path_touches_openclaw(tool: str, provider: str, custom_store: Dict[str, Any] | None = None) -> bool:
    if tool == "openclaw":
        return True
    if tool != "all":
        return False
    spec = custom_provider_map(custom_store or {}).get(provider)
    if spec:
        return "openclaw" in spec["tools"]
    if provider == "openai" or provider in OPENAI_NAMED_PROVIDERS:
        return False
    if provider == "quotio_local":
        return False
    if provider in CC_ONLY_PROVIDERS:
        return False
    return True


def switch_path_touches_hermes(tool: str, provider: str, custom_store: Dict[str, Any] | None = None) -> bool:
    if tool == "hermes":
        return True
    if tool != "all":
        return False
    spec = custom_provider_map(custom_store or {}).get(provider)
    if spec:
        return "hermes" in spec["tools"]
    return provider in ("flames", "aiwave", "molifang")


def normalize_tool_name(tool: str) -> str:
    return TOOL_ALIASES.get(tool, tool)


def parse_custom_env_kv(arg: str) -> Tuple[str, str]:
    if "=" not in arg:
        raise SwitchError("Expected KEY=VALUE for --env")
    key, value = arg.split("=", 1)
    env_key = validate_env_key_name(key.strip())
    return env_key, value


def parse_provider_add_openai_args(args: List[str]) -> Dict[str, Any]:
    if len(args) < 4:
        raise SwitchError(
            "Usage: switch-api provider add-openai <name> <base_url> <env_key> <default_model> "
            "[--tools codex,openclaw,droid,hermes,grok] "
            "[--openclaw-api openai-completions|openai-responses] "
            "[--hermes-api-mode codex_responses|chat_completions] "
            "[--models-url URL] [--models-auth bearer,anthropic,none] [--no-model-discovery] "
            "[--disable-image-generation]"
        )

    spec: Dict[str, Any] = {
        "name": args[0],
        "base_url": args[1],
        "env_key": args[2],
        "default_model": args[3],
        "tools": list(CUSTOM_OPENAI_COMPATIBLE_TOOLS),
        "openclaw_api": "openai-completions",
        "hermes_api_mode": "codex_responses",
        "codex_wire_api": "responses",
        "codex_features": {},
        "model_discovery": {},
    }

    idx = 4
    while idx < len(args):
        arg = args[idx]
        if arg == "--disable-image-generation":
            spec["codex_features"]["image_generation"] = False
            idx += 1
            continue
        if arg == "--no-model-discovery":
            spec["model_discovery"] = False
            idx += 1
            continue
        if arg.startswith("--models-url="):
            if spec["model_discovery"] is False:
                spec["model_discovery"] = {}
            spec["model_discovery"]["models_url"] = arg.split("=", 1)[1].strip()
            idx += 1
            continue
        if arg == "--models-url":
            if idx + 1 >= len(args):
                raise SwitchError("Missing value for --models-url")
            if spec["model_discovery"] is False:
                spec["model_discovery"] = {}
            spec["model_discovery"]["models_url"] = args[idx + 1].strip()
            idx += 2
            continue
        if arg.startswith("--models-auth="):
            if spec["model_discovery"] is False:
                spec["model_discovery"] = {}
            spec["model_discovery"]["auth_modes"] = [
                part.strip() for part in arg.split("=", 1)[1].split(",") if part.strip()
            ]
            idx += 1
            continue
        if arg == "--models-auth":
            if idx + 1 >= len(args):
                raise SwitchError("Missing value for --models-auth")
            if spec["model_discovery"] is False:
                spec["model_discovery"] = {}
            spec["model_discovery"]["auth_modes"] = [
                part.strip() for part in args[idx + 1].split(",") if part.strip()
            ]
            idx += 2
            continue
        if arg.startswith("--tools="):
            spec["tools"] = [part.strip() for part in arg.split("=", 1)[1].split(",") if part.strip()]
            idx += 1
            continue
        if arg == "--tools":
            if idx + 1 >= len(args):
                raise SwitchError("Missing value for --tools")
            spec["tools"] = [part.strip() for part in args[idx + 1].split(",") if part.strip()]
            idx += 2
            continue
        if arg.startswith("--openclaw-api="):
            spec["openclaw_api"] = arg.split("=", 1)[1].strip()
            idx += 1
            continue
        if arg == "--openclaw-api":
            if idx + 1 >= len(args):
                raise SwitchError("Missing value for --openclaw-api")
            spec["openclaw_api"] = args[idx + 1].strip()
            idx += 2
            continue
        if arg.startswith("--hermes-api-mode="):
            spec["hermes_api_mode"] = arg.split("=", 1)[1].strip()
            idx += 1
            continue
        if arg == "--hermes-api-mode":
            if idx + 1 >= len(args):
                raise SwitchError("Missing value for --hermes-api-mode")
            spec["hermes_api_mode"] = args[idx + 1].strip()
            idx += 2
            continue
        raise SwitchError(f"Unknown provider add-openai option: {arg}")

    return normalize_custom_provider_spec(spec["name"], {"name": spec["name"], "openai": spec})


def parse_provider_add_anthropic_args(args: List[str]) -> Dict[str, Any]:
    if len(args) < 4:
        raise SwitchError(
            "Usage: switch-api provider add-anthropic <name> <base_url> <env_key> <default_model> "
            "[--env KEY=VALUE ...] [--models-url URL] [--models-auth bearer,anthropic,none] [--no-model-discovery]"
        )

    spec: Dict[str, Any] = {
        "name": args[0],
        "base_url": args[1],
        "env_key": args[2],
        "default_model": args[3],
        "extra_env": {},
        "model_discovery": {},
    }

    idx = 4
    while idx < len(args):
        arg = args[idx]
        if arg.startswith("--env="):
            key, value = parse_custom_env_kv(arg.split("=", 1)[1].strip())
            spec["extra_env"][key] = value
            idx += 1
            continue
        if arg == "--env":
            if idx + 1 >= len(args):
                raise SwitchError("Missing value for --env")
            key, value = parse_custom_env_kv(args[idx + 1].strip())
            spec["extra_env"][key] = value
            idx += 2
            continue
        if arg == "--no-model-discovery":
            spec["model_discovery"] = False
            idx += 1
            continue
        if arg.startswith("--models-url="):
            if spec["model_discovery"] is False:
                spec["model_discovery"] = {}
            spec["model_discovery"]["models_url"] = arg.split("=", 1)[1].strip()
            idx += 1
            continue
        if arg == "--models-url":
            if idx + 1 >= len(args):
                raise SwitchError("Missing value for --models-url")
            if spec["model_discovery"] is False:
                spec["model_discovery"] = {}
            spec["model_discovery"]["models_url"] = args[idx + 1].strip()
            idx += 2
            continue
        if arg.startswith("--models-auth="):
            if spec["model_discovery"] is False:
                spec["model_discovery"] = {}
            spec["model_discovery"]["auth_modes"] = [
                part.strip() for part in arg.split("=", 1)[1].split(",") if part.strip()
            ]
            idx += 1
            continue
        if arg == "--models-auth":
            if idx + 1 >= len(args):
                raise SwitchError("Missing value for --models-auth")
            if spec["model_discovery"] is False:
                spec["model_discovery"] = {}
            spec["model_discovery"]["auth_modes"] = [
                part.strip() for part in args[idx + 1].split(",") if part.strip()
            ]
            idx += 2
            continue
        raise SwitchError(f"Unknown provider add-anthropic option: {arg}")

    return normalize_custom_provider_spec(spec["name"], {"name": spec["name"], "anthropic": spec})


def parse_provider_export_args(args: List[str], *, export_all: bool = False) -> Dict[str, Any]:
    if not args and not export_all:
        raise SwitchError("Usage: switch-api provider export <name> [path|-] [--with-secrets]")

    name = ""
    out_path = ""
    include_secrets = False

    idx = 0
    if not export_all:
        name = args[0]
        idx = 1

    while idx < len(args):
        arg = args[idx]
        if arg == "--with-secrets":
            include_secrets = True
            idx += 1
            continue
        if arg.startswith("--"):
            raise SwitchError(f"Unknown provider export option: {arg}")
        if out_path:
            raise SwitchError("Provider export accepts at most one output path")
        out_path = arg
        idx += 1

    return {
        "name": name,
        "path": out_path,
        "with_secrets": include_secrets,
        "all": export_all,
    }


def parse_provider_import_args(args: List[str]) -> Dict[str, Any]:
    if not args:
        raise SwitchError("Usage: switch-api provider import <path|-> [--replace]")

    source = ""
    replace = False

    idx = 0
    while idx < len(args):
        arg = args[idx]
        if arg == "--replace":
            replace = True
            idx += 1
            continue
        if arg.startswith("--"):
            raise SwitchError(f"Unknown provider import option: {arg}")
        if source:
            raise SwitchError("Provider import accepts exactly one source path")
        source = arg
        idx += 1

    if not source:
        raise SwitchError("Usage: switch-api provider import <path|-> [--replace]")

    return {"path": source, "replace": replace}


def parse_model_override_add_args(args: List[str]) -> Dict[str, Any]:
    if len(args) < 2:
        raise SwitchError(
            "Usage: switch-api model add <provider> <model> "
            "[--tools cc,codex,...|all] [--vision]"
        )
    provider, model = args[0], args[1]
    tools = ["cc", "codex"]
    vision = False
    idx = 2
    while idx < len(args):
        arg = args[idx]
        if arg == "--vision":
            vision = True
            idx += 1
            continue
        if arg.startswith("--tools="):
            tools = [part.strip() for part in arg.split("=", 1)[1].split(",") if part.strip()]
            idx += 1
            continue
        if arg == "--tools":
            if idx + 1 >= len(args):
                raise SwitchError("Missing value for --tools")
            tools = [part.strip() for part in args[idx + 1].split(",") if part.strip()]
            idx += 2
            continue
        raise SwitchError(f"Unknown model add option: {arg}")
    return {"provider": provider, "model": model, "tools": tools, "vision": vision}


def parse_args(argv: Iterable[str], known_providers: Iterable[str] | None = None) -> Tuple[str, str, Any]:
    """Returns (action, provider, profile_or_model).
    action can be: status, check, check-online, list, list-<provider>,
                   or a tool name (cc/openclaw/codex/droid/gemini/all).
    """
    args = list(argv)
    providers = tuple(dict.fromkeys(list(PROVIDERS) + list(known_providers or ())))
    provider_set = set(providers)

    if not args:
        usage()
        raise SystemExit(1)

    if args[0] == "key":
        if len(args) == 2 and args[1] == "list":
            return ("key-list", "", "")
        if len(args) == 4 and args[1] == "set":
            return ("key-set", args[2], args[3])
        err("Usage: switch-api key <list|set ENV_KEY VALUE>")
        usage()
        raise SystemExit(1)

    if args[0] == "provider":
        if len(args) == 2 and args[1] == "list":
            return ("provider-list", "", "")
        if len(args) == 2 and args[1] == "sync-models":
            return ("provider-sync-models", "", "")
        if len(args) == 3 and args[1] == "sync-models":
            return ("provider-sync-models", args[2], "")
        if len(args) == 3 and args[1] in ("rm", "remove", "delete"):
            return ("provider-remove", args[2], "")
        if len(args) >= 6 and args[1] == "add-openai":
            try:
                spec = parse_provider_add_openai_args(args[2:])
            except SwitchError as ex:
                err(str(ex))
                usage()
                raise SystemExit(1)
            return ("provider-add-openai", spec["name"], spec)
        if len(args) >= 6 and args[1] == "add-anthropic":
            try:
                spec = parse_provider_add_anthropic_args(args[2:])
            except SwitchError as ex:
                err(str(ex))
                usage()
                raise SystemExit(1)
            return ("provider-add-anthropic", spec["name"], spec)
        if len(args) >= 3 and args[1] == "export":
            try:
                payload = parse_provider_export_args(args[2:], export_all=False)
            except SwitchError as ex:
                err(str(ex))
                usage()
                raise SystemExit(1)
            return ("provider-export", payload["name"], payload)
        if len(args) >= 2 and args[1] == "export-all":
            try:
                payload = parse_provider_export_args(args[2:], export_all=True)
            except SwitchError as ex:
                err(str(ex))
                usage()
                raise SystemExit(1)
            return ("provider-export-all", "", payload)
        if len(args) >= 3 and args[1] == "import":
            try:
                payload = parse_provider_import_args(args[2:])
            except SwitchError as ex:
                err(str(ex))
                usage()
                raise SystemExit(1)
            return ("provider-import", payload["path"], payload)
        err("Usage: switch-api provider <list|sync-models|rm|add-openai|add-anthropic|export|export-all|import> ...")
        usage()
        raise SystemExit(1)

    if args[0] == "model":
        if len(args) == 2 and args[1] == "list":
            return ("model-override-list", "", "")
        if len(args) == 4 and args[1] in ("rm", "remove", "delete"):
            return ("model-override-remove", args[2], args[3])
        if len(args) >= 4 and args[1] == "add":
            try:
                payload = parse_model_override_add_args(args[2:])
            except SwitchError as ex:
                err(str(ex))
                usage()
                raise SystemExit(1)
            return ("model-override-add", payload["provider"], payload)
        err("Usage: switch-api model <list|add|rm> ...")
        usage()
        raise SystemExit(1)

    if args[0] == "codex-account":
        if len(args) == 2 and args[1] in ("status", "list"):
            return (f"codex-account-{args[1]}", "", "")
        if len(args) == 3 and args[1] == "use":
            return ("codex-account-use", args[2], "")
        if len(args) == 3 and args[1] == "add":
            return ("codex-account-add", args[2], "")
        if len(args) == 4 and args[1] == "add":
            return ("codex-account-add", args[2], args[3])
        err("Usage: switch-api codex-account <status|list|add|use> ...")
        usage()
        raise SystemExit(1)

    if len(args) == 1:
        a0 = args[0]
        if a0 in ("-h", "--help", "help"):
            usage()
            raise SystemExit(0)
        if a0 in ("-v", "--version", "version"):
            print(APP_VERSION)
            raise SystemExit(0)
        if a0 == "status":
            return ("status", "", "")
        if a0 == "check":
            return ("check", "", "")
        if a0 == "probe":
            err("Usage: switch-api probe <custom-provider>")
            raise SystemExit(1)
        if a0 == "doctor":
            err("Usage: switch-api doctor <custom-provider>")
            raise SystemExit(1)
        if a0 == "list":
            return ("list", "", "")
        if a0 in provider_set:
            return ("all", a0, "")

        err(f"Unknown command: {a0}")
        usage()
        raise SystemExit(1)

    if len(args) == 2:
        a0, a1 = args
        a0 = normalize_tool_name(a0)
        # list <provider>
        if a0 == "list":
            if a1 in provider_set or a1 in ("duck", "quotio", "antigravity"):
                return ("list", a1, "")
            err(f"Unknown provider for list: {a1}")
            raise SystemExit(1)
        # check --online / check online
        if a0 == "check" and a1 in ("--online", "online"):
            return ("check-online", "", "")
        if a0 == "probe":
            return ("probe-provider", a1, "")
        if a0 == "doctor":
            return ("doctor-provider", a1, "")
        if a0 == "list" and a1 in ("--online", "online"):
            return ("list-online", "", "")
        # flames openrouter [model] → Codex via Flames NewAPI OpenRouter channels
        if a0 == "flames" and a1 == "openrouter":
            return ("codex", "flames", "@model:" + OPENROUTER_DEFAULT_MODEL)
        # <tool> <provider>
        if a0 in TOOLS_WITH_ALL:
            if a1 not in provider_set:
                err(f"Unknown provider: {a1} (use: {', '.join(providers)})")
                usage()
                raise SystemExit(1)
            return (a0, a1, "")

        err(f"Unknown command: {a0} {a1}")
        usage()
        raise SystemExit(1)

    if len(args) == 3:
        tool, provider, arg3 = args
        # switch-api flames openrouter nemotron → Codex on Flames OpenRouter channels
        if tool == "flames" and provider == "openrouter":
            return ("codex", "flames", "@model:" + arg3)
        tool = normalize_tool_name(tool)
        if tool == "list" and arg3 in ("--online", "online"):
            if provider in provider_set:
                return ("list-online", provider, "")
            err(f"Unknown provider for list: {provider}")
            raise SystemExit(1)
        if tool not in TOOLS_WITH_ALL:
            err(f"Unknown tool: {tool}")
            usage()
            raise SystemExit(1)
        if provider not in provider_set:
            err(f"Unknown provider: {provider} (use: {', '.join(providers)})")
            usage()
            raise SystemExit(1)

        # OpenRouter: Codex/Droid/all treat the third arg as a model or alias.
        # OpenClaw still accepts named free-model profiles.
        if provider == "openrouter" and tool != "openclaw":
            return (tool, provider, "@model:" + arg3)

        # Decide: is arg3 a profile or a model name?
        if not is_model_name(arg3):
            # It's a known profile — validate as before
            if tool == "openclaw" and provider in ("duck", "quotio", "antigravity", "openrouter"):
                profiles = {
                    "duck": OPENCLAW_DUCK_PROFILE_NAMES,
                    "quotio": OPENCLAW_QUOTIO_PROFILE_NAMES,
                    "antigravity": OPENCLAW_ANTIGRAVITY_PROFILE_NAMES,
                    "openrouter": OPENCLAW_OPENROUTER_PROFILE_NAMES,
                }
                if arg3.lower() not in profiles[provider]:
                    err(f"Unknown openclaw {provider} profile: {arg3}")
                    usage()
                    raise SystemExit(1)
                return (tool, provider, arg3)
            elif tool == "droid" and provider == "quotio":
                if arg3.lower() not in DROID_QUOTIO_PROFILE_NAMES:
                    err(f"Unknown droid quotio profile: {arg3} (available: {', '.join(DROID_QUOTIO_PROFILE_NAMES)})")
                    usage()
                    raise SystemExit(1)
                return (tool, provider, arg3)
            else:
                err(f"Profiles only supported for: openclaw|droid <provider> <profile>")
                usage()
                raise SystemExit(1)
        else:
            if tool == "openclaw" and (provider == "openai" or provider in OPENAI_NAMED_PROVIDERS) and arg3 in ("oauth", "key"):
                return (tool, provider, arg3)
            # Model-level switch: return with @model: prefix to distinguish
            return (tool, provider, "@model:" + arg3)

    err("Too many arguments")
    usage()
    raise SystemExit(1)


def main() -> int:
    home = resolve_home()
    os.environ["HOME"] = str(home)
    load_exports_from_shell_rcs(home)

    cfg = Config(home)
    store = load_credential_store(cfg.cred_file)
    store = enrich_store_from_env(store)
    save_credential_store(cfg.cred_file, store)
    custom_store = load_custom_provider_store(cfg.custom_providers_file)
    save_provider_model_catalog(cfg.provider_models_file, custom_store)
    keys = get_keys(store)

    (
        argv_clean,
        force,
        openclaw_agent_id,
        openclaw_all_agents,
        hermes_profile_name,
        hermes_all_profiles,
    ) = parse_global_flags(sys.argv[1:])
    tool, provider, profile = parse_args(argv_clean, known_providers=custom_provider_map(custom_store).keys())

    if (openclaw_agent_id or openclaw_all_agents) and not switch_path_touches_openclaw(tool, provider, custom_store):
        raise SwitchError("--agent/--all-agents 仅适用于会触发 OpenClaw 切换的命令")
    if (hermes_profile_name or hermes_all_profiles) and not switch_path_touches_hermes(tool, provider, custom_store):
        raise SwitchError("--profile/--all-profiles 仅适用于会触发 Hermes 切换的命令")

    if tool == "status":
        show_status(cfg)
        return 0

    if tool == "codex-account-status":
        cmd_codex_account_status(cfg)
        return 0

    if tool == "codex-account-list":
        cmd_codex_account_list(cfg)
        return 0

    if tool == "codex-account-add":
        cmd_codex_account_add(cfg, provider, profile)
        return 0

    if tool == "codex-account-use":
        cmd_codex_account_use(cfg, provider)
        return 0

    if tool == "list":
        cmd_list_models(provider, custom_store, cfg=cfg)
        return 0

    if tool == "list-online":
        cmd_list_models(provider, custom_store, cfg=cfg, store=store, online=True)
        return 0

    if tool == "check":
        cmd_check(cfg, keys, online=False)
        return 0

    if tool == "check-online":
        cmd_check(cfg, keys, online=True)
        return 0

    if tool == "probe-provider":
        cmd_probe_provider(cfg, store, provider, doctor=False)
        return 0

    if tool == "doctor-provider":
        cmd_probe_provider(cfg, store, provider, doctor=True)
        return 0

    if tool == "key-list":
        cmd_key_list(store)
        return 0

    if tool == "key-set":
        cmd_key_set(cfg, store, provider, str(profile))
        return 0

    if tool == "provider-list":
        cmd_provider_list(cfg)
        return 0

    if tool == "provider-sync-models":
        cmd_provider_sync_models(cfg, store, provider)
        return 0

    if tool == "provider-add-openai":
        cmd_provider_add_openai(cfg, profile)
        if resolve_store_secret(store, str(profile.get("env_key") or "")):
            sync_custom_provider_specs(cfg, store, provider_name=provider)
        else:
            save_provider_model_catalog(cfg.provider_models_file, load_custom_provider_store(cfg.custom_providers_file))
        return 0

    if tool == "provider-add-anthropic":
        cmd_provider_add_anthropic(cfg, profile)
        anthropic_cfg = profile.get("anthropic") if isinstance(profile.get("anthropic"), dict) else {}
        if resolve_store_secret(store, str(anthropic_cfg.get("env_key") or "")):
            sync_custom_provider_specs(cfg, store, provider_name=provider)
        else:
            save_provider_model_catalog(cfg.provider_models_file, load_custom_provider_store(cfg.custom_providers_file))
        return 0

    if tool == "provider-export":
        cmd_provider_export(
            cfg,
            store,
            name=provider,
            out_path=str(profile.get("path") or ""),
            include_secrets=bool(profile.get("with_secrets")),
            export_all=False,
        )
        return 0

    if tool == "provider-export-all":
        cmd_provider_export(
            cfg,
            store,
            out_path=str(profile.get("path") or ""),
            include_secrets=bool(profile.get("with_secrets")),
            export_all=True,
        )
        return 0

    if tool == "provider-import":
        cmd_provider_import(cfg, store, provider, replace=bool(profile.get("replace")))
        return 0

    if tool == "provider-remove":
        cmd_provider_remove(cfg, provider)
        save_provider_model_catalog(cfg.provider_models_file, load_custom_provider_store(cfg.custom_providers_file))
        return 0

    if tool == "model-override-list":
        cmd_model_override_list(cfg)
        return 0

    if tool == "model-override-remove":
        cmd_model_override_remove(cfg, provider, str(profile))
        return 0

    if tool == "model-override-add":
        cmd_model_override_add(
            cfg,
            provider,
            str(profile["model"]),
            list(profile["tools"]),
            bool(profile["vision"]),
        )
        return 0

    custom_spec = custom_provider_map(custom_store).get(provider)

    if custom_spec:
        enabled_tools = custom_provider_enabled_tools(custom_spec)
        if tool not in ("all", *TOOLS):
            raise SwitchError(
                f"Custom provider '{provider}' is supported for {', '.join(enabled_tools)}, not {tool}"
            )
        if tool != "all" and tool not in enabled_tools:
            raise SwitchError(
                f"Custom provider '{provider}' is enabled for {', '.join(enabled_tools)}, not {tool}"
            )
        for env_key in custom_provider_required_env_keys(custom_spec, tool):
            if not resolve_store_secret(store, env_key):
                raise SwitchError(
                    f"{env_key} is not set! "
                    f"Run: switch-api key set {env_key} <value>"
                )

    if provider == "quotio" and not keys["quotio"]:
        raise SwitchError("QUOTIO_API_KEY is not set! Edit ~/.env and run: source ~/.zshrc")

    if provider == "antigravity" and not keys["antigravity"]:
        raise SwitchError("ANTIGRAVITY_API_KEY is not set! Edit ~/.env and run: source ~/.zshrc")

    _is_openai = provider == "openai" or provider in OPENAI_NAMED_PROVIDERS
    is_openclaw_openai_oauth = tool == "openclaw" and _is_openai and profile == "oauth"
    is_codex_openai_official = tool == "codex" and provider == "openai"
    is_codex_openai_named = tool == "codex" and provider in OPENAI_NAMED_PROVIDERS
    if _is_openai and tool not in ("codex", "droid", "openclaw", "all"):
        raise SwitchError(f"Provider '{provider}' is only supported for codex/droid, not {tool}")

    if provider == "openai" and not keys["openai"] and not is_openclaw_openai_oauth and not is_codex_openai_official:
        raise SwitchError("OPENAI_API_KEY is not set! Edit ~/.env and run: source ~/.zshrc")

    if provider in OPENAI_NAMED_PROVIDERS and not keys.get(provider, "") and not is_openclaw_openai_oauth:
        tag = provider[7:]
        raise SwitchError(f"OPENAI_{tag.upper()}_API_KEY is not set! Edit ~/.env and run: source ~/.zshrc")

    if provider == "openrouter" and tool not in ("codex", "openclaw", "droid", "all"):
        raise SwitchError(f"Provider 'openrouter' is supported for codex/openclaw/droid, not {tool}")

    if provider == "openrouter" and not keys["openrouter"]:
        raise SwitchError("OPENROUTER_API_KEY is not set! Edit ~/.env and run: source ~/.zshrc")

    if provider == "quotio_local" and tool not in ("codex", "droid", "all"):
        raise SwitchError(f"Provider 'quotio_local' is supported for codex/droid, not {tool}")

    if provider == "quotio_local" and not keys["quotio"]:
        raise SwitchError("QUOTIO_API_KEY is not set! Edit ~/.env and run: source ~/.zshrc")

    if provider == "aiwave" and tool not in ("codex", "droid", "gemini", "openclaw", "hermes", "all"):
        raise SwitchError(f"Provider 'aiwave' is supported for codex/droid/gemini/openclaw/hermes, not {tool}")

    if provider == "aiwave":
        if tool in ("gemini", "openclaw", "hermes") and not resolve_aiwave_gemini_key(keys):
            raise SwitchError(
                f"{AIWAVE_GEMINI_GCP_ENV_KEY}/{AIWAVE_GEMINI_ENV_KEY} is not set! Edit ~/.env and run: source ~/.zshrc"
            )
        if tool in ("codex", "droid") and not keys["aiwave_codex"]:
            raise SwitchError(f"{AIWAVE_CODEX_ENV_KEY} is not set! Edit ~/.env and run: source ~/.zshrc")
        if tool == "all":
            missing = []
            if not keys["aiwave_codex"]:
                missing.append(AIWAVE_CODEX_ENV_KEY)
            if not resolve_aiwave_gemini_key(keys):
                missing.append(f"{AIWAVE_GEMINI_GCP_ENV_KEY}/{AIWAVE_GEMINI_ENV_KEY}")
            if missing:
                raise SwitchError(
                    f"{', '.join(missing)} is not set! Edit ~/.env and run: source ~/.zshrc"
                )

    if provider == "molifang" and tool not in ("codex", "openclaw", "droid", "hermes", "all"):
        raise SwitchError(f"Provider 'molifang' is supported for codex/openclaw/droid/hermes, not {tool}")

    if provider == "molifang" and not keys["molifang"]:
        raise SwitchError(f"{MOLIFANG_ENV_KEY} is not set! Edit ~/.env and run: source ~/.zshrc")

    if provider == "flames" and tool not in ("cc", "codex", "openclaw", "gemini", "hermes", "grok", "all"):
        raise SwitchError(f"Provider 'flames' is supported for cc/codex/openclaw/gemini/hermes/grok, not {tool}")

    if provider == "flames" and not keys["flames"]:
        raise SwitchError("FLAMES_API_KEY is not set! Edit ~/.env and run: source ~/.zshrc")

    if provider == "xai" and tool not in ("grok", "all"):
        raise SwitchError("Provider 'xai' is only supported with Grok")

    if provider == "deepseek" and tool not in ("cc", "codex", "all"):
        raise SwitchError(f"Provider 'deepseek' is supported for cc/codex, not {tool}")

    if provider == "deepseek" and not keys["deepseek"]:
        raise SwitchError("DEEPSEEK_API_KEY is not set! Edit ~/.env and run: source ~/.zshrc")

    if provider == "duck_cc1" and tool not in ("cc",):
        raise SwitchError(f"Provider 'duck_cc1' is CC-only (Claude Code专用 key, 无 codex/GPT 权限), not {tool}")

    if provider == "duck_cc1" and not keys["duck_cc1"]:
        raise SwitchError("DUCK_CC1_API_KEY is not set! Edit ~/.env and run: source ~/.zshrc")

    if provider == "duck_codex2cc" and tool not in ("cc",):
        raise SwitchError(f"Provider 'duck_codex2cc' is CC-only (CodeX→CC 映射 key), not {tool}")

    if provider == "duck_codex2cc" and not keys["duck_codex2cc"]:
        raise SwitchError("DUCK_CODEX2CC_API_KEY is not set! Edit ~/.env and run: source ~/.zshrc")

    if provider == "icodeeasy" and tool not in ("cc", "openclaw", "codex", "gemini", "all"):
        raise SwitchError(f"Provider 'icodeeasy' supports cc/openclaw/codex/gemini, not {tool}")

    if provider == "gemini-balance" and tool != "gemini":
        raise SwitchError("Provider 'gemini-balance' is only supported with tool 'gemini'")
    if provider == "gemini-balance" and not keys["gemini_balance_token"]:
        raise SwitchError("GEMINI_BALANCE_AUTH_TOKEN is not set! Edit ~/.env and run: source ~/.zshrc")

    if provider == "icodeeasy" and not keys["icodeeasy"]:
        raise SwitchError("ICODEEASY_API_KEY is not set! Edit ~/.env and run: source ~/.zshrc")

    # --- Pre-flight connectivity check (skip with --force) ---
    if not force:
        if is_openclaw_openai_oauth:
            info("Pre-flight skipped for OpenClaw OpenAI OAuth (agent-local OAuth credentials decide availability)")
        elif is_codex_openai_official:
            info("Pre-flight skipped for Codex OpenAI 官方模式（auth.json / ChatGPT OAuth 决定可用性）")
        elif is_codex_openai_named:
            info("Pre-flight skipped for Codex flames_newapi key route（本地 config.toml 的 env_key 决定槽位）")
        elif custom_spec is not None:
            info(f"Pre-flight skipped for custom provider {provider}（无内置探测契约）")
        elif provider == "aiwave":
            info("Pre-flight skipped for AI Wave（不同工具走不同 key/protocol 路径）")
        elif provider == "xai":
            info("Pre-flight skipped for xAI official（Grok 本地登录态 / XAI_API_KEY 决定可用性）")
        elif provider == "deepseek":
            info("Pre-flight skipped for DeepSeek（Claude Code uses Anthropic; Codex uses Responses）")
        else:
            reachable, reason = probe_provider(provider, keys)
            if not reachable:
                raise SwitchError(
                    f"Pre-flight FAILED: provider '{provider}' is unreachable — {reason}\n"
                    f"  Switch aborted. All configs preserved.\n"
                    f"  Use --force to skip this check."
                )
            info(f"Pre-flight OK ✓ {provider} is reachable")
    else:
        warn("Pre-flight check skipped (--force)")

    # Detect model-level switch
    model = ""
    if profile.startswith("@model:"):
        model = profile[7:]
        profile = ""
        if provider == "openrouter":
            resolved = resolve_openrouter_model(model)
            if resolved != model:
                info(f"OpenRouter alias {model} -> {resolved}")
            model = resolved
        elif provider == "flames":
            resolved = resolve_openrouter_model(model)
            if resolved != model and (
                resolved in FLAMES_OPENROUTER_MODELS or is_openrouter_free_model(resolved)
            ):
                info(f"Flames OpenRouter alias {model} -> {resolved}")
                model = resolved
        validate_model_for_tool(tool, model, provider, force, custom_provider=custom_spec, cfg=cfg)

    if custom_spec is not None:
        if tool == "cc":
            switch_custom_cc_provider(custom_spec, cfg, store, model=model)
        elif tool == "openclaw":
            switch_custom_openclaw_provider(
                custom_spec,
                cfg,
                store,
                model=model,
                agent_id=openclaw_agent_id,
                all_agents=openclaw_all_agents,
            )
        elif tool == "codex":
            switch_custom_codex_provider(custom_spec, cfg, store, model=model)
        elif tool == "droid":
            switch_custom_droid_provider(custom_spec, cfg, store, model=model)
        elif tool == "hermes":
            switch_custom_hermes_provider(
                custom_spec,
                cfg,
                store,
                model=model,
                profile_name=hermes_profile_name,
                all_profiles=hermes_all_profiles,
            )
        elif tool == "grok":
            switch_custom_grok_provider(custom_spec, cfg, store, model=model)
        elif tool == "all":
            info(
                f"Custom provider {provider} supports "
                + ",".join(custom_spec["tools"])
                + " — switching enabled tools"
            )
            if "cc" in custom_spec["tools"]:
                switch_custom_cc_provider(custom_spec, cfg, store, model=model)
            if "openclaw" in custom_spec["tools"]:
                switch_custom_openclaw_provider(
                    custom_spec,
                    cfg,
                    store,
                    model=model,
                    agent_id=openclaw_agent_id,
                    all_agents=openclaw_all_agents,
                )
            if "codex" in custom_spec["tools"]:
                switch_custom_codex_provider(custom_spec, cfg, store, model=model)
            if "droid" in custom_spec["tools"]:
                switch_custom_droid_provider(custom_spec, cfg, store, model=model)
            if "hermes" in custom_spec["tools"]:
                switch_custom_hermes_provider(
                    custom_spec,
                    cfg,
                    store,
                    model=model,
                    profile_name=hermes_profile_name,
                    all_profiles=hermes_all_profiles,
                )
            if "grok" in custom_spec["tools"]:
                switch_custom_grok_provider(custom_spec, cfg, store, model=model)
        else:
            raise SwitchError(f"Unsupported custom provider tool: {tool}")
    elif tool == "cc":
        switch_cc(provider, cfg, keys, model=model)
    elif tool == "openclaw":
        switch_openclaw(provider, cfg, keys, profile, model=model, agent_id=openclaw_agent_id, all_agents=openclaw_all_agents)
    elif tool == "codex":
        switch_codex(provider, cfg, keys, model=model)
    elif tool == "droid":
        switch_droid(provider, cfg, keys, profile, model=model)
    elif tool == "gemini":
        switch_gemini_cli(provider, cfg, keys, model=model)
    elif tool == "hermes":
        switch_hermes(
            provider,
            cfg,
            keys,
            model=model,
            profile_name=hermes_profile_name,
            all_profiles=hermes_all_profiles,
        )
    elif tool == "grok":
        switch_grok(provider, cfg, keys, model=model)
    elif tool == "all":
        if provider == "openrouter":
            warn("OpenRouter is OpenAI-compatible — skipping cc and gemini (not compatible)")
            switch_openclaw(provider, cfg, keys, "", model=model, agent_id=openclaw_agent_id, all_agents=openclaw_all_agents)
            switch_codex(provider, cfg, keys, model=model)
            switch_droid(provider, cfg, keys, "", model=model)
        elif provider == "openai":
            info("OpenAI: Codex 切官方 OAuth；Droid 切 API key，跳过 cc/gemini")
            switch_codex(provider, cfg, keys, model=model)
            switch_droid(provider, cfg, keys, "", model=model)
        elif provider in OPENAI_NAMED_PROVIDERS:
            info(f"{provider}: Codex 切 flames_newapi key 槽位；Droid 切 OpenAI API key，跳过 cc/gemini")
            switch_codex(provider, cfg, keys, model=model)
            switch_droid(provider, cfg, keys, "", model=model)
        elif provider == "molifang":
            info("Molifang supports OpenAI-compatible tools only — switching openclaw/codex/droid/hermes")
            switch_openclaw(provider, cfg, keys, "", model=model, agent_id=openclaw_agent_id, all_agents=openclaw_all_agents)
            switch_codex(provider, cfg, keys, model=model)
            switch_droid(provider, cfg, keys, "", model=model)
            switch_hermes(
                provider,
                cfg,
                keys,
                model=model,
                profile_name=hermes_profile_name,
                all_profiles=hermes_all_profiles,
            )
        elif provider == "flames":
            info("Flames supports cc/openclaw/codex/gemini/hermes/grok — switching those")
            switch_cc(provider, cfg, keys, model=model)
            switch_openclaw(provider, cfg, keys, "", model=model, agent_id=openclaw_agent_id, all_agents=openclaw_all_agents)
            switch_codex(provider, cfg, keys, model=model)
            switch_gemini_cli(provider, cfg, keys, model=model)
            switch_hermes(
                provider,
                cfg,
                keys,
                model=model,
                profile_name=hermes_profile_name,
                all_profiles=hermes_all_profiles,
            )
            switch_grok(provider, cfg, keys, model=model)
        elif provider == "xai":
            info("xAI official is Grok-only — switching Grok only")
            switch_grok(provider, cfg, keys, model=model)
        elif provider == "deepseek":
            info("DeepSeek supports Claude Code and Codex — switching both")
            switch_cc(provider, cfg, keys, model=model)
            switch_codex(provider, cfg, keys, model=model)
        elif provider == "aiwave":
            info("AI Wave supports openclaw/codex/droid/gemini/hermes — switching those only")
            switch_openclaw(provider, cfg, keys, "", model=model, agent_id=openclaw_agent_id, all_agents=openclaw_all_agents)
            switch_codex(provider, cfg, keys, model=model)
            switch_droid(provider, cfg, keys, "", model=model)
            switch_gemini_cli(provider, cfg, keys, model=model)
            switch_hermes(
                provider,
                cfg,
                keys,
                model=model,
                profile_name=hermes_profile_name,
                all_profiles=hermes_all_profiles,
            )
        elif provider == "quotio_local":
            info(f"Quotio Local only supports codex/droid — switching those only")
            switch_codex(provider, cfg, keys, model=model)
            switch_droid(provider, cfg, keys, "", model=model)
        elif provider == "icodeeasy":
            info("iCodeEasy supports cc/openclaw/codex/gemini — switching those only")
            switch_cc(provider, cfg, keys, model=model)
            switch_openclaw(provider, cfg, keys, "", model=model, agent_id=openclaw_agent_id, all_agents=openclaw_all_agents)
            switch_codex(provider, cfg, keys, model=model)
            switch_gemini_cli(provider, cfg, keys, model=model)
        elif provider in CC_ONLY_PROVIDERS:
            info(f"{provider} is CC-only — switching Claude Code only")
            switch_cc(provider, cfg, keys, model=model)
        else:
            switch_cc(provider, cfg, keys, model=model)
            switch_openclaw(provider, cfg, keys, "", model=model, agent_id=openclaw_agent_id, all_agents=openclaw_all_agents)
            switch_codex(provider, cfg, keys, model=model)
            switch_droid(provider, cfg, keys, "", model=model)
            switch_gemini_cli(provider, cfg, keys, model=model)
    else:
        raise SwitchError(f"Unsupported tool: {tool}")

    # Unified post-switch feedback (useful for Telegram)
    print()
    show_status(cfg)

    # Persist any newly resolved credentials
    save_credential_store(cfg.cred_file, enrich_store_from_env(store))

    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except SwitchError as ex:
        err(str(ex))
        raise SystemExit(1)
