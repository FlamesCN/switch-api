def custom_openai_model_entry(provider_name: str, model_id: str) -> Dict[str, Any]:
    return {
        "id": model_id,
        "name": f"{model_id} ({provider_name})",
        "reasoning": True,
        "input": ["text"],
        "contextWindow": 200000,
        "maxTokens": 32768,
    }


def custom_openai_models_payload(spec: Dict[str, Any], target_model: str) -> Dict[str, Any]:
    payload = {
        "baseUrl": spec["base_url"],
        "api": spec["openclaw_api"],
        "apiKey": "",
        "models": [custom_openai_model_entry(spec["name"], target_model)],
    }
    if spec["openclaw_api"] == "openai-responses":
        payload["authHeader"] = True
    return payload


def custom_openai_models_payload_for_models_json(spec: Dict[str, Any], target_model: str) -> Dict[str, Any]:
    p = custom_openai_models_payload(spec, target_model)
    models = []
    for item in p["models"]:
        it = dict(item)
        it["cost"] = {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0}
        it["api"] = spec["openclaw_api"]
        models.append(it)
    p["models"] = models
    return p


def switch_custom_cc_provider(spec: Dict[str, Any], cfg: Config, store: Dict[str, str], model: str = "") -> None:
    provider_name = spec["name"]
    if skip_redundant_switch("cc", provider_name, cfg, model):
        return
    anthropic_cfg = spec.get("anthropic") if isinstance(spec.get("anthropic"), dict) else None
    if anthropic_cfg is None:
        raise SwitchError(f"Custom provider '{provider_name}' has no anthropic config for Claude Code")

    info(f"Switching Claude Code → {provider_name}")
    backup(cfg.cc_settings)

    data = load_json(cfg.cc_settings)
    env = data.setdefault("env", {})
    if not isinstance(env, dict):
        env = {}
        data["env"] = env

    api_key = ensure_key(
        anthropic_cfg["env_key"],
        resolve_store_secret(store, anthropic_cfg["env_key"]),
        f"required for Claude Code {provider_name}",
    )

    clear_cc_custom_model_env(env)
    clear_cc_model_alias_env(env)
    env["ANTHROPIC_BASE_URL"] = anthropic_cfg["base_url"]
    env["ANTHROPIC_AUTH_TOKEN"] = api_key
    for key, value in sorted((anthropic_cfg.get("extra_env") or {}).items()):
        env[key] = value

    data["model"] = model or anthropic_cfg["default_model"]
    save_json(cfg.cc_settings, data)
    ok(f"Claude Code → {provider_name}")


def restart_openclaw_gateway(home: Path) -> None:
    info("Restarting OpenClaw gateway (systemd)...")

    # Restart via systemctl
    r = subprocess.run(
        ["systemctl", "--user", "restart", "openclaw-gateway"],
        check=False,
        capture_output=True,
        text=True,
    )
    if r.returncode != 0:
        warn(f"systemctl restart failed: {r.stderr.strip()}")

    # Wait for port 18789 to come up
    pid = ""
    for _ in range(30):
        p = subprocess.run(
            ["pgrep", "-f", "openclaw-gateway"],
            check=False,
            capture_output=True,
            text=True,
        )
        s = subprocess.run(
            ["bash", "-c", "ss -ltnp 2>/dev/null | grep ':18789'"],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        if p.returncode == 0 and p.stdout.strip() and s.returncode == 0:
            pid = p.stdout.strip().splitlines()[0]
            break
        time.sleep(1)

    if pid:
        ok(f"OpenClaw gateway restarted (PID {pid})")
    else:
        warn("OpenClaw gateway may not have started — check: sudo systemctl status openclaw")


def _switch_openclaw_single_agent(provider: str, cfg: Config, keys: Dict[str, str], profile: str = "", model: str = "") -> None:
    info(f"Switching OpenClaw[{cfg.oc_agent_id}] → {provider}")

    # --- Snapshot current configs for rollback ---
    _rollback_snapshot: Dict[Path, bytes] = {}
    for _fp in [cfg.oc_config, cfg.oc_models, cfg.oc_auth, cfg.oc_auth_profiles]:
        if _fp.exists():
            _rollback_snapshot[_fp] = _fp.read_bytes()

    # --- OpenClaw / Gemini compatibility warning ---
    if profile and profile.lower() in OPENCLAW_GEMINI_PROFILES:
        warn(
            f"Profile '{profile}' uses a Gemini model as primary. "
            f"OpenClaw tool schema may be incompatible with Gemini (patternProperties). "
            f"If you get HTTP 400 errors, switch back to the default (Codex) profile."
        )

    backup(cfg.oc_config)
    backup(cfg.oc_models)
    backup(cfg.oc_auth)
    backup(cfg.oc_auth_profiles)

    oc = load_json(cfg.oc_config)
    models_json = load_json(cfg.oc_models)

    oc_providers = (oc.setdefault("models", {})).setdefault("providers", {})
    ensure_openclaw_defaults_model_config(oc)
    model_providers = models_json.setdefault("providers", {})
    use_agent_override = len(cfg.oc_agent_ids) > 1 and cfg.oc_agent_id == getattr(cfg, "requested_oc_agent_id", "")
    selected_primary = resolve_openclaw_primary_model(oc, cfg.oc_agent_id)

    if provider == "duck":
        duck_anthropic_key = ensure_key(
            "DUCK_ANTHROPIC_API_KEY", keys["duck_anthropic"], "required for OpenClaw duck Claude"
        )
        duck_gemini_key = ensure_key(
            "DUCK_GEMINI_API_KEY/GEMINI_API_KEY", keys["duck_gemini"], "required for OpenClaw duck Gemini"
        )
        target_primary = ""
        if model:
            family = model_family(model)
            target_provider = "duckcoding-codex" if family == "gpt" else "duckcoding" if family == "gemini" else "duckcoding-claude"
            target_primary = f"{target_provider}/{model}"
            info(f"OpenClaw → {target_primary}")
        else:
            target_primary, reason = resolve_openclaw_duck_profile(profile)
            if reason:
                info(reason)
        set_openclaw_target_primary_model(
            oc, cfg.oc_agent_id, target_primary, use_agent_override=use_agent_override
        )
        selected_primary = target_primary
        info("Duck OpenClaw models: claude-opus-4-6, claude-sonnet-4-6, gemini-3.1-pro-preview, gpt-5.4-xhigh-openai-compact")

        # Claude provider (duckcoding-claude)
        dc = duck_claude_models_payload()
        append_registered_openclaw_model(dc, cfg, provider, model, "openai-completions")
        dc["apiKey"] = duck_anthropic_key
        oc_providers["duckcoding-claude"] = dc

        dcm = duck_claude_models_payload_for_models_json()
        append_registered_openclaw_model(dcm, cfg, provider, model, "openai-completions")
        dcm["apiKey"] = duck_anthropic_key
        model_providers["duckcoding-claude"] = dcm

        # Gemini provider (duckcoding = legacy name for Gemini)
        dg = duck_gemini_models_payload()
        append_registered_openclaw_model(dg, cfg, provider, model, "openai-completions")
        dg["apiKey"] = duck_gemini_key
        oc_providers["duckcoding"] = dg

        dgm = duck_gemini_models_payload_for_models_json()
        append_registered_openclaw_model(dgm, cfg, provider, model, "openai-completions")
        dgm["apiKey"] = duck_gemini_key
        model_providers["duckcoding"] = dgm

        needs_codex = target_primary.startswith("duckcoding-codex/")
        duck_codex_key = keys.get("duck_codex", "")
        if needs_codex or duck_codex_key:
            duck_codex_key = ensure_key(
                "DUCKCODING_API_KEY", duck_codex_key, "required for OpenClaw duck Codex"
            )
            duck_codex_model = target_primary.split("/", 1)[1] if needs_codex else DUCK_OPENCLAW_CODEX_MODEL

            dco = duck_codex_models_payload(duck_codex_model)
            dco["apiKey"] = duck_codex_key
            oc_providers["duckcoding-codex"] = dco

            dcom = duck_codex_models_payload_for_models_json(duck_codex_model)
            dcom["apiKey"] = duck_codex_key
            model_providers["duckcoding-codex"] = dcom

    elif provider == "quotio":
        q_key = ensure_key("QUOTIO_API_KEY", keys["quotio"], "required for OpenClaw quotio")

        if model:
            target_provider = "quotio-gemini" if model_family(model) == "gemini" else "quotio"
            target_primary = f"{target_provider}/{model}"
            set_openclaw_target_primary_model(
                oc, cfg.oc_agent_id, target_primary, use_agent_override=use_agent_override
            )
            selected_primary = target_primary
            info(f"OpenClaw → {target_primary}")
        else:
            target_primary, reason = resolve_openclaw_quotio_profile(profile)
            set_openclaw_target_primary_model(
                oc, cfg.oc_agent_id, target_primary, use_agent_override=use_agent_override
            )
            selected_primary = target_primary
            if reason:
                info(reason)
            info("Quotio OpenClaw primary allowlist: quotio/claude-opus-4-6-thinking, quotio/claude-sonnet-4-6")
            info("Use: switch-api openclaw quotio gemini3  # switch to quotio Gemini 3")

        oq = quotio_openai_models_payload()
        # Add GPT model to provider if specified
        if model and model_family(model) == "gpt":
            oq["models"].append({
                "id": model,
                "name": f"GPT {model} (Quotio)",
                "reasoning": True,
                "input": ["text"],
                "contextWindow": 200000,
                "maxTokens": 32768,
            })
        oq["apiKey"] = q_key
        append_registered_openclaw_model(oq, cfg, provider, model, "openai-completions")
        oc_providers["quotio"] = oq

        qg = quotio_gemini_models_payload()
        append_registered_openclaw_model(qg, cfg, provider, model, "google-generative-ai")
        qg["apiKey"] = q_key
        oc_providers["quotio-gemini"] = qg

        oqm = quotio_openai_models_payload_for_models_json()
        if model and model_family(model) == "gpt":
            oqm["models"].append({
                "id": model,
                "name": f"GPT {model} (Quotio)",
                "reasoning": True,
                "input": ["text"],
                "contextWindow": 200000,
                "maxTokens": 32768,
                "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0},
                "api": "openai-completions",
            })
        oqm["apiKey"] = q_key
        append_registered_openclaw_model(oqm, cfg, provider, model, "openai-completions")
        model_providers["quotio"] = oqm

        qgm = quotio_gemini_models_payload_for_models_json()
        append_registered_openclaw_model(qgm, cfg, provider, model, "google-generative-ai")
        qgm["apiKey"] = q_key
        model_providers["quotio-gemini"] = qgm


    elif provider == "antigravity":
        a_key = ensure_key("ANTIGRAVITY_API_KEY", keys["antigravity"], "required for OpenClaw antigravity")
        if model:
            target_provider = "antigravity-gemini" if model_family(model) == "gemini" else "antigravity"
            target_primary, reason = f"{target_provider}/{model}", ""
        else:
            target_primary, reason = resolve_openclaw_antigravity_profile(profile)
        set_openclaw_target_primary_model(
            oc, cfg.oc_agent_id, target_primary, use_agent_override=use_agent_override
        )
        selected_primary = target_primary
        if reason:
            info(reason)
        info("Antigravity OpenClaw models: claude-opus-4-6-thinking, claude-sonnet-4-6, gemini-3.1-pro-high, ...")

        ao = antigravity_openai_models_payload()
        append_registered_openclaw_model(ao, cfg, provider, model, "openai-completions")
        ao["apiKey"] = a_key
        oc_providers["antigravity"] = ao

        ag = antigravity_gemini_models_payload()
        append_registered_openclaw_model(ag, cfg, provider, model, "google-generative-ai")
        ag["apiKey"] = a_key
        oc_providers["antigravity-gemini"] = ag

        aom = antigravity_openai_models_payload_for_models_json()
        append_registered_openclaw_model(aom, cfg, provider, model, "openai-completions")
        aom["apiKey"] = a_key
        model_providers["antigravity"] = aom

        agm = antigravity_gemini_models_payload_for_models_json()
        append_registered_openclaw_model(agm, cfg, provider, model, "google-generative-ai")
        agm["apiKey"] = a_key
        model_providers["antigravity-gemini"] = agm

    elif provider == "icodeeasy":
        i_key = ensure_key("ICODEEASY_API_KEY", keys["icodeeasy"], "required for OpenClaw icodeeasy")
        target_model = model or ICODEEASY_OPENCLAW_MODEL
        target_primary = f"icodeeasy/{target_model}"
        set_openclaw_target_primary_model(
            oc, cfg.oc_agent_id, target_primary, use_agent_override=use_agent_override
        )
        selected_primary = target_primary
        info("iCodeEasy OpenClaw 仍走 Claude 路由: claude-sonnet-4-6, claude-opus-4-6, claude-haiku-4-5-20251001, ...")

        ic = icodeeasy_models_payload()
        if target_model not in [m["id"] for m in ic["models"]]:
            ic["models"].append(_build_icodeeasy_model_entry(target_model))
        ic["apiKey"] = i_key
        oc_providers["icodeeasy"] = ic

        icm = icodeeasy_models_payload_for_models_json()
        if target_model not in [m["id"] for m in icm["models"]]:
            extra = _build_icodeeasy_model_entry(target_model)
            extra["cost"] = {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0}
            extra["api"] = "anthropic-messages"
            icm["models"].append(extra)
        icm["apiKey"] = i_key
        model_providers["icodeeasy"] = icm

    elif provider == "xingyun":
        x_key = ensure_key("XINGYUN_API_KEY", keys["xingyun"], "required for OpenClaw xingyun")
        target_model = model or "gpt-5.4"
        target_primary = f"xingyun/{target_model}"
        set_openclaw_target_primary_model(
            oc, cfg.oc_agent_id, target_primary, use_agent_override=use_agent_override
        )
        selected_primary = target_primary
        info(f"Xingyun OpenClaw models: gpt-5.4, gpt-5.3-codex, ...")

        xo = xingyun_openai_models_payload()
        # Add custom model if specified
        if model and model not in [m["id"] for m in xo["models"]]:
            xo["models"].append({
                "id": model,
                "name": f"GPT {model} (Xingyun)",
                "reasoning": True,
                "input": ["text"],
                "contextWindow": 200000,
                "maxTokens": 32768,
            })
        xo["apiKey"] = x_key
        oc_providers["xingyun"] = xo

        xom = xingyun_openai_models_payload_for_models_json()
        if model and model not in [m["id"] for m in xom["models"]]:
            xom["models"].append({
                "id": model,
                "name": f"GPT {model} (Xingyun)",
                "reasoning": True,
                "input": ["text"],
                "contextWindow": 200000,
                "maxTokens": 32768,
                "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0},
                "api": "openai-completions",
            })
        xom["apiKey"] = x_key
        model_providers["xingyun"] = xom

    elif provider == "molifang":
        m_key = ensure_key(MOLIFANG_ENV_KEY, keys["molifang"], "required for OpenClaw molifang")
        target_model = model or MOLIFANG_MODEL
        registered_m = target_model in model_override_entries(cfg, provider="molifang", tool="openclaw")
        if target_model not in MOLIFANG_AVAILABLE_MODELS and not registered_m:
            raise SwitchError(f"Molifang only supports {MOLIFANG_MODEL}; requested: {target_model}")
        target_primary = f"molifang/{target_model}"
        set_openclaw_target_primary_model(
            oc, cfg.oc_agent_id, target_primary, use_agent_override=use_agent_override
        )
        selected_primary = target_primary
        info(f"Molifang OpenClaw model: {MOLIFANG_MODEL}")

        mp = molifang_openai_models_payload(target_model)
        mp["apiKey"] = m_key
        oc_providers["molifang"] = mp

        mpm = molifang_openai_models_payload_for_models_json(target_model)
        mpm["apiKey"] = m_key
        model_providers["molifang"] = mpm

    elif provider == "aiwave":
        aw_key = ensure_key(
            f"{AIWAVE_GEMINI_GCP_ENV_KEY}/{AIWAVE_GEMINI_ENV_KEY}",
            resolve_aiwave_gemini_key(keys),
            "required for OpenClaw aiwave Gemini",
        )
        target_model = model or AIWAVE_GEMINI_MODEL
        target_primary = f"aiwave/{target_model}"
        set_openclaw_target_primary_model(
            oc, cfg.oc_agent_id, target_primary, use_agent_override=use_agent_override
        )
        selected_primary = target_primary
        info(
            "AI Wave OpenClaw Gemini models: "
            + ", ".join(AIWAVE_GEMINI_AVAILABLE_MODELS)
        )

        ag = aiwave_gemini_models_payload(target_model)
        ag["apiKey"] = aw_key
        oc_providers["aiwave"] = ag

        agm = aiwave_gemini_models_payload_for_models_json(target_model)
        agm["apiKey"] = aw_key
        model_providers["aiwave"] = agm

    elif provider == "flames":
        flames_key = ensure_key("FLAMES_API_KEY", keys["flames"], "required for OpenClaw flames")
        target_model = model or FLAMES_DEFAULT_MODEL
        target_primary = f"flames/{target_model}"
        set_openclaw_target_primary_model(
            oc, cfg.oc_agent_id, target_primary, use_agent_override=use_agent_override
        )
        selected_primary = target_primary
        info(f"Flames OpenClaw default model: {FLAMES_DEFAULT_MODEL}")

        fp = flames_models_payload(target_model)
        fp["apiKey"] = flames_key
        oc_providers["flames"] = fp

        fpm = flames_models_payload_for_models_json(target_model)
        fpm["apiKey"] = flames_key
        model_providers["flames"] = fpm

    elif provider == "openrouter":
        or_key = ensure_key("OPENROUTER_API_KEY", keys["openrouter"], "required for OpenClaw openrouter")
        resolved_model = resolve_openrouter_model(model) if model else ""
        if resolved_model:
            target_primary, reason = f"openrouter/{resolved_model}", ""
            if not is_openrouter_free_model(resolved_model):
                warn(
                    "This OpenRouter model is paid — it uses account credits, "
                    "not the :free daily quota (50/day, or 1000/day after $10 lifetime credits)."
                )
        else:
            target_primary, reason = resolve_openclaw_openrouter_profile(profile)
        set_openclaw_target_primary_model(
            oc, cfg.oc_agent_id, target_primary, use_agent_override=use_agent_override
        )
        selected_primary = target_primary
        if reason:
            info(reason)
        info(f"OpenRouter default: {OPENROUTER_DEFAULT_MODEL}")

        orp = openrouter_models_payload()
        append_registered_openclaw_model(orp, cfg, provider, resolved_model, "openai-completions")
        orp["apiKey"] = or_key
        oc_providers["openrouter"] = orp

        orm = openrouter_models_payload_for_models_json()
        append_registered_openclaw_model(orm, cfg, provider, resolved_model, "openai-completions")
        orm["apiKey"] = or_key
        model_providers["openrouter"] = orm

    elif provider == "openai" or provider in OPENAI_NAMED_PROVIDERS:
        openai_mode = (profile or "key").strip().lower()
        if openai_mode not in ("key", "oauth"):
            raise SwitchError("OpenClaw openai mode must be 'key' or 'oauth' (example: switch-api openclaw openai oauth)")

        key_slot = provider if provider in OPENAI_NAMED_PROVIDERS else "openai"
        tag = provider[7:] if provider in OPENAI_NAMED_PROVIDERS else ""
        display = f"OpenAI[{tag}]" if tag else "OpenAI"
        gpt_model = model or "gpt-5.3-codex"

        if openai_mode == "oauth":
            oauth_profile_id, oauth_profile = find_openclaw_oauth_profile(cfg)
            if not oauth_profile_id:
                raise SwitchError(
                    f"OpenAI OAuth credentials not found in {cfg.oc_auth_profiles}. "
                    "Run 'openclaw onboard --auth-choice openai-codex' first "
                    "(or '~/.npm-global/bin/openclaw models auth login --provider openai-codex')."
                )

            oc_auth = oc.setdefault("auth", {})
            auth_profiles_cfg = oc_auth.setdefault("profiles", {})
            auth_order_cfg = oc_auth.setdefault("order", {})
            oauth_meta: Dict[str, Any] = {"provider": "openai-codex", "mode": "oauth"}
            email = str(oauth_profile.get("email") or "").strip()
            if email:
                oauth_meta["email"] = email
            auth_profiles_cfg[oauth_profile_id] = oauth_meta
            existing_order = [str(pid) for pid in (auth_order_cfg.get("openai-codex") or []) if str(pid) != oauth_profile_id]
            auth_order_cfg["openai-codex"] = [oauth_profile_id, *existing_order]

            target_primary = f"openai-codex/{gpt_model}"
            set_openclaw_target_primary_model(
                oc, cfg.oc_agent_id, target_primary, use_agent_override=use_agent_override
            )
            selected_primary = target_primary
            info(f"OpenClaw → openai-codex/{gpt_model} (OAuth via {oauth_profile_id})")

            # openai-codex is a built-in OpenClaw OAuth provider. Do not shadow it
            # with a plain openai-completions provider entry, or runtime falls back
            # to API-key resolution and fails with "No API key found".
            oc_providers.pop("openai-codex", None)
            model_providers.pop("openai-codex", None)
        else:
            oa_key = ensure_key(f"{display}_API_KEY", keys[key_slot], f"required for OpenClaw {provider}")

            target_primary = f"openai-direct/{gpt_model}"
            set_openclaw_target_primary_model(
                oc, cfg.oc_agent_id, target_primary, use_agent_override=use_agent_override
            )
            selected_primary = target_primary
            info(f"OpenClaw → openai-direct/{gpt_model} (via Xray proxy, key)")

            # Register openai-direct provider (OpenAI API through local proxy)
            openai_payload = {
                "baseUrl": OPENAI_BASE_URL_V1,
                "api": "openai-completions",
                "apiKey": oa_key,
                "models": [
                    {
                        "id": gpt_model,
                        "name": f"GPT {gpt_model} ({display})",
                        "reasoning": True,
                        "input": ["text"],
                        "contextWindow": 200000,
                        "maxTokens": 32768,
                    }
                ],
            }
            oc_providers["openai-direct"] = openai_payload

            openai_models_payload = dict(openai_payload)
            openai_models_payload["models"] = [
                {
                    **openai_payload["models"][0],
                    "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0},
                    "api": "openai-completions",
                }
            ]
            model_providers["openai-direct"] = openai_models_payload

            # Ensure gateway.env has proxy for api.openai.com
            gw_env = cfg.home / ".openclaw" / "gateway.env"
            if gw_env.exists():
                gw_text = gw_env.read_text(encoding="utf-8")
                if "HTTPS_PROXY" not in gw_text:
                    gw_text += f"\nHTTPS_PROXY={XRAY_PROXY}\nHTTP_PROXY={XRAY_PROXY}\n"
                    write_text(gw_env, gw_text)
                    info(f"Added HTTPS_PROXY={XRAY_PROXY} to gateway.env")
            warn(f"需要 Xray 代理在线 ({XRAY_PROXY})")

    save_json(cfg.oc_config, oc)
    save_json(cfg.oc_models, models_json)

    backup(cfg.oc_auth)
    backup(cfg.oc_auth_profiles)
    auth = load_json(cfg.oc_auth) if cfg.oc_auth.exists() else {}
    auth_profiles = load_json(cfg.oc_auth_profiles) if cfg.oc_auth_profiles.exists() else {}

    profiles = auth_profiles.setdefault("profiles", {})
    last_good = auth_profiles.setdefault("lastGood", {})

    if provider == "duck":
        duck_anthropic_key = ensure_key(
            "DUCK_ANTHROPIC_API_KEY", keys["duck_anthropic"], "required for OpenClaw duck Claude"
        )
        duck_gemini_key = ensure_key(
            "DUCK_GEMINI_API_KEY/GEMINI_API_KEY", keys["duck_gemini"], "required for OpenClaw duck Gemini"
        )
        current_primary_provider = str(selected_primary or "").split("/", 1)[0]
        # Claude auth
        auth["duckcoding-claude"] = {"type": "api_key", "key": duck_anthropic_key}
        profiles["duckcoding-claude:manual"] = {
            "type": "token",
            "provider": "duckcoding-claude",
            "token": duck_anthropic_key,
        }
        last_good["duckcoding-claude"] = "duckcoding-claude:manual"
        # Gemini auth
        auth["duckcoding"] = {"type": "api_key", "key": duck_gemini_key}
        profiles["duckcoding:manual"] = {
            "type": "token",
            "provider": "duckcoding",
            "token": duck_gemini_key,
        }
        last_good["duckcoding"] = "duckcoding:manual"
        duck_codex_key = keys.get("duck_codex", "")
        if current_primary_provider == "duckcoding-codex" or duck_codex_key:
            duck_codex_key = ensure_key(
                "DUCKCODING_API_KEY", duck_codex_key, "required for OpenClaw duck Codex"
            )
            auth["duckcoding-codex"] = {"type": "api_key", "key": duck_codex_key}
            profiles["duckcoding-codex:manual"] = {
                "type": "token",
                "provider": "duckcoding-codex",
                "token": duck_codex_key,
            }
            last_good["duckcoding-codex"] = "duckcoding-codex:manual"
        info("Updated OpenClaw auth store for duckcoding (Claude + Gemini + Codex)")
    elif provider == "quotio":
        q_key = ensure_key("QUOTIO_API_KEY", keys["quotio"], "required for OpenClaw quotio")

        auth["quotio"] = {"type": "api_key", "key": q_key}
        auth["quotio-gemini"] = {"type": "api_key", "key": q_key}

        profiles["quotio:manual"] = {
            "type": "token",
            "provider": "quotio",
            "token": q_key,
        }
        profiles["quotio-gemini:manual"] = {
            "type": "token",
            "provider": "quotio-gemini",
            "token": q_key,
        }

        last_good["quotio"] = "quotio:manual"
        last_good["quotio-gemini"] = "quotio-gemini:manual"

        primary_provider = str(selected_primary or "quotio").split("/", 1)[0]
        if primary_provider in ("quotio", "quotio-gemini"):
            last_good[primary_provider] = f"{primary_provider}:manual"

        info("Updated OpenClaw auth store for quotio (quotio + quotio-gemini)")


    elif provider == "antigravity":
        a_key = ensure_key("ANTIGRAVITY_API_KEY", keys["antigravity"], "required for OpenClaw antigravity")

        auth["antigravity"] = {"type": "api_key", "key": a_key}
        auth["antigravity-gemini"] = {"type": "api_key", "key": a_key}

        profiles["antigravity:manual"] = {
            "type": "token",
            "provider": "antigravity",
            "token": a_key,
        }
        profiles["antigravity-gemini:manual"] = {
            "type": "token",
            "provider": "antigravity-gemini",
            "token": a_key,
        }

        last_good["antigravity"] = "antigravity:manual"
        last_good["antigravity-gemini"] = "antigravity-gemini:manual"

        primary_provider = str(selected_primary or "antigravity").split("/", 1)[0]
        if primary_provider in ("antigravity", "antigravity-gemini"):
            last_good[primary_provider] = f"{primary_provider}:manual"

        info("Updated OpenClaw auth store for antigravity")

    elif provider == "xingyun":
        x_key = ensure_key("XINGYUN_API_KEY", keys["xingyun"], "required for OpenClaw xingyun")

        auth["xingyun"] = {"type": "api_key", "key": x_key}

        profiles["xingyun:manual"] = {
            "type": "token",
            "provider": "xingyun",
            "token": x_key,
        }

        last_good["xingyun"] = "xingyun:manual"

        primary_provider = str(selected_primary or "xingyun").split("/", 1)[0]
        if primary_provider == "xingyun":
            last_good[primary_provider] = f"{primary_provider}:manual"

        info("Updated OpenClaw auth store for xingyun")

    elif provider == "molifang":
        m_key = ensure_key(MOLIFANG_ENV_KEY, keys["molifang"], "required for OpenClaw molifang")

        auth["molifang"] = {"type": "api_key", "key": m_key}

        profiles["molifang:manual"] = {
            "type": "token",
            "provider": "molifang",
            "token": m_key,
        }

        last_good["molifang"] = "molifang:manual"

        primary_provider = str(selected_primary or "molifang").split("/", 1)[0]
        if primary_provider == "molifang":
            last_good[primary_provider] = "molifang:manual"

        info("Updated OpenClaw auth store for molifang")

    elif provider == "aiwave":
        aw_key = ensure_key(
            f"{AIWAVE_GEMINI_GCP_ENV_KEY}/{AIWAVE_GEMINI_ENV_KEY}",
            resolve_aiwave_gemini_key(keys),
            "required for OpenClaw aiwave Gemini",
        )

        auth["aiwave"] = {"type": "api_key", "key": aw_key}

        profiles["aiwave:manual"] = {
            "type": "token",
            "provider": "aiwave",
            "token": aw_key,
        }

        last_good["aiwave"] = "aiwave:manual"

        primary_provider = str(selected_primary or "aiwave").split("/", 1)[0]
        if primary_provider == "aiwave":
            last_good[primary_provider] = "aiwave:manual"

        info("Updated OpenClaw auth store for aiwave")

    elif provider == "flames":
        flames_key = ensure_key("FLAMES_API_KEY", keys["flames"], "required for OpenClaw flames")

        auth["flames"] = {"type": "api_key", "key": flames_key}

        profiles["flames:manual"] = {
            "type": "token",
            "provider": "flames",
            "token": flames_key,
        }

        last_good["flames"] = "flames:manual"

        primary_provider = str(selected_primary or "flames").split("/", 1)[0]
        if primary_provider == "flames":
            last_good[primary_provider] = "flames:manual"

        info("Updated OpenClaw auth store for flames")

    elif provider == "openrouter":
        or_key = ensure_key("OPENROUTER_API_KEY", keys["openrouter"], "required for OpenClaw openrouter")

        auth["openrouter"] = {"type": "api_key", "key": or_key}

        profiles["openrouter:manual"] = {
            "type": "token",
            "provider": "openrouter",
            "token": or_key,
        }

        last_good["openrouter"] = "openrouter:manual"

        info("Updated OpenClaw auth store for openrouter")

    elif provider == "icodeeasy":
        i_key = ensure_key("ICODEEASY_API_KEY", keys["icodeeasy"], "required for OpenClaw icodeeasy")

        auth["icodeeasy"] = {"type": "api_key", "key": i_key}

        profiles["icodeeasy:manual"] = {
            "type": "api_key",
            "provider": "icodeeasy",
            "key": i_key,
        }

        last_good["icodeeasy"] = "icodeeasy:manual"

        primary_provider = str(selected_primary or "icodeeasy").split("/", 1)[0]
        if primary_provider == "icodeeasy":
            last_good[primary_provider] = "icodeeasy:manual"

        info("Updated OpenClaw auth store for icodeeasy")

    elif provider == "openai" or provider in OPENAI_NAMED_PROVIDERS:
        openai_mode = (profile or "key").strip().lower()
        if openai_mode not in ("key", "oauth"):
            raise SwitchError("OpenClaw openai mode must be 'key' or 'oauth'")

        if openai_mode == "oauth":
            oauth_profile_id, _oauth_profile = find_openclaw_oauth_profile(cfg)
            if not oauth_profile_id:
                raise SwitchError(
                    f"OpenAI OAuth credentials not found in {cfg.oc_auth_profiles}. "
                    "Run 'openclaw onboard --auth-choice openai-codex' first "
                    "(or '~/.npm-global/bin/openclaw models auth login --provider openai-codex')."
                )

            last_good["openai-codex"] = oauth_profile_id
            info(f"OpenClaw auth store: keeping OAuth profile {oauth_profile_id}")
        else:
            key_slot = provider if provider in OPENAI_NAMED_PROVIDERS else "openai"
            tag = provider[7:] if provider in OPENAI_NAMED_PROVIDERS else ""
            display = f"OpenAI[{tag}]" if tag else "OpenAI"
            oa_key = ensure_key(f"{display}_API_KEY", keys[key_slot], f"required for OpenClaw {provider}")

            auth["openai-direct"] = {"type": "api_key", "key": oa_key}

            profiles["openai-direct:manual"] = {
                "type": "token",
                "provider": "openai-direct",
                "token": oa_key,
            }

            last_good["openai-direct"] = "openai-direct:manual"

            info(f"Updated OpenClaw auth store for openai-direct ({display})")

    save_json(cfg.oc_auth, auth)
    save_json(cfg.oc_auth_profiles, auth_profiles)

    ok(f"OpenClaw → {provider} (配置已写入，未重启)")


def resolve_openclaw_target_agent_ids(home: Path, agent_id: str = "", all_agents: bool = False) -> List[str]:
    agent_ids = resolve_openclaw_agent_ids(home)
    if all_agents:
        return agent_ids

    requested = agent_id.strip()
    if requested:
        if requested not in agent_ids:
            raise SwitchError(
                f"Unknown OpenClaw agent: {requested} (available: {', '.join(agent_ids)})"
            )
        return [requested]

    if len(agent_ids) > 1:
        return agent_ids

    return [resolve_openclaw_default_agent_id(home)]


def switch_openclaw(
    provider: str,
    cfg: Config,
    keys: Dict[str, str],
    profile: str = "",
    model: str = "",
    agent_id: str = "",
    all_agents: bool = False,
) -> None:
    target_agent_ids = resolve_openclaw_target_agent_ids(cfg.home, agent_id=agent_id, all_agents=all_agents)
    if len(target_agent_ids) > 1:
        info(
            "OpenClaw 多 agent 模式：将同步更新 "
            + ", ".join(target_agent_ids)
            + "；如需只切一个 agent，请使用 --agent <id>"
        )

    for target_agent_id in target_agent_ids:
        agent_cfg = Config(cfg.home)
        configure_openclaw_agent_paths(agent_cfg, target_agent_id)
        agent_cfg.requested_oc_agent_id = agent_id.strip()
        if not agent_cfg.oc_models.exists():
            if agent_id.strip():
                raise SwitchError(f"Config file not found: {agent_cfg.oc_models}")
            warn(f"Skipping stale OpenClaw agent '{target_agent_id}' (missing {agent_cfg.oc_models})")
            continue
        if len(target_agent_ids) == 1 and skip_redundant_switch("openclaw", provider, agent_cfg, model):
            continue
        _switch_openclaw_single_agent(provider, agent_cfg, keys, profile, model=model)


def switch_custom_openclaw_provider(
    spec: Dict[str, Any],
    cfg: Config,
    store: Dict[str, str],
    model: str = "",
    *,
    agent_id: str = "",
    all_agents: bool = False,
) -> None:
    provider_name = spec["name"]
    target_agent_ids = resolve_openclaw_target_agent_ids(cfg.home, agent_id=agent_id, all_agents=all_agents)
    if len(target_agent_ids) > 1:
        info(
            "OpenClaw 多 agent 模式：将同步更新 "
            + ", ".join(target_agent_ids)
            + "；如需只切一个 agent，请使用 --agent <id>"
        )

    api_key = ensure_key(spec["env_key"], resolve_store_secret(store, spec["env_key"]), f"required for OpenClaw {provider_name}")
    target_model = model or spec["default_model"]

    for target_agent_id in target_agent_ids:
        agent_cfg = Config(cfg.home)
        configure_openclaw_agent_paths(agent_cfg, target_agent_id)
        agent_cfg.requested_oc_agent_id = agent_id.strip()
        if not agent_cfg.oc_models.exists():
            if agent_id.strip():
                raise SwitchError(f"Config file not found: {agent_cfg.oc_models}")
            warn(f"Skipping stale OpenClaw agent '{target_agent_id}' (missing {agent_cfg.oc_models})")
            continue
        if len(target_agent_ids) == 1 and skip_redundant_switch("openclaw", provider_name, agent_cfg, model):
            continue

        backup(agent_cfg.oc_config)
        backup(agent_cfg.oc_models)
        backup(agent_cfg.oc_auth)
        backup(agent_cfg.oc_auth_profiles)

        oc = load_json(agent_cfg.oc_config)
        models_json = load_json(agent_cfg.oc_models)
        oc_providers = (oc.setdefault("models", {})).setdefault("providers", {})
        ensure_openclaw_defaults_model_config(oc)
        model_providers = models_json.setdefault("providers", {})
        use_agent_override = len(agent_cfg.oc_agent_ids) > 1 and agent_cfg.oc_agent_id == getattr(agent_cfg, "requested_oc_agent_id", "")
        target_primary = f"{provider_name}/{target_model}"
        set_openclaw_target_primary_model(
            oc, agent_cfg.oc_agent_id, target_primary, use_agent_override=use_agent_override
        )

        payload = custom_openai_models_payload(spec, target_model)
        payload["apiKey"] = api_key
        oc_providers[provider_name] = payload

        payload_models = custom_openai_models_payload_for_models_json(spec, target_model)
        payload_models["apiKey"] = api_key
        model_providers[provider_name] = payload_models

        save_json(agent_cfg.oc_config, oc)
        save_json(agent_cfg.oc_models, models_json)

        auth = load_json(agent_cfg.oc_auth) if agent_cfg.oc_auth.exists() else {}
        auth_profiles = load_json(agent_cfg.oc_auth_profiles) if agent_cfg.oc_auth_profiles.exists() else {}
        profiles = auth_profiles.setdefault("profiles", {})
        last_good = auth_profiles.setdefault("lastGood", {})

        auth[provider_name] = {"type": "api_key", "key": api_key}
        profiles[f"{provider_name}:manual"] = {
            "type": "token",
            "provider": provider_name,
            "token": api_key,
        }
        last_good[provider_name] = f"{provider_name}:manual"

        save_json(agent_cfg.oc_auth, auth)
        save_json(agent_cfg.oc_auth_profiles, auth_profiles)

    ok(f"OpenClaw → {provider_name} (配置已写入，未重启)")


def switch_custom_codex_provider(spec: Dict[str, Any], cfg: Config, store: Dict[str, str], model: str = "") -> None:
    provider_name = spec["name"]
    if skip_redundant_switch("codex", provider_name, cfg, model):
        return
    info(f"Switching Codex → {provider_name}")
    codex_backup(cfg, cfg.cx_config)

    api_key = ensure_key(spec["env_key"], resolve_store_secret(store, spec["env_key"]), f"required for Codex {provider_name}")
    sync_env_key_to_shell_files(cfg, spec["env_key"], api_key)

    target_model = model or spec["default_model"]
    text = read_text(cfg.cx_config)
    text = restore_codex_model_catalog(cfg, text)
    text = set_codex_model_provider(text, provider_name)

    model_match = re.search(r'^\s*model\s*=\s*"([^"]+)"\s*$', text, flags=re.M)
    if model_match:
        text = re.sub(
            r'^\s*model\s*=\s*"[^"]+"\s*$',
            f'model = "{target_model}"',
            text,
            count=1,
            flags=re.M,
        )
    else:
        text = f'model = "{target_model}"\n' + text

    table_name = f"model_providers.{provider_name}"
    text = set_toml_table_string(text, table_name, "name", provider_name)
    text = set_toml_table_string(text, table_name, "base_url", spec["base_url"])
    text = set_toml_table_string(text, table_name, "wire_api", spec["codex_wire_api"])
    text = set_toml_table_string(text, table_name, "env_key", spec["env_key"])
    for feature_name, enabled in sorted((spec.get("codex_features") or {}).items()):
        text = set_toml_table_bool(text, "features", feature_name, enabled)

    write_text(cfg.cx_config, text)
    ok(f"Codex → {provider_name}")


def switch_custom_droid_provider(spec: Dict[str, Any], cfg: Config, store: Dict[str, str], model: str = "") -> None:
    provider_name = spec["name"]
    if skip_redundant_switch("droid", provider_name, cfg, model):
        return
    info(f"Switching Droid → {provider_name}")
    api_key = ensure_key(spec["env_key"], resolve_store_secret(store, spec["env_key"]), f"required for Droid {provider_name}")
    target_model = model or spec["default_model"]
    _write_factory_custom_models(cfg.factory_settings, [
        {
            "model": target_model,
            "displayName": f"{provider_name} {target_model}",
            "baseUrl": spec["base_url"],
            "apiKey": api_key,
            "provider": "openai",
        }
    ])
    ok(f"Droid → {provider_name} / {target_model}")
    info(f"  Written to {cfg.factory_settings}")


def switch_custom_hermes_provider(
    spec: Dict[str, Any],
    cfg: Config,
    store: Dict[str, str],
    model: str = "",
    *,
    profile_name: str = "",
    all_profiles: bool = False,
) -> None:
    provider_name = spec["name"]
    if not profile_name and not all_profiles and skip_redundant_switch("hermes", provider_name, cfg, model):
        return
    info(f"Switching Hermes → {provider_name}")
    api_key = ensure_key(spec["env_key"], resolve_store_secret(store, spec["env_key"]), f"required for Hermes {provider_name}")
    target_model = model or spec["default_model"]
    config_paths = resolve_hermes_config_paths(
        cfg,
        profile_name=profile_name,
        all_profiles=all_profiles,
    )

    for config_path in config_paths:
        backup(config_path)
        data = load_yaml(config_path)
        model_cfg = data.get("model")
        if not isinstance(model_cfg, dict):
            model_cfg = {"default": str(model_cfg or "").strip()} if model_cfg else {}
            data["model"] = model_cfg
        model_cfg["default"] = target_model
        model_cfg["provider"] = f"custom:{provider_name}"
        model_cfg["base_url"] = spec["base_url"]
        model_cfg["api_key"] = api_key
        model_cfg["api_mode"] = spec["hermes_api_mode"]

        custom_entry = _ensure_hermes_custom_provider_entry(data, provider_name, spec["base_url"])
        custom_entry["api_key"] = api_key
        custom_entry["api_mode"] = spec["hermes_api_mode"]
        custom_entry["model"] = target_model

        save_yaml(config_path, data)
        info(f"Updated {config_path}")

    scope = profile_name or ("all-profiles" if all_profiles else "root")
    ok(f"Hermes[{scope}] → {provider_name} / {target_model}")


def switch_custom_grok_provider(spec: Dict[str, Any], cfg: Config, store: Dict[str, str], model: str = "") -> None:
    provider_name = spec["name"]
    api_key = ensure_key(spec["env_key"], resolve_store_secret(store, spec["env_key"]), f"required for Grok {provider_name}")
    target_model = model or spec["default_model"]
    stash_grok_auth_for_relay(cfg)
    text = cfg.grok_config.read_text(encoding="utf-8", errors="ignore") if cfg.grok_config.exists() else ""
    selected = read_toml_table_string(text, "models", "default") or GROK_BUILTIN_DEFAULT_MODEL
    if selected == target_model and skip_redundant_switch("grok", provider_name, cfg, target_model):
        return
    info(f"Switching Grok → {provider_name}")
    sync_shared_shell_env(cfg, {spec["env_key"]: api_key})

    text = remove_switch_api_managed_grok_tables(text)
    table_name = grok_model_table_name(target_model)

    text = set_toml_table_string(text, "models", "default", target_model)
    text = set_toml_table_string(text, table_name, "model", target_model)
    text = set_toml_table_string(text, table_name, "base_url", spec["base_url"])
    text = set_toml_table_string(text, table_name, "name", f"{provider_name} {target_model}")
    text = set_toml_table_string(text, table_name, "description", f"Managed by switch-api ({provider_name})")
    text = set_toml_table_string(
        text,
        table_name,
        "api_backend",
        "responses" if spec["codex_wire_api"] == "responses" else "chat_completions",
    )
    text = set_toml_table_string(text, table_name, "env_key", spec["env_key"])

    if cfg.grok_config.exists():
        backup(cfg.grok_config)
    cfg.grok_config.parent.mkdir(parents=True, exist_ok=True)
    write_text(cfg.grok_config, text)
    ok(f"Grok → {provider_name} / {target_model}")


def switch_grok(provider: str, cfg: Config, keys: Dict[str, str], model: str = "") -> None:
    if provider == "xai":
        restore_grok_auth_for_xai(cfg)
        if skip_redundant_switch("grok", provider, cfg, model):
            return
        info(f"Switching Grok → {provider}")
        if not cfg.grok_auth.exists() and not os.environ.get("XAI_API_KEY", "").strip() and not os.environ.get("GROK_CODE_XAI_API_KEY", "").strip():
            raise SwitchError(
                "Grok 官方直连需要已有登录态 (~/.grok/auth.json) 或 XAI_API_KEY/GROK_CODE_XAI_API_KEY"
            )

        target_model = model or GROK_BUILTIN_DEFAULT_MODEL
        text = cfg.grok_config.read_text(encoding="utf-8", errors="ignore") if cfg.grok_config.exists() else ""
        text = remove_switch_api_managed_grok_tables(text)
        text = set_toml_table_string(text, "models", "default", target_model)
        if cfg.grok_config.exists():
            backup(cfg.grok_config)
        cfg.grok_config.parent.mkdir(parents=True, exist_ok=True)
        write_text(cfg.grok_config, text)
        ok(f"Grok → {provider} / {target_model}")
        return

    if provider != "flames":
        raise SwitchError(f"Grok provider not supported yet: {provider}")

    flames_key = ensure_key("FLAMES_API_KEY", keys["flames"], "required for Grok flames")
    target_model, reason = resolve_flames_grok_model(model, flames_key)
    stash_grok_auth_for_relay(cfg)
    text = cfg.grok_config.read_text(encoding="utf-8", errors="ignore") if cfg.grok_config.exists() else ""
    selected = read_toml_table_string(text, "models", "default") or GROK_BUILTIN_DEFAULT_MODEL
    if selected == target_model and skip_redundant_switch("grok", provider, cfg, target_model):
        return
    info(f"Switching Grok → {provider}")
    sync_shared_shell_env(cfg, {"FLAMES_API_KEY": flames_key})
    if reason:
        info(reason)
    text = remove_switch_api_managed_grok_tables(text)
    table_name = grok_model_table_name(target_model)

    text = set_toml_table_string(text, "models", "default", target_model)
    text = set_toml_table_string(text, table_name, "model", target_model)
    text = set_toml_table_string(text, table_name, "base_url", FLAMES_NEWAPI_BASE_URL_V1)
    text = set_toml_table_string(text, table_name, "name", f"Flames {target_model}")
    text = set_toml_table_string(text, table_name, "description", "Managed by switch-api (Flames NewAPI)")
    text = set_toml_table_string(text, table_name, "api_backend", "responses")
    text = set_toml_table_string(text, table_name, "env_key", "FLAMES_API_KEY")

    if cfg.grok_config.exists():
        backup(cfg.grok_config)
    cfg.grok_config.parent.mkdir(parents=True, exist_ok=True)
    write_text(cfg.grok_config, text)
    ok(f"Grok → {provider} / {target_model}")


def switch_codex(provider: str, cfg: Config, keys: Dict[str, str], model: str = "") -> None:
    if skip_redundant_switch("codex", provider, cfg, model):
        return
    info(f"Switching Codex → {provider}")
    codex_backup(cfg, cfg.cx_config)

    text = read_text(cfg.cx_config)
    text = restore_codex_model_catalog(cfg, text)
    if provider == "openai":
        text = comment_codex_model_provider(text)
        if model:
            text = set_codex_top_level_string(text, "model", model)
        write_text(cfg.cx_config, text)
        ok("Codex → openai")
        info("Codex 已切到 OpenAI 官方模式（auth.json / ChatGPT OAuth）")
        return

    if provider in OPENAI_NAMED_PROVIDERS:
        env_key_name = OPENAI_PROVIDER_ENV_KEYS[provider]
        text = set_codex_model_provider(text, "flames_newapi")
        text = set_codex_provider_env_key(text, "flames_newapi", env_key_name)
        if model:
            text = set_codex_top_level_string(text, "model", model)
        write_text(cfg.cx_config, text)
        ok(f"Codex → {provider}")
        info(f"Codex 通过 flames_newapi 走 key 槽位 {env_key_name}")
        return

    provider_map = {
        "duck": "duckcoding",
        "quotio": "quotio",
        "quotio_local": "quotio-local",
        "antigravity": "antigravity",
        "xingyun": "xingyun",
        "molifang": "molifang",
        "deepseek": "deepseek",
        "icodeeasy": "icodeeasy",
        "flames": "flames_newapi",
        "openrouter": "openrouter",
        "aiwave": "aiwave",
    }
    model_provider = provider_map[provider]
    text = set_codex_model_provider(text, model_provider)
    if model:
        text = set_codex_top_level_string(text, "model", model)

    if provider == "deepseek":
        target_model_d = model or DEEPSEEK_CODEX_DEFAULT_MODEL
        registered = model_override_entries(cfg, provider="deepseek", tool="codex")
        if target_model_d not in DEEPSEEK_CODEX_AVAILABLE_MODELS and target_model_d not in registered:
            raise SwitchError(
                "DeepSeek Codex supports "
                + ", ".join(DEEPSEEK_CODEX_AVAILABLE_MODELS)
                + "; or registered overrides; requested: "
                + target_model_d
            )

        deepseek_key = ensure_key(
            "DEEPSEEK_API_KEY",
            keys.get("deepseek", ""),
            "required for Codex DeepSeek provider",
        )
        sync_env_key_to_shell_files(cfg, "DEEPSEEK_API_KEY", deepseek_key)

        model_match_d = re.search(r'^\s*model\s*=\s*"([^"]+)"\s*$', text, flags=re.M)
        if model_match_d:
            text = re.sub(
                r'^\s*model\s*=\s*"[^"]+"\s*$',
                f'model = "{target_model_d}"',
                text,
                count=1,
                flags=re.M,
            )
        else:
            text = f'model = "{target_model_d}"\n' + text

        table_name = "model_providers.deepseek"
        text = set_toml_table_string(text, table_name, "name", "DeepSeek")
        text = set_toml_table_string(text, table_name, "base_url", DEEPSEEK_CODEX_BASE_URL)
        text = set_toml_table_string(text, table_name, "wire_api", "responses")
        text = set_toml_table_string(text, table_name, "env_key", "DEEPSEEK_API_KEY")
        text = activate_deepseek_codex_catalog(cfg, text)
        info(f"Codex → DeepSeek / {target_model_d} (DEEPSEEK_API_KEY)")

    if provider == "quotio":
        # model safety mapping for known unsupported 4.5-series Claude names
        model_match = re.search(r'^\s*model\s*=\s*"([^"]+)"\s*$', text, flags=re.M)
        current_model = model_match.group(1).strip() if model_match else ""
        target_model = ""

        codex_fallbacks = {
            "claude-haiku-4-5": "claude-sonnet-4-6",
            "claude-haiku-4-5-20251001": "claude-sonnet-4-6",
            "claude-opus-4-5": "claude-opus-4-6-thinking",
            "claude-opus-4-5-20251101-thinking": "claude-opus-4-6-thinking",
        }

        if current_model in codex_fallbacks:
            target_model = codex_fallbacks[current_model]
        else:
            lm = current_model.lower()
            if "haiku-4-5" in lm:
                target_model = "claude-sonnet-4-6"
            elif "opus-4-5" in lm:
                target_model = "claude-opus-4-6-thinking"

        if target_model:
            if model_match:
                text = re.sub(
                    r'^\s*model\s*=\s*"[^"]+"\s*$',
                    f'model = "{target_model}"',
                    text,
                    count=1,
                    flags=re.M,
                )
            else:
                text = f'model = "{target_model}"\n' + text
            warn(f"Codex model {current_model} mapped to {target_model} for quotio")

        # ensure quotio provider block exists
        if not re.search(r"^\[model_providers\.quotio\]\s*$", text, flags=re.M):
            block = (
                "\n\n# Quotio Tunnel (via Cloudflare)\n"
                "[model_providers.quotio]\n"
                'name = "quotio"\n'
                f'base_url = "{QUOTIO_BASE_URL_V1}"\n'
                'wire_api = "responses"\n'
                'env_key = "QUOTIO_API_KEY"\n'
            )
            text += block
            info("Added quotio provider to codex config")

    if provider == "antigravity":
        # same model safety mapping as quotio
        model_match2 = re.search(r'^\s*model\s*=\s*"([^"]+)"\s*$', text, flags=re.M)
        current_model2 = model_match2.group(1).strip() if model_match2 else ""
        target_model2 = ""

        codex_fallbacks2 = {
            "claude-haiku-4-5": "claude-sonnet-4-6",
            "claude-haiku-4-5-20251001": "claude-sonnet-4-6",
            "claude-opus-4-5": "claude-opus-4-6-thinking",
            "claude-opus-4-5-20251101-thinking": "claude-opus-4-6-thinking",
        }

        if current_model2 in codex_fallbacks2:
            target_model2 = codex_fallbacks2[current_model2]
        else:
            lm2 = current_model2.lower()
            if "haiku-4-5" in lm2:
                target_model2 = "claude-sonnet-4-6"
            elif "opus-4-5" in lm2:
                target_model2 = "claude-opus-4-6-thinking"

        if target_model2:
            if model_match2:
                text = re.sub(
                    r'^\s*model\s*=\s*"[^"]+"\s*$',
                    f'model = "{target_model2}"',
                    text,
                    count=1,
                    flags=re.M,
                )
            else:
                text = f'model = "{target_model2}"\n' + text
            warn(f"Codex model {current_model2} mapped to {target_model2} for antigravity")

        if not re.search(r"^\[model_providers\.antigravity\]\s*$", text, flags=re.M):
            block = (
                "\n\n# Antigravity-tools\n"
                "[model_providers.antigravity]\n"
                'name = "antigravity"\n'
                f'base_url = "{ANTIGRAVITY_BASE_URL_V1}"\n'
                'wire_api = "responses"\n'
                'env_key = "ANTIGRAVITY_API_KEY"\n'
            )
            text += block
            info("Added antigravity provider to codex config")

    if provider == "xingyun":
        # xingyun uses GPT models, no model mapping needed
        target_model_x = model or "gpt-5.4"
        
        model_match_x = re.search(r'^\s*model\s*=\s*"([^"]+)"\s*$', text, flags=re.M)
        if model_match_x:
            text = re.sub(
                r'^\s*model\s*=\s*"[^"]+"\s*$',
                f'model = "{target_model_x}"',
                text,
                count=1,
                flags=re.M,
            )
        else:
            text = f'model = "{target_model_x}"\n' + text
        
        if not re.search(r"^\[model_providers\.xingyun\]\s*$", text, flags=re.M):
            block = (
                "\n\n# Xingyun GPT\n"
                "[model_providers.xingyun]\n"
                'name = "xingyun"\n'
                f'base_url = "{XINGYUN_BASE_URL_V1}"\n'
                'wire_api = "responses"\n'
                'env_key = "XINGYUN_API_KEY"\n'
            )
            text += block
            info("Added xingyun provider to codex config")

        xingyun_key = ensure_key(
            "API key (xingyun)",
            keys.get("xingyun", ""),
            "required for Codex xingyun provider",
        )
        update_dotenv_file(cfg.oc_env, {"XINGYUN_API_KEY": xingyun_key})
        info(f"Synced {cfg.oc_env} -> XINGYUN_API_KEY")

    if provider == "molifang":
        molifang_key = ensure_key(MOLIFANG_ENV_KEY, keys.get("molifang", ""), "required for Codex molifang")
        sync_env_key_to_shell_files(cfg, MOLIFANG_ENV_KEY, molifang_key)
        target_model_m = model or MOLIFANG_MODEL
        registered_m = target_model_m in model_override_entries(cfg, provider="molifang", tool="codex")
        if target_model_m not in MOLIFANG_AVAILABLE_MODELS and not registered_m:
            raise SwitchError(f"Molifang only supports {MOLIFANG_MODEL}; requested: {target_model_m}")

        # Molifang currently rejects the Responses image_generation tool for this key/group.
        # Keep Responses wire API (Codex no longer supports chat wire_api), but disable the
        # image generation feature so Codex does not include/request that tool.
        text = set_toml_table_bool(text, "features", "image_generation", False)

        model_match_m = re.search(r'^\s*model\s*=\s*"([^"]+)"\s*$', text, flags=re.M)
        if model_match_m:
            text = re.sub(
                r'^\s*model\s*=\s*"[^"]+"\s*$',
                f'model = "{target_model_m}"',
                text,
                count=1,
                flags=re.M,
            )
        else:
            text = f'model = "{target_model_m}"\n' + text

        if not re.search(r"^\[model_providers\.molifang\]\s*$", text, flags=re.M):
            block = (
                "\n\n# Molifang API (OpenAI-compatible, GPT-5.5 only)\n"
                "[model_providers.molifang]\n"
                'name = "molifang"\n'
                f'base_url = "{MOLIFANG_BASE_URL_V1}"\n'
                'wire_api = "responses"\n'
                f'env_key = "{MOLIFANG_ENV_KEY}"\n'
            )
            text += block
            info("Added molifang provider to codex config")
        info(f"Codex → molifang / {target_model_m} ({MOLIFANG_ENV_KEY})")
        info("Codex image_generation feature disabled for molifang compatibility")
        info(f"Synced {MOLIFANG_ENV_KEY} to ~/.env (shell rc auto-load ensured)")

    if provider == "icodeeasy":
        model_match_i = re.search(r'^\s*model\s*=\s*"([^"]+)"\s*$', text, flags=re.M)
        current_model_i = model_match_i.group(1).strip() if model_match_i else ""
        target_model_i = model or current_model_i
        registered_i = target_model_i in model_override_entries(cfg, provider="icodeeasy", tool="codex")
        if model_family(target_model_i) != "gpt" and not registered_i:
            target_model_i = ICODEEASY_CODEX_MODEL

        if model_match_i:
            text = re.sub(
                r'^\s*model\s*=\s*"[^"]+"\s*$',
                f'model = "{target_model_i}"',
                text,
                count=1,
                flags=re.M,
            )
        else:
            text = f'model = "{target_model_i}"\n' + text

        if not re.search(r"^\[model_providers\.icodeeasy\]\s*$", text, flags=re.M):
            block = (
                "\n\n# iCodeEasy unified gateway\n"
                "[model_providers.icodeeasy]\n"
                'name = "icodeeasy"\n'
                f'base_url = "{ICODEEASY_BASE_URL_V1}"\n'
                'wire_api = "responses"\n'
                'env_key = "ICODEEASY_API_KEY"\n'
            )
            text += block
            info("Added icodeeasy provider to codex config")

        info(f"Codex → iCodeEasy / {target_model_i} (ICODEEASY_API_KEY)")

    if provider == "flames":
        target_model_f = model or FLAMES_CODEX_DEFAULT_MODEL
        resolved_or = resolve_openrouter_model(target_model_f)
        if resolved_or != target_model_f and (
            resolved_or in FLAMES_OPENROUTER_MODELS or is_openrouter_free_model(resolved_or)
        ):
            info(f"Flames OpenRouter alias {target_model_f} -> {resolved_or}")
            target_model_f = resolved_or

        model_match_f = re.search(r'^\s*model\s*=\s*"([^"]+)"\s*$', text, flags=re.M)
        if model_match_f:
            text = re.sub(
                r'^\s*model\s*=\s*"[^"]+"\s*$',
                f'model = "{target_model_f}"',
                text,
                count=1,
                flags=re.M,
            )
        else:
            text = f'model = "{target_model_f}"\n' + text

        if model_family(target_model_f) == "deepseek":
            text = set_toml_table_string(text, "model_providers.flames_newapi", "wire_api", "responses")
        text = set_codex_provider_env_key(text, "flames_newapi", "FLAMES_API_KEY")
        if target_model_f == FLAMES_KIMI_CODEX_MODEL:
            text = activate_flames_kimi_codex_catalog(cfg, text)
        elif (
            model_family(target_model_f) == "deepseek"
            or target_model_f in FLAMES_OPENROUTER_MODELS
            or model_family(target_model_f) == "openrouter"
            or model_override_spec(cfg, "flames", target_model_f) is not None
        ):
            text = activate_flames_codex_catalog(cfg, text)
        info(f"Codex → flames_newapi / {target_model_f} (FLAMES_API_KEY)")

    if provider == "openrouter":
        or_key = ensure_key("OPENROUTER_API_KEY", keys.get("openrouter", ""), "required for Codex openrouter")
        sync_env_key_to_shell_files(cfg, "OPENROUTER_API_KEY", or_key)
        target_model_or = resolve_openrouter_model(model) if model else OPENROUTER_DEFAULT_MODEL
        model_match_or = re.search(r'^\s*model\s*=\s*"([^"]+)"\s*$', text, flags=re.M)
        if model_match_or:
            text = re.sub(
                r'^\s*model\s*=\s*"[^"]+"\s*$',
                f'model = "{target_model_or}"',
                text,
                count=1,
                flags=re.M,
            )
        else:
            text = f'model = "{target_model_or}"\n' + text
        info(f"Codex model set to {target_model_or}")
        if not is_openrouter_free_model(target_model_or):
            warn(
                "This OpenRouter model is paid — it uses account credits, "
                "not the :free daily quota (50/day, or 1000/day after $10 lifetime credits)."
            )

        # ensure openrouter provider block exists
        if not re.search(r"^\[model_providers\.openrouter\]\s*$", text, flags=re.M):
            block = (
                "\n\n# OpenRouter (unified API gateway)\n"
                "[model_providers.openrouter]\n"
                'name = "openrouter"\n'
                f'base_url = "{OPENROUTER_BASE_URL_V1}"\n'
                'wire_api = "responses"\n'
                'env_key = "OPENROUTER_API_KEY"\n'
            )
            text += block
            info("Added openrouter provider to codex config")
        text = activate_openrouter_codex_catalog(cfg, text)

    if provider == "quotio_local":
        if not re.search(r"^\[model_providers\.quotio-local\]\s*$", text, flags=re.M):
            block = (
                "\n\n# Quotio Local (本地 Quotio app 代理)\n"
                "[model_providers.quotio-local]\n"
                'name = "quotio-local"\n'
                f'base_url = "{QUOTIO_LOCAL_BASE_URL_V1}"\n'
                'wire_api = "responses"\n'
                'env_key = "QUOTIO_API_KEY"\n'
            )
            text += block
            info("Added quotio-local provider to codex config")
        info(f"Codex → Quotio Local ({QUOTIO_LOCAL_BASE_URL_V1})")

    if provider == "aiwave":
        # ensure aiwave provider block exists
        if not re.search(r"^\[model_providers\.aiwave\]\s*$", text, flags=re.M):
            block = (
                "\n\n# AI Wave (第三方中转)\n"
                "[model_providers.aiwave]\n"
                'name = "aiwave"\n'
                f'base_url = "{AIWAVE_BASE_URL_V1}"\n'
                'wire_api = "responses"\n'
                f'env_key = "{AIWAVE_CODEX_ENV_KEY}"\n'
            )
            text += block
            info("Added aiwave provider to codex config")
        info(
            f"Codex → AI Wave (OpenAI: {AIWAVE_BASE_URL_V1}, Gemini: {AIWAVE_GEMINI_BASE_URL}, "
            f"env={AIWAVE_CODEX_ENV_KEY})"
        )

    write_text(cfg.cx_config, text)
    ok(f"Codex → {provider}")

def update_bashrc_exports(bashrc: Path, updates: Dict[str, str]) -> None:
    if bashrc.exists():
        lines = bashrc.read_text(encoding="utf-8", errors="ignore").splitlines(keepends=True)
    else:
        lines = []

    for var, value in updates.items():
        pattern = re.compile(rf"^\s*export\s+{re.escape(var)}=")
        indices = [i for i, line in enumerate(lines) if pattern.match(line)]
        new_line = f'export {var}="{value}"\n'

        if indices:
            last = indices[-1]
            lines[last] = new_line
            # remove duplicate earlier exports of same key
            for idx in reversed(indices[:-1]):
                del lines[idx]
        else:
            if lines and not lines[-1].endswith("\n"):
                lines[-1] += "\n"
            if lines and lines[-1].strip() != "":
                lines.append("\n")
            lines.append(new_line)

    content = "".join(lines)
    write_text(bashrc, content)


def update_dotenv_file(env_path: Path, updates: Dict[str, str]) -> None:
    if env_path.exists():
        lines = env_path.read_text(encoding="utf-8", errors="ignore").splitlines(keepends=True)
    else:
        lines = []

    env_path.parent.mkdir(parents=True, exist_ok=True)

    for var, value in updates.items():
        pattern = re.compile(rf"^\s*{re.escape(var)}=")
        indices = [i for i, line in enumerate(lines) if pattern.match(line)]
        new_line = f"{var}={value}\n"

        if indices:
            last = indices[-1]
            lines[last] = new_line
            for idx in reversed(indices[:-1]):
                del lines[idx]
        else:
            if lines and not lines[-1].endswith("\n"):
                lines[-1] += "\n"
            if lines and lines[-1].strip() != "":
                lines.append("\n")
            lines.append(new_line)

    write_text(env_path, "".join(lines))


def update_json_file(path: Path, mutator) -> None:
    data: Dict[str, Any] = {}
    if path.exists():
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
        except (json.JSONDecodeError, OSError):
            data = {}
    updated = mutator(data)
    path.parent.mkdir(parents=True, exist_ok=True)
    write_text(path, json.dumps(updated, indent=2) + "\n")


def _gemini_gateway_model_definitions(provider: str) -> Dict[str, Dict[str, Any]]:
    provider_label = provider.replace("_", "-")
    return {
        "gemini-3.5-flash": {
