def _build_flames_model_entry(model_id: str) -> Dict[str, Any]:
    return {
        "id": model_id,
        "name": f"{model_id} (Flames)",
        "reasoning": True,
        "input": ["text"],
        "contextWindow": 200000,
        "maxTokens": 32768,
    }


def flames_models_payload(target_model: str = FLAMES_DEFAULT_MODEL) -> Dict[str, Any]:
    model_ids = list(FLAMES_AVAILABLE_MODELS)
    if target_model not in model_ids:
        model_ids.append(target_model)
    return {
        "baseUrl": FLAMES_NEWAPI_BASE_URL_V1,
        "api": "openai-completions",
        "apiKey": "",
        "models": [_build_flames_model_entry(model_id) for model_id in model_ids],
    }


def flames_models_payload_for_models_json(target_model: str = FLAMES_DEFAULT_MODEL) -> Dict[str, Any]:
    p = flames_models_payload(target_model)
    models = []
    for item in p["models"]:
        it = dict(item)
        it["cost"] = {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0}
        it["api"] = "openai-completions"
        models.append(it)
    p["models"] = models
    return p


def restart_openclaw_gateway(home: Path) -> None:
    info("Restarting OpenClaw gateway (systemd)...")

    # Restart via systemctl
    r = subprocess.run(
        ["systemctl", "--user", "restart", "openclaw-gateway"],
        check=False,
        capture_output=True,
        text=True,
    )
    if r.returncode != 0:
        warn(f"systemctl restart failed: {r.stderr.strip()}")

    # Wait for port 18789 to come up
    pid = ""
    for _ in range(30):
        p = subprocess.run(
            ["pgrep", "-f", "openclaw-gateway"],
            check=False,
            capture_output=True,
            text=True,
        )
        s = subprocess.run(
            ["bash", "-c", "ss -ltnp 2>/dev/null | grep ':18789'"],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        if p.returncode == 0 and p.stdout.strip() and s.returncode == 0:
            pid = p.stdout.strip().splitlines()[0]
            break
        time.sleep(1)

    if pid:
        ok(f"OpenClaw gateway restarted (PID {pid})")
    else:
        warn("OpenClaw gateway may not have started — check: sudo systemctl status openclaw")


def switch_openclaw(provider: str, cfg: Config, keys: Dict[str, str], profile: str = "", model: str = "") -> None:
    info(f"Switching OpenClaw → {provider}")

    # --- Snapshot current configs for rollback ---
    _rollback_snapshot: Dict[Path, bytes] = {}
    for _fp in [cfg.oc_config, cfg.oc_models, cfg.oc_auth, cfg.oc_auth_profiles]:
        if _fp.exists():
            _rollback_snapshot[_fp] = _fp.read_bytes()

    # --- OpenClaw / Gemini compatibility warning ---
    if profile and profile.lower() in OPENCLAW_GEMINI_PROFILES:
        warn(
            f"Profile '{profile}' uses a Gemini model as primary. "
            f"OpenClaw tool schema may be incompatible with Gemini (patternProperties). "
            f"If you get HTTP 400 errors, switch back to default (Claude) profile."
        )

    backup(cfg.oc_config)
    backup(cfg.oc_models)

    oc = load_json(cfg.oc_config)
    models_json = load_json(cfg.oc_models)

    oc_providers = (oc.setdefault("models", {})).setdefault("providers", {})
    oc_agents = (oc.setdefault("agents", {})).setdefault("defaults", {}).setdefault("model", {})
    model_providers = models_json.setdefault("providers", {})

    if provider == "duck":
        duck_anthropic_key = ensure_key(
            "DUCK_ANTHROPIC_API_KEY", keys["duck_anthropic"], "required for OpenClaw duck Claude"
        )
        duck_gemini_key = ensure_key(
            "DUCK_GEMINI_API_KEY/GEMINI_API_KEY", keys["duck_gemini"], "required for OpenClaw duck Gemini"
        )
        target_primary, reason = resolve_openclaw_duck_profile(profile)
        oc_agents["primary"] = target_primary
        if reason:
            info(reason)
        info("Duck OpenClaw models: claude-opus-4-6, claude-sonnet-4-6, gemini-3.1-pro-preview, ...")

        # Claude provider (duckcoding-claude)
        dc = duck_claude_models_payload()
        dc["apiKey"] = duck_anthropic_key
        oc_providers["duckcoding-claude"] = dc

        dcm = duck_claude_models_payload_for_models_json()
        dcm["apiKey"] = duck_anthropic_key
        model_providers["duckcoding-claude"] = dcm

        # Gemini provider (duckcoding = legacy name for Gemini)
        dg = duck_gemini_models_payload()
        dg["apiKey"] = duck_gemini_key
        oc_providers["duckcoding"] = dg

        dgm = duck_gemini_models_payload_for_models_json()
        dgm["apiKey"] = duck_gemini_key
        model_providers["duckcoding"] = dgm

    elif provider == "quotio":
        q_key = ensure_key("QUOTIO_API_KEY", keys["quotio"], "required for OpenClaw quotio")

        if model and model_family(model) == "gpt":
            # GPT model (e.g. gpt-5.3-codex) → set as quotio primary directly
            oc_agents["primary"] = f"quotio/{model}"
            info(f"OpenClaw → quotio/{model} (GPT via OpenAI-completions)")
        else:
            target_primary, reason = resolve_openclaw_quotio_profile(profile)
            oc_agents["primary"] = target_primary
            if reason:
                info(reason)
            info("Quotio OpenClaw primary allowlist: quotio/claude-opus-4-6-thinking, quotio/claude-sonnet-4-6")
            info("Use: switch-api openclaw quotio gemini3  # switch to quotio Gemini 3")

        oq = quotio_openai_models_payload()
        # Add GPT model to provider if specified
        if model and model_family(model) == "gpt":
            oq["models"].append({
                "id": model,
                "name": f"GPT {model} (Quotio)",
                "reasoning": True,
                "input": ["text"],
                "contextWindow": 200000,
                "maxTokens": 32768,
            })
        oq["apiKey"] = q_key
        oc_providers["quotio"] = oq

        qg = quotio_gemini_models_payload()
        qg["apiKey"] = q_key
        oc_providers["quotio-gemini"] = qg

        oqm = quotio_openai_models_payload_for_models_json()
        if model and model_family(model) == "gpt":
            oqm["models"].append({
                "id": model,
                "name": f"GPT {model} (Quotio)",
                "reasoning": True,
                "input": ["text"],
                "contextWindow": 200000,
                "maxTokens": 32768,
                "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0},
                "api": "openai-completions",
            })
        oqm["apiKey"] = q_key
        model_providers["quotio"] = oqm

        qgm = quotio_gemini_models_payload_for_models_json()
        qgm["apiKey"] = q_key
        model_providers["quotio-gemini"] = qgm


    elif provider == "antigravity":
        a_key = ensure_key("ANTIGRAVITY_API_KEY", keys["antigravity"], "required for OpenClaw antigravity")
        target_primary, reason = resolve_openclaw_antigravity_profile(profile)
        oc_agents["primary"] = target_primary
        if reason:
            info(reason)
        info("Antigravity OpenClaw models: claude-opus-4-6-thinking, claude-sonnet-4-6, gemini-3.1-pro-high, ...")

        ao = antigravity_openai_models_payload()
        ao["apiKey"] = a_key
        oc_providers["antigravity"] = ao

        ag = antigravity_gemini_models_payload()
        ag["apiKey"] = a_key
        oc_providers["antigravity-gemini"] = ag

        aom = antigravity_openai_models_payload_for_models_json()
        aom["apiKey"] = a_key
        model_providers["antigravity"] = aom

        agm = antigravity_gemini_models_payload_for_models_json()
        agm["apiKey"] = a_key
        model_providers["antigravity-gemini"] = agm

    elif provider == "icodeeasy":
        i_key = ensure_key("ICODEEASY_API_KEY", keys["icodeeasy"], "required for OpenClaw icodeeasy")
        target_model = model or "claude-sonnet-4-6"
        oc_agents["primary"] = f"icodeeasy/{target_model}"
        info("iCodeEasy OpenClaw models: claude-sonnet-4-6, claude-opus-4-6, claude-haiku-4-5-20251001, ...")

        ic = icodeeasy_models_payload()
        if target_model not in [m["id"] for m in ic["models"]]:
            ic["models"].append(_build_icodeeasy_model_entry(target_model))
        ic["apiKey"] = i_key
        oc_providers["icodeeasy"] = ic

        icm = icodeeasy_models_payload_for_models_json()
        if target_model not in [m["id"] for m in icm["models"]]:
            extra = _build_icodeeasy_model_entry(target_model)
            extra["cost"] = {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0}
            extra["api"] = "anthropic-messages"
            icm["models"].append(extra)
        icm["apiKey"] = i_key
        model_providers["icodeeasy"] = icm

    elif provider == "xingyun":
        x_key = ensure_key("XINGYUN_API_KEY", keys["xingyun"], "required for OpenClaw xingyun")
        target_model = model or "gpt-5.4"
        oc_agents["primary"] = f"xingyun/{target_model}"
        info(f"Xingyun OpenClaw models: gpt-5.4, gpt-5.3-codex, ...")

        xo = xingyun_openai_models_payload()
        # Add custom model if specified
        if model and model not in [m["id"] for m in xo["models"]]:
            xo["models"].append({
                "id": model,
                "name": f"GPT {model} (Xingyun)",
                "reasoning": True,
                "input": ["text"],
                "contextWindow": 200000,
                "maxTokens": 32768,
            })
        xo["apiKey"] = x_key
        oc_providers["xingyun"] = xo

        xom = xingyun_openai_models_payload_for_models_json()
        if model and model not in [m["id"] for m in xom["models"]]:
            xom["models"].append({
                "id": model,
                "name": f"GPT {model} (Xingyun)",
                "reasoning": True,
                "input": ["text"],
                "contextWindow": 200000,
                "maxTokens": 32768,
                "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0},
                "api": "openai-completions",
            })
        xom["apiKey"] = x_key
        model_providers["xingyun"] = xom

    elif provider == "flames":
        flames_key = ensure_key("FLAMES_API_KEY", keys["flames"], "required for OpenClaw flames")
        target_model = model or FLAMES_DEFAULT_MODEL
        oc_agents["primary"] = f"flames/{target_model}"
        info(f"Flames OpenClaw default model: {FLAMES_DEFAULT_MODEL}")

        fp = flames_models_payload(target_model)
        fp["apiKey"] = flames_key
        oc_providers["flames"] = fp

        fpm = flames_models_payload_for_models_json(target_model)
        fpm["apiKey"] = flames_key
        model_providers["flames"] = fpm

    elif provider == "openrouter":
        or_key = ensure_key("OPENROUTER_API_KEY", keys["openrouter"], "required for OpenClaw openrouter")
        target_primary, reason = resolve_openclaw_openrouter_profile(profile)
        oc_agents["primary"] = target_primary
        if reason:
            info(reason)
        info(f"OpenRouter default: {OPENROUTER_DEFAULT_MODEL} (all free models available)")

        orp = openrouter_models_payload()
        orp["apiKey"] = or_key
        oc_providers["openrouter"] = orp

        orm = openrouter_models_payload_for_models_json()
        orm["apiKey"] = or_key
        model_providers["openrouter"] = orm

    elif provider == "openai" or provider in OPENAI_NAMED_PROVIDERS:
        openai_mode = (profile or "key").strip().lower()
        if openai_mode not in ("key", "oauth"):
            raise SwitchError("OpenClaw openai mode must be 'key' or 'oauth' (example: switch-api openclaw openai oauth)")

        key_slot = provider if provider in OPENAI_NAMED_PROVIDERS else "openai"
        tag = provider[7:] if provider in OPENAI_NAMED_PROVIDERS else ""
        display = f"OpenAI[{tag}]" if tag else "OpenAI"
        gpt_model = model or "gpt-5.3-codex"

        if openai_mode == "oauth":
            oauth_profile_id, oauth_profile = find_openclaw_oauth_profile(cfg)
            if not oauth_profile_id:
                raise SwitchError(
                    "OpenAI OAuth credentials not found in ~/.openclaw/agents/main/agent/auth-profiles.json. "
                    "Run 'openclaw onboard --auth-choice openai-codex' first "
                    "(or '~/.npm-global/bin/openclaw models auth login --provider openai-codex')."
                )

            oc_auth = oc.setdefault("auth", {})
            auth_profiles_cfg = oc_auth.setdefault("profiles", {})
            auth_order_cfg = oc_auth.setdefault("order", {})
            oauth_meta: Dict[str, Any] = {"provider": "openai-codex", "mode": "oauth"}
            email = str(oauth_profile.get("email") or "").strip()
            if email:
                oauth_meta["email"] = email
            auth_profiles_cfg[oauth_profile_id] = oauth_meta
            existing_order = [str(pid) for pid in (auth_order_cfg.get("openai-codex") or []) if str(pid) != oauth_profile_id]
            auth_order_cfg["openai-codex"] = [oauth_profile_id, *existing_order]

            oc_agents["primary"] = f"openai-codex/{gpt_model}"
            info(f"OpenClaw → openai-codex/{gpt_model} (OAuth via {oauth_profile_id})")

            # openai-codex is a built-in OpenClaw OAuth provider. Do not shadow it
            # with a plain openai-completions provider entry, or runtime falls back
            # to API-key resolution and fails with "No API key found".
            oc_providers.pop("openai-codex", None)
            model_providers.pop("openai-codex", None)
        else:
            oa_key = ensure_key(f"{display}_API_KEY", keys[key_slot], f"required for OpenClaw {provider}")

            oc_agents["primary"] = f"openai-direct/{gpt_model}"
            info(f"OpenClaw → openai-direct/{gpt_model} (via Xray proxy, key)")

            # Register openai-direct provider (OpenAI API through local proxy)
            openai_payload = {
                "baseUrl": OPENAI_BASE_URL_V1,
                "api": "openai-completions",
                "apiKey": oa_key,
                "models": [
                    {
                        "id": gpt_model,
                        "name": f"GPT {gpt_model} ({display})",
                        "reasoning": True,
                        "input": ["text"],
                        "contextWindow": 200000,
                        "maxTokens": 32768,
                    }
                ],
            }
            oc_providers["openai-direct"] = openai_payload

            openai_models_payload = dict(openai_payload)
            openai_models_payload["models"] = [
                {
                    **openai_payload["models"][0],
                    "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0},
                    "api": "openai-completions",
                }
            ]
            model_providers["openai-direct"] = openai_models_payload

            # Ensure gateway.env has proxy for api.openai.com
            gw_env = cfg.home / ".openclaw" / "gateway.env"
            if gw_env.exists():
                gw_text = gw_env.read_text(encoding="utf-8")
                if "HTTPS_PROXY" not in gw_text:
                    gw_text += f"\nHTTPS_PROXY={XRAY_PROXY}\nHTTP_PROXY={XRAY_PROXY}\n"
                    write_text(gw_env, gw_text)
                    info(f"Added HTTPS_PROXY={XRAY_PROXY} to gateway.env")
            warn(f"需要 Xray 代理在线 ({XRAY_PROXY})")

    save_json(cfg.oc_config, oc)
    save_json(cfg.oc_models, models_json)

    backup(cfg.oc_auth)
    backup(cfg.oc_auth_profiles)
    auth = load_json(cfg.oc_auth) if cfg.oc_auth.exists() else {}
    auth_profiles = load_json(cfg.oc_auth_profiles) if cfg.oc_auth_profiles.exists() else {}

    profiles = auth_profiles.setdefault("profiles", {})
    last_good = auth_profiles.setdefault("lastGood", {})

    if provider == "duck":
        duck_anthropic_key = ensure_key(
            "DUCK_ANTHROPIC_API_KEY", keys["duck_anthropic"], "required for OpenClaw duck Claude"
        )
        duck_gemini_key = ensure_key(
            "DUCK_GEMINI_API_KEY/GEMINI_API_KEY", keys["duck_gemini"], "required for OpenClaw duck Gemini"
        )
        # Claude auth
        auth["duckcoding-claude"] = {"type": "api_key", "key": duck_anthropic_key}
        profiles["duckcoding-claude:manual"] = {
            "type": "token",
            "provider": "duckcoding-claude",
            "token": duck_anthropic_key,
        }
        last_good["duckcoding-claude"] = "duckcoding-claude:manual"
        # Gemini auth
        auth["duckcoding"] = {"type": "api_key", "key": duck_gemini_key}
        profiles["duckcoding:manual"] = {
            "type": "token",
            "provider": "duckcoding",
            "token": duck_gemini_key,
        }
        last_good["duckcoding"] = "duckcoding:manual"
        info("Updated OpenClaw auth store for duckcoding (Claude + Gemini)")
    elif provider == "quotio":
        q_key = ensure_key("QUOTIO_API_KEY", keys["quotio"], "required for OpenClaw quotio")

        auth["quotio"] = {"type": "api_key", "key": q_key}
        auth["quotio-gemini"] = {"type": "api_key", "key": q_key}

        profiles["quotio:manual"] = {
            "type": "token",
            "provider": "quotio",
            "token": q_key,
        }
        profiles["quotio-gemini:manual"] = {
            "type": "token",
            "provider": "quotio-gemini",
            "token": q_key,
        }

        last_good["quotio"] = "quotio:manual"
        last_good["quotio-gemini"] = "quotio-gemini:manual"

        primary_provider = str(oc_agents.get("primary", "quotio") or "quotio").split("/", 1)[0]
        if primary_provider in ("quotio", "quotio-gemini"):
            last_good[primary_provider] = f"{primary_provider}:manual"

        info("Updated OpenClaw auth store for quotio (quotio + quotio-gemini)")


    elif provider == "antigravity":
        a_key = ensure_key("ANTIGRAVITY_API_KEY", keys["antigravity"], "required for OpenClaw antigravity")

        auth["antigravity"] = {"type": "api_key", "key": a_key}
        auth["antigravity-gemini"] = {"type": "api_key", "key": a_key}

        profiles["antigravity:manual"] = {
            "type": "token",
            "provider": "antigravity",
            "token": a_key,
        }
        profiles["antigravity-gemini:manual"] = {
            "type": "token",
            "provider": "antigravity-gemini",
            "token": a_key,
        }

        last_good["antigravity"] = "antigravity:manual"
        last_good["antigravity-gemini"] = "antigravity-gemini:manual"

        primary_provider = str(oc_agents.get("primary", "antigravity") or "antigravity").split("/", 1)[0]
        if primary_provider in ("antigravity", "antigravity-gemini"):
            last_good[primary_provider] = f"{primary_provider}:manual"

        info("Updated OpenClaw auth store for antigravity")

    elif provider == "xingyun":
        x_key = ensure_key("XINGYUN_API_KEY", keys["xingyun"], "required for OpenClaw xingyun")

        auth["xingyun"] = {"type": "api_key", "key": x_key}

        profiles["xingyun:manual"] = {
            "type": "token",
            "provider": "xingyun",
            "token": x_key,
        }

        last_good["xingyun"] = "xingyun:manual"

        primary_provider = str(oc_agents.get("primary", "xingyun") or "xingyun").split("/", 1)[0]
        if primary_provider == "xingyun":
            last_good[primary_provider] = f"{primary_provider}:manual"

        info("Updated OpenClaw auth store for xingyun")

    elif provider == "flames":
        flames_key = ensure_key("FLAMES_API_KEY", keys["flames"], "required for OpenClaw flames")

        auth["flames"] = {"type": "api_key", "key": flames_key}

        profiles["flames:manual"] = {
            "type": "token",
            "provider": "flames",
            "token": flames_key,
        }

        last_good["flames"] = "flames:manual"

        primary_provider = str(oc_agents.get("primary", "flames") or "flames").split("/", 1)[0]
        if primary_provider == "flames":
            last_good[primary_provider] = "flames:manual"

        info("Updated OpenClaw auth store for flames")

    elif provider == "openrouter":
        or_key = ensure_key("OPENROUTER_API_KEY", keys["openrouter"], "required for OpenClaw openrouter")

        auth["openrouter"] = {"type": "api_key", "key": or_key}

        profiles["openrouter:manual"] = {
            "type": "token",
            "provider": "openrouter",
            "token": or_key,
        }

        last_good["openrouter"] = "openrouter:manual"

        info("Updated OpenClaw auth store for openrouter")

    elif provider == "icodeeasy":
        i_key = ensure_key("ICODEEASY_API_KEY", keys["icodeeasy"], "required for OpenClaw icodeeasy")

        auth["icodeeasy"] = {"type": "api_key", "key": i_key}

        profiles["icodeeasy:manual"] = {
            "type": "api_key",
            "provider": "icodeeasy",
            "key": i_key,
        }

        last_good["icodeeasy"] = "icodeeasy:manual"

        primary_provider = str(oc_agents.get("primary", "icodeeasy") or "icodeeasy").split("/", 1)[0]
        if primary_provider == "icodeeasy":
            last_good[primary_provider] = "icodeeasy:manual"

        info("Updated OpenClaw auth store for icodeeasy")

    elif provider == "openai" or provider in OPENAI_NAMED_PROVIDERS:
        openai_mode = (profile or "key").strip().lower()
        if openai_mode not in ("key", "oauth"):
            raise SwitchError("OpenClaw openai mode must be 'key' or 'oauth'")

        if openai_mode == "oauth":
            oauth_profile_id, _oauth_profile = find_openclaw_oauth_profile(cfg)
            if not oauth_profile_id:
                raise SwitchError(
                    "OpenAI OAuth credentials not found in ~/.openclaw/agents/main/agent/auth-profiles.json. "
                    "Run 'openclaw onboard --auth-choice openai-codex' first "
                    "(or '~/.npm-global/bin/openclaw models auth login --provider openai-codex')."
                )

            last_good["openai-codex"] = oauth_profile_id
            info(f"OpenClaw auth store: keeping OAuth profile {oauth_profile_id}")
        else:
            key_slot = provider if provider in OPENAI_NAMED_PROVIDERS else "openai"
            tag = provider[7:] if provider in OPENAI_NAMED_PROVIDERS else ""
            display = f"OpenAI[{tag}]" if tag else "OpenAI"
            oa_key = ensure_key(f"{display}_API_KEY", keys[key_slot], f"required for OpenClaw {provider}")

            auth["openai-direct"] = {"type": "api_key", "key": oa_key}

            profiles["openai-direct:manual"] = {
                "type": "token",
                "provider": "openai-direct",
                "token": oa_key,
            }

            last_good["openai-direct"] = "openai-direct:manual"

            info(f"Updated OpenClaw auth store for openai-direct ({display})")

    save_json(cfg.oc_auth, auth)
    save_json(cfg.oc_auth_profiles, auth_profiles)

    ok(f"OpenClaw → {provider} (配置已写入，未重启)")


def switch_codex(provider: str, cfg: Config, keys: Dict[str, str], model: str = "") -> None:
    info(f"Switching Codex → {provider}")
    codex_backup(cfg, cfg.cx_config)

    text = read_text(cfg.cx_config)
    if provider == "openai":
        text = comment_codex_model_provider(text)
        write_text(cfg.cx_config, text)
        ok("Codex → openai")
        info("Codex 已切到 OpenAI 官方模式（auth.json / ChatGPT OAuth）")
        return

    if provider in OPENAI_NAMED_PROVIDERS:
        env_key_name = OPENAI_PROVIDER_ENV_KEYS[provider]
        text = set_codex_model_provider(text, "flames_newapi")
        text = set_codex_provider_env_key(text, "flames_newapi", env_key_name)
        write_text(cfg.cx_config, text)
        ok(f"Codex → {provider}")
        info(f"Codex 通过 flames_newapi 走 key 槽位 {env_key_name}")
        return

    provider_map = {
        "duck": "duckcoding",
        "quotio": "quotio",
        "quotio_local": "quotio-local",
        "antigravity": "antigravity",
        "xingyun": "xingyun",
        "flames": "flames_newapi",
        "openrouter": "openrouter",
        "aiwave": "aiwave",
    }
    model_provider = provider_map[provider]
    text = set_codex_model_provider(text, model_provider)

    if provider == "quotio":
        # model safety mapping for known unsupported 4.5-series Claude names
        model_match = re.search(r'^\s*model\s*=\s*"([^"]+)"\s*$', text, flags=re.M)
        current_model = model_match.group(1).strip() if model_match else ""
        target_model = ""

        codex_fallbacks = {
            "claude-haiku-4-5": "claude-sonnet-4-6",
            "claude-haiku-4-5-20251001": "claude-sonnet-4-6",
            "claude-opus-4-5": "claude-opus-4-6-thinking",
            "claude-opus-4-5-20251101-thinking": "claude-opus-4-6-thinking",
        }

        if current_model in codex_fallbacks:
            target_model = codex_fallbacks[current_model]
        else:
            lm = current_model.lower()
            if "haiku-4-5" in lm:
                target_model = "claude-sonnet-4-6"
            elif "opus-4-5" in lm:
                target_model = "claude-opus-4-6-thinking"

        if target_model:
            if model_match:
                text = re.sub(
                    r'^\s*model\s*=\s*"[^"]+"\s*$',
                    f'model = "{target_model}"',
                    text,
                    count=1,
                    flags=re.M,
                )
            else:
                text = f'model = "{target_model}"\n' + text
            warn(f"Codex model {current_model} mapped to {target_model} for quotio")

        # ensure quotio provider block exists
        if not re.search(r"^\[model_providers\.quotio\]\s*$", text, flags=re.M):
            block = (
                "\n\n# Quotio Tunnel (via Cloudflare)\n"
                "[model_providers.quotio]\n"
                'name = "quotio"\n'
                f'base_url = "{QUOTIO_BASE_URL_V1}"\n'
                'wire_api = "responses"\n'
                'env_key = "QUOTIO_API_KEY"\n'
            )
            text += block
            info("Added quotio provider to codex config")

    if provider == "antigravity":
        # same model safety mapping as quotio
        model_match2 = re.search(r'^\s*model\s*=\s*"([^"]+)"\s*$', text, flags=re.M)
        current_model2 = model_match2.group(1).strip() if model_match2 else ""
        target_model2 = ""

        codex_fallbacks2 = {
            "claude-haiku-4-5": "claude-sonnet-4-6",
            "claude-haiku-4-5-20251001": "claude-sonnet-4-6",
            "claude-opus-4-5": "claude-opus-4-6-thinking",
            "claude-opus-4-5-20251101-thinking": "claude-opus-4-6-thinking",
        }

        if current_model2 in codex_fallbacks2:
            target_model2 = codex_fallbacks2[current_model2]
        else:
            lm2 = current_model2.lower()
            if "haiku-4-5" in lm2:
                target_model2 = "claude-sonnet-4-6"
            elif "opus-4-5" in lm2:
                target_model2 = "claude-opus-4-6-thinking"

        if target_model2:
            if model_match2:
                text = re.sub(
                    r'^\s*model\s*=\s*"[^"]+"\s*$',
                    f'model = "{target_model2}"',
                    text,
                    count=1,
                    flags=re.M,
                )
            else:
                text = f'model = "{target_model2}"\n' + text
            warn(f"Codex model {current_model2} mapped to {target_model2} for antigravity")

        if not re.search(r"^\[model_providers\.antigravity\]\s*$", text, flags=re.M):
            block = (
                "\n\n# Antigravity-tools\n"
                "[model_providers.antigravity]\n"
                'name = "antigravity"\n'
                f'base_url = "{ANTIGRAVITY_BASE_URL_V1}"\n'
                'wire_api = "responses"\n'
                'env_key = "ANTIGRAVITY_API_KEY"\n'
            )
            text += block
            info("Added antigravity provider to codex config")

    if provider == "xingyun":
        # xingyun uses GPT models, no model mapping needed
        target_model_x = model or "gpt-5.4"
        
        model_match_x = re.search(r'^\s*model\s*=\s*"([^"]+)"\s*$', text, flags=re.M)
        if model_match_x:
            text = re.sub(
                r'^\s*model\s*=\s*"[^"]+"\s*$',
                f'model = "{target_model_x}"',
                text,
                count=1,
                flags=re.M,
            )
        else:
            text = f'model = "{target_model_x}"\n' + text
        
        if not re.search(r"^\[model_providers\.xingyun\]\s*$", text, flags=re.M):
            block = (
                "\n\n# Xingyun GPT\n"
                "[model_providers.xingyun]\n"
                'name = "xingyun"\n'
                f'base_url = "{XINGYUN_BASE_URL_V1}"\n'
                'wire_api = "responses"\n'
                'env_key = "XINGYUN_API_KEY"\n'
            )
            text += block
            info("Added xingyun provider to codex config")

        xingyun_key = ensure_key(
            "API key (xingyun)",
            keys.get("xingyun", ""),
            "required for Codex xingyun provider",
        )
        update_dotenv_file(cfg.oc_env, {"XINGYUN_API_KEY": xingyun_key})
        info(f"Synced {cfg.oc_env} -> XINGYUN_API_KEY")

    if provider == "flames":
        target_model_f = model or FLAMES_DEFAULT_MODEL

        model_match_f = re.search(r'^\s*model\s*=\s*"([^"]+)"\s*$', text, flags=re.M)
        if model_match_f:
            text = re.sub(
                r'^\s*model\s*=\s*"[^"]+"\s*$',
                f'model = "{target_model_f}"',
                text,
                count=1,
                flags=re.M,
            )
        else:
            text = f'model = "{target_model_f}"\n' + text

        text = set_codex_provider_env_key(text, "flames_newapi", "FLAMES_API_KEY")
        info(f"Codex → flames_newapi / {target_model_f} (FLAMES_API_KEY)")

    if provider == "openrouter":
        # Set default model to step 3.5 flash
        model_match_or = re.search(r'^\s*model\s*=\s*"([^"]+)"\s*$', text, flags=re.M)
        if model_match_or:
            text = re.sub(
                r'^\s*model\s*=\s*"[^"]+"\s*$',
                f'model = "{OPENROUTER_DEFAULT_MODEL}"',
                text,
                count=1,
                flags=re.M,
            )
        else:
            text = f'model = "{OPENROUTER_DEFAULT_MODEL}"\n' + text
        info(f"Codex model set to {OPENROUTER_DEFAULT_MODEL}")

        # ensure openrouter provider block exists
        if not re.search(r"^\[model_providers\.openrouter\]\s*$", text, flags=re.M):
            block = (
                "\n\n# OpenRouter (unified API gateway, free models)\n"
                "[model_providers.openrouter]\n"
                'name = "openrouter"\n'
                f'base_url = "{OPENROUTER_BASE_URL_V1}"\n'
                'wire_api = "responses"\n'
                'env_key = "OPENROUTER_API_KEY"\n'
            )
            text += block
            info("Added openrouter provider to codex config")

    if provider == "quotio_local":
        if not re.search(r"^\[model_providers\.quotio-local\]\s*$", text, flags=re.M):
            block = (
                "\n\n# Quotio Local (本地 Quotio app 代理)\n"
                "[model_providers.quotio-local]\n"
                'name = "quotio-local"\n'
                f'base_url = "{QUOTIO_LOCAL_BASE_URL_V1}"\n'
                'wire_api = "responses"\n'
                'env_key = "QUOTIO_API_KEY"\n'
            )
            text += block
            info("Added quotio-local provider to codex config")
        info(f"Codex → Quotio Local ({QUOTIO_LOCAL_BASE_URL_V1})")

    if provider == "aiwave":
        # ensure aiwave provider block exists
        if not re.search(r"^\[model_providers\.aiwave\]\s*$", text, flags=re.M):
            block = (
                "\n\n# AI Wave (第三方中转)\n"
                "[model_providers.aiwave]\n"
                'name = "aiwave"\n'
                f'base_url = "{AIWAVE_BASE_URL_V1}"\n'
                'wire_api = "responses"\n'
                'env_key = "AIWAVE_API_KEY"\n'
            )
            text += block
            info("Added aiwave provider to codex config")
        info(f"Codex → AI Wave (OpenAI: {AIWAVE_BASE_URL_V1}, Gemini: {AIWAVE_GEMINI_BASE_URL})")

    write_text(cfg.cx_config, text)
    ok(f"Codex → {provider}")

def update_bashrc_exports(bashrc: Path, updates: Dict[str, str]) -> None:
    if bashrc.exists():
        lines = bashrc.read_text(encoding="utf-8", errors="ignore").splitlines(keepends=True)
    else:
        lines = []

    for var, value in updates.items():
        pattern = re.compile(rf"^\s*export\s+{re.escape(var)}=")
        indices = [i for i, line in enumerate(lines) if pattern.match(line)]
        new_line = f'export {var}="{value}"\n'

        if indices:
            last = indices[-1]
            lines[last] = new_line
            # remove duplicate earlier exports of same key
            for idx in reversed(indices[:-1]):
                del lines[idx]
        else:
            if lines and not lines[-1].endswith("\n"):
                lines[-1] += "\n"
            if lines and lines[-1].strip() != "":
                lines.append("\n")
            lines.append(new_line)

    content = "".join(lines)
    write_text(bashrc, content)


def update_dotenv_file(env_path: Path, updates: Dict[str, str]) -> None:
    if env_path.exists():
        lines = env_path.read_text(encoding="utf-8", errors="ignore").splitlines(keepends=True)
    else:
        lines = []

    env_path.parent.mkdir(parents=True, exist_ok=True)

    for var, value in updates.items():
        pattern = re.compile(rf"^\s*{re.escape(var)}=")
        indices = [i for i, line in enumerate(lines) if pattern.match(line)]
        new_line = f"{var}={value}\n"

        if indices:
            last = indices[-1]
            lines[last] = new_line
            for idx in reversed(indices[:-1]):
                del lines[idx]
        else:
            if lines and not lines[-1].endswith("\n"):
                lines[-1] += "\n"
            if lines and lines[-1].strip() != "":
                lines.append("\n")
            lines.append(new_line)

    write_text(env_path, "".join(lines))


def _write_factory_custom_models(settings_path: Path, models: list) -> None:
    """Write customModels to ~/.factory/settings.json, preserving other keys.
    Also updates sessionDefaultSettings.model to auto-select the first custom model."""
    existing: Dict[str, Any] = {}
    if settings_path.exists():
        try:
            existing = json.loads(settings_path.read_text(encoding="utf-8"))
        except (json.JSONDecodeError, OSError):
            pass
    existing["customModels"] = models
    # Auto-set default model to the first custom model
    if models and isinstance(models[0], dict) and models[0].get("displayName"):
        display_name = models[0]["displayName"]
        custom_id = f"custom:{display_name.replace(' ', '-')}-0"
        session_defaults = existing.setdefault("sessionDefaultSettings", {})
        session_defaults["model"] = custom_id
        info(f"  sessionDefaultSettings.model → {custom_id}")
    settings_path.parent.mkdir(parents=True, exist_ok=True)
    write_text(settings_path, json.dumps(existing, indent=2) + "\n")



def _clear_factory_custom_models(settings_path: Path) -> None:
    """Remove customModels from ~/.factory/settings.json if present.
    Also resets sessionDefaultSettings.model if it was a custom model."""
    if not settings_path.exists():
        return
    try:
        existing = json.loads(settings_path.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, OSError):
        return
    changed = False
    if "customModels" in existing:
        del existing["customModels"]
        changed = True
    # Reset custom model default
    session_defaults = existing.get("sessionDefaultSettings", {})
    if isinstance(session_defaults, dict) and str(session_defaults.get("model", "")).startswith("custom:"):
        del session_defaults["model"]
        changed = True
    if changed:
        write_text(settings_path, json.dumps(existing, indent=2) + "\n")


def update_gemini_cli_env(provider: str, cfg: Config, keys: Dict[str, str]) -> None:
    """Keep ~/.gemini/.env in sync with the current provider.
    Ensures GOOGLE_GEMINI_BASE_URL points to the same provider as GEMINI_API_KEY in .bashrc."""
    key_slot = GEMINI_CLI_KEY_MAP.get(provider)
    if not key_slot:
        return
    api_key = keys.get(key_slot, "")
    if not api_key:
        warn(f"No API key for Gemini CLI ({provider}), skipping .gemini/.env update")
        return
    base_url = GEMINI_CLI_BASE_URLS.get(provider, DUCK_BASE_URL)
    model = GEMINI_CLI_MODELS.get(provider, "gemini-3.1-pro-preview")
    backup(cfg.gemini_env)
    cfg.gemini_env.parent.mkdir(parents=True, exist_ok=True)
    content = (
        f"GOOGLE_GEMINI_BASE_URL={base_url}\n"
        f"GEMINI_API_KEY={api_key}\n"
        f"GEMINI_MODEL={model}\n"
    )
    write_text(cfg.gemini_env, content)
    info(f"Synced ~/.gemini/.env → {provider} (GOOGLE_GEMINI_BASE_URL={base_url}, model={model})")


def switch_gemini_cli(provider: str, cfg: Config, keys: Dict[str, str], model: str = "") -> None:
    """Switch Gemini CLI to a different provider.
    Also updates .bashrc GEMINI_API_KEY (shared with Droid)."""
    info(f"Switching Gemini CLI → {provider}")
    key_slot = GEMINI_CLI_KEY_MAP.get(provider)
    if not key_slot:
        raise SwitchError(f"No Gemini CLI key mapping for provider: {provider}")
    api_key = ensure_key(f"API key ({key_slot})", keys.get(key_slot, ""), f"required for Gemini CLI {provider}")

    update_gemini_cli_env(provider, cfg, keys)

    # Also update .bashrc GEMINI_API_KEY since it takes precedence over .env
    update_bashrc_exports(cfg.bashrc, {"GEMINI_API_KEY": api_key})
    os.environ["GEMINI_API_KEY"] = api_key
    warn("GEMINI_API_KEY in .bashrc updated — this also affects Droid")
    ok(f"Gemini CLI → {provider} (run 'source ~/.bashrc' to apply)")


def switch_droid(provider: str, cfg: Config, keys: Dict[str, str], profile: str = "", model: str = "") -> None:
    p = profile.lower() if profile else "default"
    info(f"Switching Droid → {provider}" + (f" (profile: {p})" if p != "default" else ""))

    if provider == "duck":
        _clear_factory_custom_models(cfg.factory_settings)
        d_key = ensure_key(
            "DUCK_GEMINI_API_KEY/GEMINI_API_KEY", keys["duck_gemini"], "required for Droid duck"
        )
        update_bashrc_exports(
            cfg.bashrc,
            {
                "GEMINI_BASE_URL": DUCK_BASE_URL_V1,
                "GEMINI_API_KEY": d_key,
                "GEMINI_MODEL": DUCK_DROID_MODEL,
            },
        )
        os.environ["GEMINI_BASE_URL"] = DUCK_BASE_URL_V1
        os.environ["GEMINI_API_KEY"] = d_key
        os.environ["GEMINI_MODEL"] = DUCK_DROID_MODEL
        ok(f"Droid → duck / {DUCK_DROID_MODEL} (run 'source ~/.bashrc' to apply)")
        update_gemini_cli_env(provider, cfg, keys)

    elif provider == "quotio":
        q_key = ensure_key("QUOTIO_API_KEY", keys["quotio"], "required for Droid quotio")

        if model:
            # Explicit model (e.g. gpt-5.3-codex) → customModels, same as quotio_local
            droid_model = model
            _write_factory_custom_models(cfg.factory_settings, [
                {
                    "model": droid_model,
                    "displayName": f"Quotio {droid_model}",
                    "baseUrl": QUOTIO_BASE_URL_V1,
                    "apiKey": q_key,
                    "provider": "openai",
                }
            ])
            ok(f"Droid → quotio / {droid_model}")
            info(f"  Written to {cfg.factory_settings}")
            info(f'  In Droid: /model → select "Quotio {droid_model}" under Custom Models')
        else:
            mode, droid_model = DROID_QUOTIO_PROFILE_TO_MODEL.get(p, ("gemini", QUOTIO_DROID_MODEL))

            if mode == "codex":
                # Codex profile → write to ~/.factory/settings.json customModels
                _write_factory_custom_models(cfg.factory_settings, [
                    {
                        "model": droid_model,
                        "displayName": f"Quotio {droid_model}",
                        "baseUrl": QUOTIO_BASE_URL_V1,
                        "apiKey": q_key,
                        "provider": "openai",
                    }
                ])
                ok(f"Droid → quotio codex / {droid_model}")
                info(f"  Written to {cfg.factory_settings}")
                info(f'  In Droid: /model → select "Quotio {droid_model}" under Custom Models')
                info(f'  Or: droid exec --model "custom:Quotio-{droid_model}-0" "prompt"')
            else:
                # Gemini mode → env vars (existing behavior)
                _clear_factory_custom_models(cfg.factory_settings)
                update_bashrc_exports(
                    cfg.bashrc,
                    {
                        "GEMINI_BASE_URL": QUOTIO_BASE_URL_V1,
                        "GEMINI_API_KEY": q_key,
                        "GEMINI_MODEL": droid_model,
                    },
                )
                os.environ["GEMINI_BASE_URL"] = QUOTIO_BASE_URL_V1
                os.environ["GEMINI_API_KEY"] = q_key
                os.environ["GEMINI_MODEL"] = droid_model
                ok(f"Droid → quotio / {droid_model} (run 'source ~/.bashrc' to apply)")
                update_gemini_cli_env(provider, cfg, keys)

    elif provider == "antigravity":
        _clear_factory_custom_models(cfg.factory_settings)
        a_key = ensure_key("ANTIGRAVITY_API_KEY", keys["antigravity"], "required for Droid antigravity")
        update_bashrc_exports(
            cfg.bashrc,
            {
                "GEMINI_BASE_URL": ANTIGRAVITY_BASE_URL_V1BETA,
                "GEMINI_API_KEY": a_key,
                "GEMINI_MODEL": ANTIGRAVITY_DROID_MODEL,
            },
        )
        os.environ["GEMINI_BASE_URL"] = ANTIGRAVITY_BASE_URL_V1BETA
        os.environ["GEMINI_API_KEY"] = a_key
        os.environ["GEMINI_MODEL"] = ANTIGRAVITY_DROID_MODEL
        ok(f"Droid → antigravity / {ANTIGRAVITY_DROID_MODEL} (run 'source ~/.bashrc' to apply)")
        update_gemini_cli_env(provider, cfg, keys)

    elif provider == "xingyun":
        x_key = ensure_key("XINGYUN_API_KEY", keys["xingyun"], "required for Droid xingyun")
        droid_model = model or XINGYUN_DROID_MODEL
        _write_factory_custom_models(cfg.factory_settings, [
            {
                "model": droid_model,
                "displayName": f"Xingyun {droid_model}",
                "baseUrl": XINGYUN_BASE_URL_V1,
                "apiKey": x_key,
                "provider": "openai",
            }
        ])
        ok(f"Droid → xingyun / {droid_model}")
        info(f"  Written to {cfg.factory_settings}")
        info(f"  In Droid: /model → select \"Xingyun {droid_model}\" under Custom Models")

    elif provider == "openrouter":
        or_key = ensure_key("OPENROUTER_API_KEY", keys["openrouter"], "required for Droid openrouter")
        _write_factory_custom_models(cfg.factory_settings, [
            {
                "model": OPENROUTER_DEFAULT_MODEL,
                "displayName": f"OpenRouter {OPENROUTER_DEFAULT_MODEL}",
                "baseUrl": OPENROUTER_BASE_URL_V1,
                "apiKey": or_key,
                "provider": "openai",
            }
        ])
        ok(f"Droid → openrouter / {OPENROUTER_DEFAULT_MODEL}")
        info(f"  Written to {cfg.factory_settings}")
        info(f"  In Droid: /model → select \"OpenRouter {OPENROUTER_DEFAULT_MODEL}\" under Custom Models")

    elif provider == "quotio_local":
        q_key = ensure_key("QUOTIO_API_KEY", keys["quotio"], "required for Droid quotio_local")
        droid_model = model or QUOTIO_LOCAL_DROID_MODEL
        _write_factory_custom_models(cfg.factory_settings, [
            {
                "model": droid_model,
                "displayName": f"Quotio-Local {droid_model}",
                "baseUrl": QUOTIO_LOCAL_BASE_URL_V1,
                "apiKey": q_key,
                "provider": "openai",
            }
        ])
        ok(f"Droid → quotio_local / {droid_model}")
        info(f"  Written to {cfg.factory_settings}")
        info(f"  In Droid: /model → select \"Quotio-Local {droid_model}\" under Custom Models")

    elif provider == "aiwave":
        aw_key = ensure_key("AIWAVE_API_KEY", keys["aiwave"], "required for Droid aiwave")
        droid_model = model or AIWAVE_DROID_CODEX_MODEL
        _write_factory_custom_models(cfg.factory_settings, [
            {
                "model": droid_model,
                "displayName": f"AI Wave {droid_model}",
                "baseUrl": AIWAVE_BASE_URL_V1,
                "apiKey": aw_key,
                "provider": "openai",
            }
        ])
        ok(f"Droid → aiwave codex / {droid_model}")
        info(f"  Written to {cfg.factory_settings}")
        info(f"  In Droid: /model → select \"AI Wave {droid_model}\" under Custom Models")

    elif provider == "openai" or provider in OPENAI_NAMED_PROVIDERS:
        key_slot = provider if provider in OPENAI_NAMED_PROVIDERS else "openai"
        tag = provider[7:] if provider in OPENAI_NAMED_PROVIDERS else ""
        display = f"OpenAI[{tag}]" if tag else "OpenAI"
        oa_key = ensure_key(f"{display}_API_KEY", keys[key_slot], f"required for Droid {provider}")
        droid_model = model or "gpt-5.3-codex"
        _write_factory_custom_models(cfg.factory_settings, [
            {
                "model": droid_model,
                "displayName": f"{display} {droid_model}",
                "baseUrl": OPENAI_BASE_URL_V1,
                "apiKey": oa_key,
                "provider": "openai",
            }
        ])
        ok(f"Droid → {provider} / {droid_model}")
        info(f"  Written to {cfg.factory_settings}")
        info(f"  In Droid: /model → select \"{display} {droid_model}\" under Custom Models")
        warn(f"需要 HTTPS_PROXY 走代理 ({XRAY_PROXY})")


# ----------------------------- cli -----------------------------
def usage() -> None:
    print("Usage:")
    print("  switch-api status")
    print("  switch-api codex-account status")
    print("  switch-api codex-account list")
    print("  switch-api codex-account add <name> [path|@current]")
    print("  switch-api codex-account use <name>")
    print("  switch-api <provider>")
    print("  switch-api all <provider>")
    print("  switch-api <tool> <provider>")
    print("  switch-api openclaw quotio <profile>")
    print("  switch-api openclaw antigravity <profile>")
    print("")
    print("Categories:")
    print("  1) status:")
    print("       switch-api status")
    print("       switch-api codex-account status")
    print("       switch-api codex-account list")
    print("  2) full switch:")
    print("       switch-api duck")
    print("       switch-api quotio")
    print("       switch-api all duck")
    print("       switch-api all quotio")
    print("  2.5) Codex 官方账号切换:")
    print("       switch-api codex-account add main @current")
    print("       switch-api codex-account add alt")
    print("       switch-api codex-account use alt")
    print("  3) single tool switch:")
    print("       switch-api cc duck")
    print("       switch-api openclaw quotio")
    print("       switch-api openclaw quotio gemini3")
    print("       switch-api openclaw antigravity")
    print("       switch-api openclaw antigravity gemini3")
    print("       switch-api codex duck")
    print("       switch-api codex flames")
    print("       switch-api openclaw flames")
    print("       switch-api codex openai")
    print("       switch-api openclaw openai oauth   # OpenClaw 切到 OpenAI OAuth")
    print("       switch-api openclaw openai key     # OpenClaw 切到 OpenAI API Key")
    print("       switch-api droid quotio")
    print("       switch-api droid quotio codex")
    print("")
    print(f"  tool:     {' | '.join(TOOLS_WITH_ALL)}")
    print(f"  provider: {' | '.join(PROVIDERS)}")
    print()
    print("  4) OpenRouter (free models):")
    print("       switch-api openrouter              # all → OpenRouter (free)")
    print("       switch-api codex openrouter")
    print("       switch-api openclaw openrouter")
    print("       switch-api openclaw openrouter llama")
    print("       switch-api droid openrouter")
    print()
    print("  5) Quotio Local (本地 Quotio app, 127.0.0.1:8317):")
    print("       switch-api droid quotio_local")
    print("       switch-api codex quotio_local")
    print("       switch-api quotio_local          # codex+droid")
    print()
    print("  6) OpenAI / Codex 官方账号:")
    print("       switch-api codex openai         # Codex → OpenAI 官方 OAuth（auth.json）")
    print("       switch-api codex-account list   # 列出 accounts/auth.json_* 与已注册目录")
    print("       switch-api codex-account use <name>  # 切换 accounts/auth.json_<name>")
    print("       switch-api droid openai_Gq80    # Droid → OpenAI[Gq80]")
    print("       switch-api codex openai_V420    # Codex → flames_newapi[V420]")
    print("       switch-api openai_Gq80          # codex+droid 切到 key 槽位 Gq80")
    print()
    print("  6.5) Flames NewAPI (OpenAI-compatible relay):")
    print("       switch-api flames              # openclaw+codex → Flames")
    print("       switch-api codex flames        # Codex → flames_newapi + FLAMES_API_KEY")
    print("       switch-api openclaw flames     # OpenClaw → flames/gpt-5.4")
    print()
    print("  7) iCodeEasy (Anthropic 原生 API, CC + OpenClaw):")
    print("       switch-api cc icodeeasy          # Claude Code → iCodeEasy")
    print("       switch-api openclaw icodeeasy    # OpenClaw → Claude Sonnet 4.6")
    print()
    print("  8) Duck CodeX→CC (GPT codex 模型通过 CC 使用):")
    print("       switch-api cc duck_codex2cc      # CC → Duck CodeX (opus→xhigh, sonnet→high)")
    print()
    print("  switch-api list [provider]             # 列出可用模型")
    print("  switch-api check [--online]            # 检查当前模型状态")
    print("  switch-api codex-account use <name>    # 切换 accounts/auth.json_* 或官方账号目录")
    print("  switch-api <tool> <provider> <model>   # 指定模型切换")


def parse_args(argv: Iterable[str]) -> Tuple[str, str, str]:
    """Returns (action, provider, profile_or_model).
    action can be: status, check, check-online, list, list-<provider>,
                   or a tool name (cc/openclaw/codex/droid/gemini/all).
    """
    args = list(argv)

    if not args:
        usage()
        raise SystemExit(1)

    if args[0] == "codex-account":
        if len(args) == 2 and args[1] in ("status", "list"):
            return (f"codex-account-{args[1]}", "", "")
        if len(args) == 3 and args[1] == "use":
            return ("codex-account-use", args[2], "")
        if len(args) == 3 and args[1] == "add":
            return ("codex-account-add", args[2], "")
        if len(args) == 4 and args[1] == "add":
            return ("codex-account-add", args[2], args[3])
        err("Usage: switch-api codex-account <status|list|add|use> ...")
        usage()
        raise SystemExit(1)

    if len(args) == 1:
        a0 = args[0]
        if a0 in ("-h", "--help", "help"):
            usage()
            raise SystemExit(0)
        if a0 in ("-v", "--version", "version"):
            print(APP_VERSION)
            raise SystemExit(0)
        if a0 == "status":
            return ("status", "", "")
        if a0 == "check":
            return ("check", "", "")
        if a0 == "list":
            return ("list", "", "")
        if a0 in PROVIDERS:
            return ("all", a0, "")

        err(f"Unknown command: {a0}")
        usage()
        raise SystemExit(1)

    if len(args) == 2:
        a0, a1 = args
        # list <provider>
        if a0 == "list":
            if a1 in PROVIDERS or a1 in ("duck", "quotio", "antigravity"):
                return ("list", a1, "")
            err(f"Unknown provider for list: {a1}")
            raise SystemExit(1)
        # check --online / check online
        if a0 == "check" and a1 in ("--online", "online"):
            return ("check-online", "", "")
        # <tool> <provider>
        if a0 in TOOLS_WITH_ALL:
            if a1 not in PROVIDERS:
                err(f"Unknown provider: {a1} (use: {', '.join(PROVIDERS)})")
                usage()
                raise SystemExit(1)
            return (a0, a1, "")

        err(f"Unknown command: {a0} {a1}")
        usage()
        raise SystemExit(1)

    if len(args) == 3:
        tool, provider, arg3 = args
        if tool not in TOOLS_WITH_ALL:
            err(f"Unknown tool: {tool}")
            usage()
            raise SystemExit(1)
        if provider not in PROVIDERS:
            err(f"Unknown provider: {provider} (use: {', '.join(PROVIDERS)})")
            usage()
            raise SystemExit(1)

        # Decide: is arg3 a profile or a model name?
        if not is_model_name(arg3):
            # It's a known profile — validate as before
            if tool == "openclaw" and provider in ("duck", "quotio", "antigravity", "openrouter"):
                profiles = {
                    "duck": OPENCLAW_DUCK_PROFILE_NAMES,
                    "quotio": OPENCLAW_QUOTIO_PROFILE_NAMES,
                    "antigravity": OPENCLAW_ANTIGRAVITY_PROFILE_NAMES,
                    "openrouter": OPENCLAW_OPENROUTER_PROFILE_NAMES,
                }
                if arg3.lower() not in profiles[provider]:
                    err(f"Unknown openclaw {provider} profile: {arg3}")
                    usage()
                    raise SystemExit(1)
                return (tool, provider, arg3)
            elif tool == "droid" and provider == "quotio":
                if arg3.lower() not in DROID_QUOTIO_PROFILE_NAMES:
                    err(f"Unknown droid quotio profile: {arg3} (available: {', '.join(DROID_QUOTIO_PROFILE_NAMES)})")
                    usage()
                    raise SystemExit(1)
                return (tool, provider, arg3)
            else:
                err(f"Profiles only supported for: openclaw|droid <provider> <profile>")
                usage()
                raise SystemExit(1)
        else:
            if tool == "openclaw" and (provider == "openai" or provider in OPENAI_NAMED_PROVIDERS) and arg3 in ("oauth", "key"):
                return (tool, provider, arg3)
            # Model-level switch: return with @model: prefix to distinguish
            return (tool, provider, "@model:" + arg3)

    err("Too many arguments")
    usage()
    raise SystemExit(1)


def main() -> int:
    home = resolve_home()
    os.environ["HOME"] = str(home)
    load_exports_from_shell_rcs(home)

    cfg = Config(home)
    store = load_credential_store(cfg.cred_file)
    store = enrich_store_from_env(store)
    save_credential_store(cfg.cred_file, store)
    save_provider_model_catalog(cfg.provider_models_file)
    keys = get_keys(store)

    force = "--force" in sys.argv
    argv_clean = [a for a in sys.argv[1:] if a != "--force"]
    tool, provider, profile = parse_args(argv_clean)

    if tool == "status":
        show_status(cfg)
        return 0

    if tool == "codex-account-status":
        cmd_codex_account_status(cfg)
        return 0

    if tool == "codex-account-list":
        cmd_codex_account_list(cfg)
        return 0

    if tool == "codex-account-add":
        cmd_codex_account_add(cfg, provider, profile)
        return 0

    if tool == "codex-account-use":
        cmd_codex_account_use(cfg, provider)
        return 0

    if tool == "list":
        cmd_list_models(provider)
        return 0

    if tool == "check":
        cmd_check(cfg, keys, online=False)
        return 0

    if tool == "check-online":
        cmd_check(cfg, keys, online=True)
        return 0

    if provider == "quotio" and not keys["quotio"]:
        raise SwitchError("QUOTIO_API_KEY is not set! Edit ~/.bashrc and run: source ~/.bashrc")

    if provider == "antigravity" and not keys["antigravity"]:
        raise SwitchError("ANTIGRAVITY_API_KEY is not set! Edit ~/.bashrc and run: source ~/.bashrc")

    _is_openai = provider == "openai" or provider in OPENAI_NAMED_PROVIDERS
    is_openclaw_openai_oauth = tool == "openclaw" and _is_openai and profile == "oauth"
    is_codex_openai_official = tool == "codex" and provider == "openai"
    is_codex_openai_named = tool == "codex" and provider in OPENAI_NAMED_PROVIDERS
    if _is_openai and tool not in ("codex", "droid", "openclaw", "all"):
        raise SwitchError(f"Provider '{provider}' is only supported for codex/droid, not {tool}")

    if provider == "openai" and not keys["openai"] and not is_openclaw_openai_oauth and not is_codex_openai_official:
        raise SwitchError("OPENAI_API_KEY is not set! Edit ~/.env and run: source ~/.zshrc")

    if provider in OPENAI_NAMED_PROVIDERS and not keys.get(provider, "") and not is_openclaw_openai_oauth:
        tag = provider[7:]
        raise SwitchError(f"OPENAI_{tag.upper()}_API_KEY is not set! Edit ~/.env and run: source ~/.zshrc")

    if provider == "openrouter" and tool not in ("codex", "openclaw", "droid", "all"):
        raise SwitchError(f"Provider 'openrouter' is supported for codex/openclaw/droid, not {tool}")

    if provider == "openrouter" and not keys["openrouter"]:
        raise SwitchError("OPENROUTER_API_KEY is not set! Edit ~/.bashrc and run: source ~/.bashrc")

    if provider == "quotio_local" and tool not in ("codex", "droid", "all"):
        raise SwitchError(f"Provider 'quotio_local' is supported for codex/droid, not {tool}")

    if provider == "quotio_local" and not keys["quotio"]:
        raise SwitchError("QUOTIO_API_KEY is not set! Edit ~/.env and run: source ~/.zshrc")

    if provider == "aiwave" and tool not in ("codex", "droid", "gemini"):
        raise SwitchError(f"Provider 'aiwave' is supported for codex/droid/gemini, not {tool}")

    if provider == "aiwave" and not keys["aiwave"]:
        raise SwitchError("AIWAVE_API_KEY is not set! Edit ~/.env and run: source ~/.zshrc")

    if provider == "flames" and tool not in ("codex", "openclaw", "all"):
        raise SwitchError(f"Provider 'flames' is supported for codex/openclaw, not {tool}")

    if provider == "flames" and not keys["flames"]:
        raise SwitchError("FLAMES_API_KEY is not set! Edit ~/.env and run: source ~/.zshrc")

    if provider == "duck_cc1" and tool not in ("cc",):
        raise SwitchError(f"Provider 'duck_cc1' is CC-only (Claude Code专用 key, 无 codex/GPT 权限), not {tool}")

    if provider == "duck_cc1" and not keys["duck_cc1"]:
        raise SwitchError("DUCK_CC1_API_KEY is not set! Edit ~/.env and run: source ~/.zshrc")

    if provider == "duck_codex2cc" and tool not in ("cc",):
        raise SwitchError(f"Provider 'duck_codex2cc' is CC-only (CodeX→CC 映射 key), not {tool}")

    if provider == "duck_codex2cc" and not keys["duck_codex2cc"]:
        raise SwitchError("DUCK_CODEX2CC_API_KEY is not set! Edit ~/.env and run: source ~/.zshrc")

    if provider == "icodeeasy" and tool not in ("cc", "openclaw", "all"):
        raise SwitchError(f"Provider 'icodeeasy' only supports cc/openclaw (Anthropic 原生 API), not {tool}")

    if provider == "icodeeasy" and not keys["icodeeasy"]:
        raise SwitchError("ICODEEASY_API_KEY is not set! Edit ~/.env and run: source ~/.zshrc")

    # --- Pre-flight connectivity check (skip with --force) ---
    if not force:
        if is_openclaw_openai_oauth:
            info("Pre-flight skipped for OpenClaw OpenAI OAuth (agent-local OAuth credentials decide availability)")
        elif is_codex_openai_official:
            info("Pre-flight skipped for Codex OpenAI 官方模式（auth.json / ChatGPT OAuth 决定可用性）")
        elif is_codex_openai_named:
            info("Pre-flight skipped for Codex flames_newapi key route（本地 config.toml 的 env_key 决定槽位）")
        else:
            reachable, reason = probe_provider(provider, keys)
            if not reachable:
                raise SwitchError(
                    f"Pre-flight FAILED: provider '{provider}' is unreachable — {reason}\n"
                    f"  Switch aborted. All configs preserved.\n"
                    f"  Use --force to skip this check."
                )
            info(f"Pre-flight OK ✓ {provider} is reachable")
    else:
        warn("Pre-flight check skipped (--force)")

    # Detect model-level switch
    model = ""
    if profile.startswith("@model:"):
        model = profile[7:]
        profile = ""
        validate_model_for_tool(tool, model, provider, force)

    if tool == "cc":
        switch_cc(provider, cfg, keys, model=model)
    elif tool == "openclaw":
        switch_openclaw(provider, cfg, keys, profile, model=model)
    elif tool == "codex":
        switch_codex(provider, cfg, keys, model=model)
    elif tool == "droid":
        switch_droid(provider, cfg, keys, profile, model=model)
    elif tool == "gemini":
        switch_gemini_cli(provider, cfg, keys, model=model)
    elif tool == "all":
        if provider == "openrouter":
            warn("OpenRouter is OpenAI-compatible — skipping cc and gemini (not compatible)")
            switch_openclaw(provider, cfg, keys, "", model=model)
            switch_codex(provider, cfg, keys, model=model)
            switch_droid(provider, cfg, keys, "", model=model)
        elif provider == "openai":
            info("OpenAI: Codex 切官方 OAuth；Droid 切 API key，跳过 cc/gemini")
            switch_codex(provider, cfg, keys, model=model)
            switch_droid(provider, cfg, keys, "", model=model)
        elif provider in OPENAI_NAMED_PROVIDERS:
            info(f"{provider}: Codex 切 flames_newapi key 槽位；Droid 切 OpenAI API key，跳过 cc/gemini")
            switch_codex(provider, cfg, keys, model=model)
            switch_droid(provider, cfg, keys, "", model=model)
        elif provider == "flames":
            info("Flames only supports openclaw/codex — switching those only")
            switch_openclaw(provider, cfg, keys, "", model=model)
            switch_codex(provider, cfg, keys, model=model)
        elif provider == "quotio_local":
            info(f"Quotio Local only supports codex/droid — switching those only")
            switch_codex(provider, cfg, keys, model=model)
            switch_droid(provider, cfg, keys, "", model=model)
        elif provider == "icodeeasy":
            info("iCodeEasy supports cc/openclaw only — switching those only")
            switch_cc(provider, cfg, keys, model=model)
            switch_openclaw(provider, cfg, keys, "", model=model)
        elif provider in CC_ONLY_PROVIDERS:
            info(f"{provider} is CC-only — switching Claude Code only")
            switch_cc(provider, cfg, keys, model=model)
        else:
            switch_cc(provider, cfg, keys, model=model)
            switch_openclaw(provider, cfg, keys, "", model=model)
            switch_codex(provider, cfg, keys, model=model)
            switch_droid(provider, cfg, keys, "", model=model)
            switch_gemini_cli(provider, cfg, keys, model=model)
    else:
        raise SwitchError(f"Unsupported tool: {tool}")

    # Unified post-switch feedback (useful for Telegram)
    print()
    show_status(cfg)

    # Persist any newly resolved credentials
    save_credential_store(cfg.cred_file, enrich_store_from_env(store))

    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except SwitchError as ex:
        err(str(ex))
        raise SystemExit(1)
