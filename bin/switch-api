def load_openclaw_auth_store(cfg: Config) -> Dict[str, Any]:
    if not cfg.oc_auth_profiles.exists():
        return {}
    try:
        return load_json(cfg.oc_auth_profiles)
    except Exception:
        return {}


def find_openclaw_oauth_profile(cfg: Config) -> Tuple[str, Dict[str, Any]]:
    store = load_openclaw_auth_store(cfg)
    profiles = (store.get("profiles") or {})
    for profile_id, profile in profiles.items():
        if not isinstance(profile, dict):
            continue
        if profile.get("provider") != "openai-codex":
            continue
        if profile.get("type") != "oauth" and profile.get("mode") != "oauth":
            continue
        if not (profile.get("access") or profile.get("refresh")):
            continue
        return str(profile_id), profile
    return "", {}


def detect_openclaw_openai_mode(cfg: Config) -> str:
    """Return oauth/key when OpenClaw is on an OpenAI route, else empty string."""
    if not cfg.oc_config.exists():
        return ""
    try:
        data = load_json(cfg.oc_config)
    except Exception:
        return ""

    model = resolve_openclaw_primary_model(data, cfg.oc_agent_id)
    oauth_profile_id, _oauth_profile = find_openclaw_oauth_profile(cfg)

    if model.startswith("openai-codex/"):
        return "oauth" if oauth_profile_id else "oauth-missing-auth"
    if model.startswith("openai-direct/"):
        return "key"

    if oauth_profile_id:
        return "oauth-available"
    return ""


def load_custom_providers_for_cfg(cfg: Config) -> Dict[str, Any]:
    try:
        return custom_provider_map(load_custom_provider_store(cfg.custom_providers_file))
    except Exception:
        return {}


def find_custom_provider_by_base_url(
    base_url: str,
    providers: Dict[str, Any],
    *,
    protocol: str = "",
) -> str:
    value = (base_url or "").strip()
    if not value:
        return ""
    try:
        target = normalize_base_url(value)
    except SwitchError:
        return ""
    for name, spec in providers.items():
        candidates: List[str] = []
        if protocol in ("", "openai"):
            openai_cfg = spec.get("openai") if isinstance(spec.get("openai"), dict) else None
            if openai_cfg and openai_cfg.get("base_url"):
                candidates.append(str(openai_cfg["base_url"]))
        if protocol in ("", "anthropic"):
            anthropic_cfg = spec.get("anthropic") if isinstance(spec.get("anthropic"), dict) else None
            if anthropic_cfg and anthropic_cfg.get("base_url"):
                candidates.append(str(anthropic_cfg["base_url"]))
        if not candidates and spec.get("base_url"):
            candidates.append(str(spec["base_url"]))
        for candidate in candidates:
            try:
                if normalize_base_url(candidate) == target:
                    return name
            except SwitchError:
                continue
    return ""


# ----------------------------- status -----------------------------
def detect_provider(tool: str, cfg: Config) -> str:
    custom_providers = load_custom_providers_for_cfg(cfg)
    if tool == "cc":
        if not cfg.cc_settings.exists():
            return "no-config"
        data = load_json(cfg.cc_settings)
        url = ((data.get("env") or {}).get("ANTHROPIC_BASE_URL") or "").strip()
        if "api.deepseek.com" in url:
            return "deepseek"
        if "flamescn.vip" in url:
            return "flames"
        if "tools.ancientechoes" in url:
            return "antigravity"
        if "ancientechoes" in url:
            return "quotio"
        if "icodeeasy" in url:
            return "icodeeasy"
        if "duckcoding" in url:
            # Distinguish duck vs duck_cc1 vs duck_codex2cc by checking the key against credential store
            cc_key = ((data.get("env") or {}).get("ANTHROPIC_AUTH_TOKEN") or "").strip()
            cred_path = cfg.switch_dir / "credentials.json"
            cred_store = load_credential_store(cred_path) if cred_path.exists() else {}
            duck_cc1_key = os.environ.get("DUCK_CC1_API_KEY") or cred_store.get("duck_cc1", "")
            if duck_cc1_key and cc_key == duck_cc1_key:
                return "duck_cc1"
            duck_codex2cc_key = os.environ.get("DUCK_CODEX2CC_API_KEY") or cred_store.get("duck_codex2cc", "")
            if duck_codex2cc_key and cc_key == duck_codex2cc_key:
                return "duck_codex2cc"
            return "duck"
        if "openrouter.ai" in url:
            return "openrouter"
        custom_name = find_custom_provider_by_base_url(url, custom_providers, protocol="anthropic")
        if custom_name and "cc" in custom_provider_enabled_tools(custom_providers[custom_name]):
            return custom_name
        return f"unknown({url})" if url else "unknown"

    if tool == "openclaw":
        if not cfg.oc_config.exists():
            return "no-config"
        data = load_json(cfg.oc_config)
        model = resolve_openclaw_primary_model(data, cfg.oc_agent_id)
        if model.startswith("antigravity/") or model.startswith("antigravity-gemini/"):
            return "antigravity"
        if model.startswith("quotio/") or model.startswith("quotio-gemini/"):
            return "quotio"
        if model.startswith("aiwave/"):
            return "aiwave"
        if model.startswith("duckcoding/") or model.startswith("duckcoding-claude/") or model.startswith("duckcoding-codex/"):
            return "duck"
        if model.startswith("icodeeasy/"):
            return "icodeeasy"
        if model.startswith("xingyun/"):
            return "xingyun"
        if model.startswith("molifang/"):
            return "molifang"
        if model.startswith("flames/"):
            return "flames"
        if model.startswith("openrouter/"):
            return "openrouter"
        if model.startswith("openai-direct/") or model.startswith("openai-codex/"):
            return "openai"
        custom_prefix = model.split("/", 1)[0].strip()
        if custom_prefix in custom_providers:
            return custom_prefix
        return f"unknown({model})" if model else "unknown"

    if tool == "codex":
        if not cfg.cx_config.exists():
            return "no-config"
        text = read_text(cfg.cx_config)
        provider = read_codex_model_provider(text)
        if not provider and codex_account_auth_summary(cfg.codex_home) == "ChatGPT OAuth":
            return "openai"
        if provider == "antigravity":
            return "antigravity"
        if provider == "quotio":
            return "quotio"
        if provider == "duckcoding":
            return "duck"
        if provider == "deepseek":
            return "deepseek"
        if provider == "quotio-local":
            return "quotio_local"
        if provider == "icodeeasy":
            return "icodeeasy"
        if provider == "molifang":
            return "molifang"
        if provider == "flames_newapi":
            env_key_name = read_codex_provider_env_key(text, "flames_newapi")
            if env_key_name == "FLAMES_API_KEY":
                return "flames"
            if env_key_name == "OPENAI_GQ80_API_KEY":
                return "openai_Gq80"
            if env_key_name == "OPENAI_V420_API_KEY":
                return "openai_V420"
            return "openai"
        if provider == "openai-official":
            return "openai"
        # Named OpenAI accounts: openai-Gq80 → openai_Gq80
        for _np in OPENAI_NAMED_PROVIDERS:
            if provider == _np.replace("_", "-", 1):  # openai_Gq80 → openai-Gq80
                return _np
        if provider == "openrouter":
            return "openrouter"
        if provider == "aiwave":
            return "aiwave"
        if provider in custom_providers:
            return provider
        return provider


    if tool == "gemini":
        gemini_env = cfg.gemini_env
        if not gemini_env.exists():
            return "no-config"
        text = read_text(gemini_env)
        m = re.search(r"^GOOGLE_GEMINI_BASE_URL=(.*)$", text, re.M)
        url = m.group(1).strip() if m else ""
        if "localhost:8000/gemini" in url or "127.0.0.1:8000/gemini" in url:
            return "gemini-balance"
        if "tools.ancientechoes" in url:
            return "antigravity"
        if "ancientechoes" in url:
            return "quotio"
        if "duckcoding" in url:
            return "duck"
        if "icodeeasy" in url:
            return "icodeeasy"
        if "ai-wave.org" in url:
            return "aiwave"
        if "flamescn.vip" in url:
            return "flames"
        return f"unknown({url})" if url else "unknown"

    if tool == "hermes":
        if not cfg.hermes_config.exists():
            return "no-config"
        data = load_yaml(cfg.hermes_config)
        model_cfg = data.get("model") or {}
        if not isinstance(model_cfg, dict):
            return "unknown"
        provider = str(model_cfg.get("provider") or "").strip()
        base_url = str(model_cfg.get("base_url") or "").strip()
        if provider == "custom:flames" or "flamescn.vip" in base_url:
            return "flames"
        if provider == "custom:molifang" or "molifangapi.xyz" in base_url:
            return "molifang"
        if provider == "custom:aiwave" or "ai-wave.org" in base_url:
            return "aiwave"
        if provider.startswith("custom:"):
            suffix = provider.split(":", 1)[1]
            if suffix in custom_providers:
                return suffix
        custom_name = find_custom_provider_by_base_url(base_url, custom_providers, protocol="openai")
        if custom_name:
            return custom_name
        return provider or "unknown"

    if tool == "grok":
        if not cfg.grok_config.exists():
            return "no-config"
        text = read_text(cfg.grok_config)
        selected = read_toml_table_string(text, "models", "default") or GROK_BUILTIN_DEFAULT_MODEL
        model_table = grok_model_table_name(selected)
        base_url = read_toml_table_string(text, model_table, "base_url")
        if "flamescn.vip" in base_url:
            return "flames"
        custom_name = find_custom_provider_by_base_url(base_url, custom_providers, protocol="openai")
        if custom_name and "grok" in custom_provider_enabled_tools(custom_providers[custom_name]):
            return custom_name
        if base_url:
            return f"unknown({base_url})"
        return "xai"

    if tool == "droid":
        # Check customModels first (OpenRouter / aiwave / duck_cc1 use this)
        factory_settings = cfg.home / ".factory/settings.json"
        if factory_settings.exists():
            try:
                fdata = load_json(factory_settings)
                cms = fdata.get("customModels", [])
                if cms and isinstance(cms, list) and isinstance(cms[0], dict):
                    cm_url = cms[0].get("baseUrl", "")
                    cm_key = cms[0].get("apiKey", "")
                    if "openrouter.ai" in cm_url:
                        return "openrouter"
                    if "ai-wave.org" in cm_url:
                        return "aiwave"
                    if "molifangapi.xyz" in cm_url:
                        return "molifang"
                    if "127.0.0.1:8317" in cm_url:
                        return "quotio_local"
                    if "api.openai.com" in cm_url:
                        # Distinguish named OpenAI accounts by key
                        _cred = load_credential_store(cfg.cred_file) if cfg.cred_file.exists() else {}
                        for _np in OPENAI_NAMED_PROVIDERS:
                            _np_key = _cred.get(_np, "")
                            if _np_key and cm_key == _np_key:
                                return _np
                        return "openai"
                    if "duckcoding" in cm_url:
                        # Distinguish duck vs duck_cc1 by key
                        cred_store = load_credential_store(cfg.cred_file) if cfg.cred_file.exists() else {}
                        dc1_key = os.environ.get("DUCK_CC1_API_KEY") or cred_store.get("duck_cc1", "")
                        if dc1_key and cm_key == dc1_key:
                            return "duck_cc1"
                        return "duck"
                    custom_name = find_custom_provider_by_base_url(str(cm_url or ""), custom_providers, protocol="openai")
                    if custom_name:
                        return custom_name
            except Exception:
                pass
        base = os.environ.get("GEMINI_BASE_URL", "")
        if "tools.ancientechoes" in base:
            return "antigravity"
        if "ancientechoes" in base:
            return "quotio"
        if "duckcoding" in base:
            return "duck"
        return "unknown"

    return "unknown"


def show_status(cfg: Config) -> None:
    codex_store = load_codex_account_store(cfg.codex_accounts_file)
    codex_account = find_codex_account_name(codex_store, cfg.codex_home)
    custom_providers = load_custom_providers_for_cfg(cfg)
    print(f"{CYAN}═══ API Provider Status ═══{NC}")
    for tool in TOOLS:
        p = detect_provider(tool, cfg)
        icon = "❓"
        suffix = ""
        if p == "duck":
            icon = "🦆"
        elif p == "quotio" or p == "quotio_local":
            icon = "🔗"
        elif p == "antigravity":
            icon = "🚀"
        elif p == "xingyun":
            icon = "☁️"
        elif p == "molifang":
            icon = "🧩"
        elif p == "flames":
            icon = "🔥"
        elif p == "xai":
            icon = "⚡"
        elif p == "deepseek":
            icon = "🧠"
        elif p == "openai" or p.startswith("openai_"):
            icon = "🔑"
            if tool == "openclaw":
                mode = detect_openclaw_openai_mode(cfg)
                if mode:
                    suffix = f" ({mode})"
            elif tool == "codex":
                mode = detect_codex_openai_mode(cfg)
                if mode:
                    suffix = f" ({mode})"
        elif p == "openrouter":
            icon = "🌐"
        elif p == "aiwave":
            icon = "🌊"
        elif p == "duck_cc1":
            icon = "🦆"
        elif p == "duck_codex2cc":
            icon = "🦆"
        elif p == "icodeeasy":
            icon = "🧊"
        elif p in custom_providers:
            icon = "🛠"
        print(f"  {tool:<10} {icon}  {p}{suffix}")
    print(f"  {'codex_home':<10} 📁  {cfg.codex_home}" + (f" [{codex_account}]" if codex_account else ""))
    print(f"{CYAN}═══════════════════════════{NC}")
    print("  🦆 = DuckCoding (api.duckcoding.ai)")
    print("  🔗 = Quotio Tunnel (api.ancientechoes.ai) / Quotio-Local (127.0.0.1:8317)")
    print("  🚀 = Antigravity-tools (tools.ancientechoes.ai)")
    print("  🔑 = OpenAI 官方 (api.openai.com via proxy) — Gq80/V420 = 账号标识")
    print("  🧩 = Molifang API (molifangapi.xyz)")
    print("  🔥 = Flames NewAPI (www.flamescn.vip)")
    print("  ⚡ = xAI Official (grok.com / cli-chat-proxy.grok.com)")
    print("  🧠 = DeepSeek (api.deepseek.com/anthropic + Responses)")
    print("  🌐 = OpenRouter (openrouter.ai)")
    print("  🌊 = AI Wave (api.ai-wave.org)")
    print("  🧊 = iCodeEasy (api.icodeeasy.cc)")
    if custom_providers:
        print("  🛠 = Custom provider (OpenAI-compatible and/or Anthropic-compatible)")




# ----------------------------- model helpers ----------------------------
# Model family → compatible tools
FAMILY_TOOLS = {
    "claude": ("cc", "openclaw"),
    "gemini": ("openclaw", "droid", "gemini", "hermes"),
    "gpt":    ("codex", "droid", "openclaw", "hermes", "grok"),
    "grok":   ("grok",),
    "kimi":   ("cc", "codex"),
    "deepseek": ("cc", "codex"),
    "openrouter": ("openclaw", "codex", "droid"),
}

ALL_KNOWN_PROFILES = frozenset(
    list(OPENCLAW_DUCK_PROFILE_NAMES)
    + list(OPENCLAW_QUOTIO_PROFILE_NAMES)
    + list(OPENCLAW_ANTIGRAVITY_PROFILE_NAMES)
    + list(DROID_QUOTIO_PROFILE_NAMES)
    + list(OPENCLAW_OPENROUTER_PROFILE_NAMES)
)


def model_family(model: str) -> str:
    """Return the normalized model family used for tool compatibility."""
    m = model.split("/")[-1]  # strip provider prefix like quotio/
    if m.startswith("claude-") or m.startswith("claude_"):
        return "claude"
    if m.startswith("gemini-") or m.startswith("gemini_"):
        return "gemini"
    if m.startswith("gpt-") or m.startswith("gpt_") or m.startswith("o1") or m.startswith("o3") or m.startswith("o4"):
        return "gpt"
    if m.startswith("grok-") or m.startswith("grok_"):
        return "grok"
    if m.startswith("kimi-") or m.startswith("kimi_"):
        return "kimi"
    if m.startswith("deepseek-") or m.startswith("deepseek_"):
        return "deepseek"
    # OpenRouter free IDs contain "/" (e.g. nvidia/nemotron-3.5-lightning:free)
    if is_openrouter_free_model(model) or (
        "/" in model and (model in OPENROUTER_FREE_MODELS or model.rstrip(":free") + ":free" in OPENROUTER_FREE_MODELS)
    ):
        return "openrouter"
    return "other"


def is_model_name(s: str) -> bool:
    """Heuristic: is this string a model name (vs a profile name)?"""
    if s.lower() in ALL_KNOWN_PROFILES:
        return False
    if s.startswith("claude-") or s.startswith("gemini-") or s.startswith("gpt-"):
        return True
    if "." in s:  # e.g. gpt-5.3-codex
        return True
    return True  # default: treat as model name


def get_provider_models(
    provider: str,
    custom_store: Dict[str, Any] | None = None,
    cfg: Config | None = None,
) -> Dict[str, Tuple[str, ...]]:
    """Return {family: (models...)} for a provider."""
    custom_spec = custom_provider_map(custom_store or {}).get(provider)
    if custom_spec:
        models_list: List[str] = []
        openai_cfg = custom_spec.get("openai") if isinstance(custom_spec.get("openai"), dict) else None
        anthropic_cfg = custom_spec.get("anthropic") if isinstance(custom_spec.get("anthropic"), dict) else None
        if openai_cfg:
            models_list.extend(normalize_available_models(openai_cfg.get("available_models") or []))
        if openai_cfg and openai_cfg.get("default_model"):
            models_list.append(str(openai_cfg["default_model"]))
        if anthropic_cfg:
            models_list.extend(normalize_available_models(anthropic_cfg.get("available_models") or []))
        if anthropic_cfg and anthropic_cfg.get("default_model"):
            models_list.append(str(anthropic_cfg["default_model"]))
        models = tuple(dict.fromkeys(models_list))
    elif provider == "quotio":
        models = QUOTIO_AVAILABLE_MODELS
    elif provider == "duck":
        # Merge all 3 duck keys
        models = tuple(sorted(set(DUCK_ANTHROPIC_MODELS + DUCK_GEMINI_MODELS + DUCK_CODEX_MODELS)))
    elif provider == "antigravity":
        # Antigravity shares Quotio model set (same tunnel backend)
        models = QUOTIO_AVAILABLE_MODELS
    elif provider == "xingyun":
        models = XINGYUN_AVAILABLE_MODELS
    elif provider == "molifang":
        models = MOLIFANG_AVAILABLE_MODELS
    elif provider == "aiwave":
        models = AIWAVE_CODEX_AVAILABLE_MODELS + AIWAVE_GEMINI_AVAILABLE_MODELS
    elif provider == "flames":
        models = FLAMES_AVAILABLE_MODELS
    elif provider == "xai":
        models = XAI_GROK_AVAILABLE_MODELS
    elif provider == "deepseek":
        models = DEEPSEEK_AVAILABLE_MODELS
    elif provider == "icodeeasy":
        models = ICODEEASY_AVAILABLE_MODELS
    elif provider == "duck_codex2cc":
        models = DUCK_CODEX2CC_AVAILABLE_MODELS
    elif provider == "openrouter":
        models = tuple(dict.fromkeys((*OPENROUTER_FREE_MODELS, *OPENROUTER_PAID_MODELS)))
    else:
        models = ()
    if cfg is not None:
        override_models = model_override_entries(cfg, provider=provider)
        models = tuple(dict.fromkeys((*models, *override_models.keys())))
    result: Dict[str, list] = {
        "claude": [],
        "gemini": [],
        "gpt": [],
        "grok": [],
        "kimi": [],
        "deepseek": [],
        "openrouter": [],
        "other": [],
    }
    for m in models:
        result[model_family(m)].append(m)
    return {k: tuple(v) for k, v in result.items()}


def model_in_provider(model: str, provider: str, cfg: Config | None = None) -> bool:
    """Check if a model name is in the provider's catalog."""
    if cfg is not None and model in model_override_entries(cfg, provider=provider):
        return True
    if provider == "openrouter":
        resolved = resolve_openrouter_model(model)
        if resolved in OPENROUTER_FREE_MODELS or resolved in OPENROUTER_PAID_MODELS:
            return True
        if is_openrouter_free_model(resolved):
            return True
        # OpenRouter IDs are vendor/model; allow paid catalog IDs not yet snapshotted.
        return "/" in resolved
    m = model.split("/")[-1]  # strip provider prefix
    if provider == "quotio" or provider == "antigravity":
        return m in QUOTIO_AVAILABLE_MODELS
    if provider == "xingyun":
        return m in XINGYUN_AVAILABLE_MODELS
    if provider == "molifang":
        return m in MOLIFANG_AVAILABLE_MODELS
    if provider == "aiwave":
        return m in AIWAVE_CODEX_AVAILABLE_MODELS or m in AIWAVE_GEMINI_AVAILABLE_MODELS
    if provider == "flames":
        return model in FLAMES_AVAILABLE_MODELS or m in FLAMES_AVAILABLE_MODELS
    if provider == "xai":
        return m in XAI_GROK_AVAILABLE_MODELS
    if provider == "deepseek":
        return m in DEEPSEEK_AVAILABLE_MODELS
    if provider == "icodeeasy":
        return model_family(m) in ("claude", "gemini", "gpt")
    if provider == "duck_codex2cc":
        return m in DUCK_CODEX2CC_AVAILABLE_MODELS
    if provider == "duck":
        return m in DUCK_ANTHROPIC_MODELS or m in DUCK_GEMINI_MODELS or m in DUCK_CODEX_MODELS
    return False  # openai — no local catalog


def tools_for_model(model: str) -> Tuple[str, ...]:
    """Return which tools can use this model."""
    fam = model_family(model)
    return FAMILY_TOOLS.get(fam, ())


# ----------------------------- list command ----------------------------
def cmd_list_models(
    provider: str = "",
    custom_store: Dict[str, Any] | None = None,
    *,
    cfg: Config | None = None,
    store: Dict[str, str] | None = None,
    online: bool = False,
) -> None:
    """Print available models for one or all providers."""
    if online:
        if cfg is None or store is None:
            raise SwitchError("Online model listing requires cfg and store")
        sync_custom_provider_specs(cfg, store, provider_name=provider)
        custom_store = load_custom_provider_store(cfg.custom_providers_file)

    providers = [provider] if provider else [
        "quotio",
        "duck",
        "antigravity",
        "xingyun",
        "molifang",
        "aiwave",
        "flames",
        "xai",
        "deepseek",
        "icodeeasy",
        "duck_codex2cc",
        "openrouter",
        *sorted(custom_provider_map(custom_store or {}).keys()),
    ]

    for prov in providers:
        catalog = get_provider_models(prov, custom_store, cfg=cfg)
        total = sum(len(v) for v in catalog.values())
        prov_label = {
            "quotio": "Quotio",
            "duck": "DuckCoding",
            "antigravity": "Antigravity",
            "xingyun": "Xingyun",
            "molifang": "Molifang API",
            "aiwave": "AI Wave",
            "flames": "Flames NewAPI",
            "xai": "xAI Official",
            "deepseek": "DeepSeek (Anthropic + Responses)",
            "icodeeasy": "iCodeEasy (统一网关)",
            "duck_codex2cc": "Duck CodeX→CC (CC-only)",
            "openrouter": "OpenRouter",
        }.get(prov, prov)
        print(f"{CYAN}═══ {prov_label} 可用模型 ({total}) ═══{NC}")

        sections = [
            ("Claude", "claude", "cc, openclaw"),
            ("Gemini", "gemini", "openclaw, droid, gemini, hermes"),
            ("OpenAI/GPT", "gpt", "codex, droid, hermes, grok"),
            ("Grok", "grok", "grok"),
            ("Kimi", "kimi", "cc, codex"),
            ("DeepSeek", "deepseek", "cc, codex"),
            ("OpenRouter (Free)", "openrouter", "openclaw, codex, droid"),
            ("其他", "other", "—"),
        ]
        for label, fam, tools_hint in sections:
            models = catalog.get(fam, ())
            if not models:
                continue
            print(f"  {GREEN}{label}{NC} ({tools_hint}):")
            # For duck, annotate which key
            for m in models:
                if prov == "duck":
                    if m in DUCK_ANTHROPIC_MODELS:
                        tag = " [anthropic]"
                    elif m in DUCK_GEMINI_MODELS:
                        tag = " [gemini]"
                    elif m in DUCK_CODEX_MODELS:
                        tag = " [codex]"
                    else:
                        tag = ""
                    print(f"    {m}{tag}")
                elif prov == "duck_codex2cc":
                    mapped = DUCK_CODEX2CC_MODEL_MAP.get(m, "?")
                    print(f"    {m}  → {mapped}")
                else:
                    print(f"    {m}")
        print()


# ----------------------------- check command ---------------------------
def detect_current_model(tool: str, cfg: Config) -> str:
    """Read current model from tool config."""
    if tool == "cc":
        if not cfg.cc_settings.exists():
            return "?"
        data = load_json(cfg.cc_settings)
        return str(data.get("model", "") or "?")

    if tool == "openclaw":
        if not cfg.oc_config.exists():
            return "?"
        data = load_json(cfg.oc_config)
        return resolve_openclaw_primary_model(data, cfg.oc_agent_id) or "?"

    if tool == "codex":
        if not cfg.cx_config.exists():
            return "?"
        text = read_text(cfg.cx_config)
        m = re.search(r'^\s*model\s*=\s*"([^"]+)"', text, re.M)
        return m.group(1) if m else "?"

    if tool == "droid":
        # Check customModels first, then env
        if cfg.factory_settings.exists():
            data = load_json(cfg.factory_settings)
            cms = data.get("customModels", [])
            if cms and isinstance(cms, list) and isinstance(cms[0], dict):
                return cms[0].get("model", "?")
        return os.environ.get("GEMINI_MODEL", "?")

    if tool == "gemini":
        gemini_env = cfg.gemini_env
        if not gemini_env.exists():
            return "?"
        text = read_text(gemini_env)
        m = re.search(r"^GEMINI_MODEL=(.*)$", text, re.M)
        return m.group(1).strip() if m else "?"

    if tool == "hermes":
        if not cfg.hermes_config.exists():
            return "?"
        data = load_yaml(cfg.hermes_config)
        model_cfg = data.get("model") or {}
        if isinstance(model_cfg, dict):
            return str(model_cfg.get("default") or "?")
        return str(model_cfg or "?")

    if tool == "grok":
        if not cfg.grok_config.exists():
            return "?"
        text = read_text(cfg.grok_config)
        selected = read_toml_table_string(text, "models", "default") or GROK_BUILTIN_DEFAULT_MODEL
        model = read_toml_table_string(text, grok_model_table_name(selected), "model")
        return model or selected or "?"

    return "?"


def load_codex_bundled_catalog() -> Dict[str, Any]:
    try:
        result = subprocess.run(
            ["codex", "debug", "models", "--bundled"],
            capture_output=True,
            text=True,
            timeout=20,
        )
    except Exception as ex:
        raise SwitchError(f"Failed to read the bundled Codex model catalog: {ex}") from ex

    if result.returncode != 0:
        detail = (result.stderr or result.stdout).strip()
        raise SwitchError(
            "Failed to read the bundled Codex model catalog"
            + (f": {detail}" if detail else "")
        )
    try:
        catalog = json.loads(result.stdout)
    except Exception as ex:
        raise SwitchError(f"Failed to parse the bundled Codex model catalog: {ex}") from ex
    if not isinstance(catalog, dict) or not isinstance(catalog.get("models"), list):
        raise SwitchError("Bundled Codex model catalog has an unsupported format")
    return catalog


