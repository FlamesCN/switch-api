        "default_reasoning_level": "high",
        "supported_reasoning_levels": [
            {"effort": effort, "description": description}
            for effort, description in descriptions.items()
        ],
        "shell_type": "shell_command",
        "visibility": "list",
        "supported_in_api": True,
        "priority": 0,
        "additional_speed_tiers": [],
        "service_tiers": [],
        "default_service_tier": None,
        "availability_nux": None,
        "upgrade": None,
        "base_instructions": template["base_instructions"],
        "model_messages": None,
        "include_skills_usage_instructions": False,
        "supports_reasoning_summary_parameter": True,
        "default_reasoning_summary": "auto",
        "support_verbosity": False,
        "default_verbosity": None,
        "apply_patch_tool_type": "freeform",
        "web_search_tool_type": "text",
        "truncation_policy": {"mode": "tokens", "limit": 10_000},
        "supports_parallel_tool_calls": True,
        "supports_image_detail_original": False,
        "context_window": FLAMES_KIMI_CONTEXT_WINDOW,
        "max_context_window": FLAMES_KIMI_CONTEXT_WINDOW,
        "auto_compact_token_limit": None,
        "comp_hash": None,
        "effective_context_window_percent": 95,
        "experimental_supported_tools": [],
        "input_modalities": ["text", "image"],
        "supports_search_tool": False,
        "use_responses_lite": False,
        "auto_review_model_override": None,
        "tool_mode": None,
        "multi_agent_version": None,
    }
    catalog["models"] = [
        model for model in models if model.get("slug") != FLAMES_KIMI_CODEX_MODEL
    ] + [kimi_model]
    return catalog


def _build_deepseek_codex_model(
    slug: str,
    display_name: str,
    template: Dict[str, Any],
    vision: bool = False,
) -> Dict[str, Any]:
    """Build a DeepSeek Codex model entry on top of a bundled template."""
    is_vision_model = vision or slug.endswith("-vision-exp")
    deepseek_model = {
        "slug": slug,
        "prefer_websockets": False,
        "support_verbosity": True,
        "default_verbosity": "low",
        "apply_patch_tool_type": "freeform",
        "web_search_tool_type": "text",
        "input_modalities": ["text", "image"] if is_vision_model else ["text"],
        "supports_image_detail_original": False,
        "truncation_policy": {"mode": "tokens", "limit": 10_000},
        "supports_parallel_tool_calls": True,
        "tool_mode": None,
        "multi_agent_version": "v2",
        "use_responses_lite": False,
        "include_skills_usage_instructions": False,
        "auto_review_model_override": None,
        "context_window": 1_048_576,
        "max_context_window": 1_048_576,
        "effective_context_window_percent": 95,
        "auto_compact_token_limit": None,
        "comp_hash": "3000",
        "reasoning_summary_format": "experimental",
        "default_reasoning_summary": "none",
        "display_name": display_name,
        "description": "Latest frontier agentic coding model.",
        "default_reasoning_level": "high",
        "supported_reasoning_levels": [
            {"effort": "low", "description": "Fast responses with lighter reasoning"},
            {"effort": "high", "description": "Extra high reasoning depth for complex problems"},
            {"effort": "max", "description": "Maximum reasoning depth for the hardest problems"},
        ],
        "shell_type": "shell_command",
        "visibility": "list",
        "minimal_client_version": "0.144.0",
        "supported_in_api": True,
        "availability_nux": None,
        "upgrade": None,
        "priority": 1,
        "base_instructions": template["base_instructions"],
        "model_messages": {"instructions_template": template["base_instructions"]},
    }
    # Preserve any schema fields newly required by the installed Codex version.
    for key, value in template.items():
        deepseek_model.setdefault(key, value)
    return deepseek_model


def build_deepseek_codex_catalog(cfg: Config | None = None) -> Dict[str, Any]:
    """Build the official DeepSeek V4 Flash/Pro Codex catalog on top of bundled models."""
    catalog = load_codex_bundled_catalog()
    models = [model for model in catalog["models"] if isinstance(model, dict)]
    template = next(
        (model for model in models if model.get("slug") == "gpt-5.4"),
        models[0] if models else None,
    )
    if not template or not isinstance(template.get("base_instructions"), str):
        raise SwitchError("Bundled Codex model catalog has no usable instruction template")

    override_entries = model_override_entries(cfg, tool="codex") if cfg else {}
    managed_models = list(DEEPSEEK_CODEX_AVAILABLE_MODELS)
    for model_id in override_entries:
        if model_id not in managed_models and model_family(model_id) == "deepseek":
            managed_models.append(model_id)
    display_names = {
        "deepseek-v4-flash": "DeepSeek-V4-Flash",
        "deepseek-v4-flash-vision-exp": "DeepSeek-V4-Flash Vision (Experimental)",
        "deepseek-v4-pro": "DeepSeek-V4-Pro",
    }
    deepseek_models = [
        _build_deepseek_codex_model(
            slug,
            display_names.get(slug, slug),
            template,
            vision=bool(override_entries.get(slug, {}).get("vision", False)),
        )
        for slug in managed_models
    ]
    preferred_slugs = set(FLAMES_CODEX_PRIMARY_MODELS) | set(managed_models)
    catalog["models"] = [
        model for slug in FLAMES_CODEX_PRIMARY_MODELS
        for model in models
        if model.get("slug") == slug
    ] + deepseek_models + [
        model for model in models if model.get("slug") not in preferred_slugs
    ]
    return catalog


def build_flames_codex_catalog(cfg: Config) -> Dict[str, Any]:
    """Build the Flames catalog with Codex, DeepSeek, then registered models."""
    catalog = load_codex_bundled_catalog()
    models = [model for model in catalog["models"] if isinstance(model, dict)]
    template = next(
        (model for model in models if model.get("slug") == "gpt-5.4"),
        models[0] if models else None,
    )
    if not template or not isinstance(template.get("base_instructions"), str):
        raise SwitchError("Bundled Codex model catalog has no usable instruction template")

    override_entries = model_override_entries(cfg, provider="flames", tool="codex")
    deepseek_slugs = list(DEEPSEEK_CODEX_AVAILABLE_MODELS)
    for model_id in override_entries:
        if model_family(model_id) == "deepseek" and model_id not in deepseek_slugs:
            deepseek_slugs.append(model_id)

    display_names = {
        "deepseek-v4-flash": "DeepSeek-V4-Flash",
        "deepseek-v4-flash-vision-exp": "DeepSeek-V4-Flash Vision (Experimental)",
        "deepseek-v4-pro": "DeepSeek-V4-Pro",
    }
    deepseek_models = [
        _build_deepseek_codex_model(
            slug,
            display_names.get(slug, slug),
            template,
            vision=bool(override_entries.get(slug, {}).get("vision", False)),
        )
        for slug in deepseek_slugs
    ]
    registered_slugs = [
        model_id
        for model_id in override_entries
        if model_id not in deepseek_slugs
        and model_id not in FLAMES_CODEX_PRIMARY_MODELS
        and model_id != FLAMES_KIMI_CODEX_MODEL
    ]
    registered_models = [
        _build_deepseek_codex_model(
            slug,
            slug,
            template,
            vision=bool(override_entries[slug].get("vision", False)),
        )
        for slug in registered_slugs
    ]
    openrouter_models = []
    for slug in FLAMES_OPENROUTER_MODELS:
        vision = slug in OPENROUTER_CODEX_VISION_MODELS or model_family(slug) in ("claude", "gpt")
        entry = _build_deepseek_codex_model(
            slug,
            openrouter_codex_display_name(slug),
            template,
            vision=vision,
        )
        ctx = OPENROUTER_CODEX_CONTEXT_WINDOWS.get(slug)
        if ctx:
            entry["context_window"] = ctx
            entry["max_context_window"] = ctx
        if is_openrouter_free_model(slug):
            entry["description"] = "OpenRouter free model via Flames NewAPI."
        else:
            entry["description"] = "OpenRouter paid model via Flames NewAPI."
        openrouter_models.append(entry)

    preferred_slugs = (
        set(FLAMES_CODEX_PRIMARY_MODELS)
        | set(deepseek_slugs)
        | set(registered_slugs)
        | set(FLAMES_OPENROUTER_MODELS)
    )
    catalog["models"] = [
        model for slug in FLAMES_CODEX_PRIMARY_MODELS
        for model in models
        if model.get("slug") == slug
    ] + deepseek_models + registered_models + openrouter_models + [
        model for model in models if model.get("slug") not in preferred_slugs
    ]
    return catalog


def codex_kimi_catalog_is_ready(cfg: Config, text: str) -> bool:
    configured_path = read_codex_top_level_string(text, "model_catalog_json")
    if configured_path != str(cfg.codex_kimi_catalog) or not cfg.codex_kimi_catalog.exists():
        return False
    try:
        catalog = load_json(cfg.codex_kimi_catalog)
    except SwitchError:
        return False
    return any(
        isinstance(model, dict) and model.get("slug") == FLAMES_KIMI_CODEX_MODEL
        for model in catalog.get("models", [])
    )


def codex_deepseek_catalog_is_ready(cfg: Config, text: str) -> bool:
    configured_path = read_codex_top_level_string(text, "model_catalog_json")
    if configured_path != str(cfg.codex_deepseek_catalog) or not cfg.codex_deepseek_catalog.exists():
        return False
    try:
        catalog = load_json(cfg.codex_deepseek_catalog)
    except SwitchError:
        return False
    catalog_slugs = {
        model.get("slug")
        for model in catalog.get("models", [])
        if isinstance(model, dict)
    }
    required = set(DEEPSEEK_CODEX_AVAILABLE_MODELS)
    required.update(
        model
        for model, spec in model_override_entries(cfg, provider="deepseek", tool="codex").items()
        if model_family(model) == "deepseek"
    )
    return required.issubset(catalog_slugs)


def codex_flames_catalog_is_ready(cfg: Config, text: str) -> bool:
    configured_path = read_codex_top_level_string(text, "model_catalog_json")
    if configured_path != str(cfg.codex_flames_catalog) or not cfg.codex_flames_catalog.exists():
        return False
    try:
        catalog = load_json(cfg.codex_flames_catalog)
    except SwitchError:
        return False
    catalog_slugs = [
        model.get("slug")
        for model in catalog.get("models", [])
        if isinstance(model, dict)
    ]
    override_entries = model_override_entries(cfg, provider="flames", tool="codex")
    extra_deepseek = [
        model_id
        for model_id in override_entries
        if model_family(model_id) == "deepseek"
        and model_id not in DEEPSEEK_CODEX_AVAILABLE_MODELS
    ]
    registered = [
        model_id
        for model_id in override_entries
        if model_family(model_id) != "deepseek"
        and model_id not in FLAMES_CODEX_PRIMARY_MODELS
        and model_id != FLAMES_KIMI_CODEX_MODEL
    ]
    expected_prefix = [
        *FLAMES_CODEX_PRIMARY_MODELS,
        *DEEPSEEK_CODEX_AVAILABLE_MODELS,
        *extra_deepseek,
        *registered,
        *FLAMES_OPENROUTER_MODELS,
    ]
    return catalog_slugs[:len(expected_prefix)] == expected_prefix


def build_openrouter_codex_catalog(cfg: Config | None = None) -> Dict[str, Any]:
    """Build a Codex /model catalog of OpenRouter free + paid IDs."""
    catalog = load_codex_bundled_catalog()
    models = [model for model in catalog["models"] if isinstance(model, dict)]
    template = next(
        (model for model in models if model.get("slug") == "gpt-5.4"),
        models[0] if models else None,
    )
    if not template or not isinstance(template.get("base_instructions"), str):
        raise SwitchError("Bundled Codex model catalog has no usable instruction template")

    override_entries = model_override_entries(cfg, provider="openrouter", tool="codex") if cfg else {}
    openrouter_models = []
    for slug in openrouter_codex_catalog_slugs(cfg):
        vision = bool(override_entries.get(slug, {}).get("vision", False)) or slug in OPENROUTER_CODEX_VISION_MODELS
        if not vision and model_family(slug) in ("claude", "gpt"):
            vision = True
        entry = _build_deepseek_codex_model(
            slug,
            openrouter_codex_display_name(slug),
            template,
            vision=vision,
        )
        ctx = OPENROUTER_CODEX_CONTEXT_WINDOWS.get(slug)
        if ctx:
            entry["context_window"] = ctx
            entry["max_context_window"] = ctx
        if is_openrouter_free_model(slug):
            entry["description"] = "OpenRouter free model (:free daily quota)."
        else:
            entry["description"] = "OpenRouter paid model (uses account credits)."
        openrouter_models.append(entry)
    catalog["models"] = openrouter_models
    return catalog


def codex_openrouter_catalog_is_ready(cfg: Config, text: str) -> bool:
    configured_path = read_codex_top_level_string(text, "model_catalog_json")
    if configured_path != str(cfg.codex_openrouter_catalog) or not cfg.codex_openrouter_catalog.exists():
        return False
    try:
        catalog = load_json(cfg.codex_openrouter_catalog)
    except SwitchError:
        return False
    catalog_slugs = {
        model.get("slug")
        for model in catalog.get("models", [])
        if isinstance(model, dict)
    }
    return set(openrouter_codex_catalog_slugs(cfg)).issubset(catalog_slugs)


def activate_flames_kimi_codex_catalog(cfg: Config, text: str) -> str:
    managed_path = str(cfg.codex_kimi_catalog)
    current_path = read_codex_top_level_string(text, "model_catalog_json")
    if current_path != managed_path:
        cfg.switch_dir.mkdir(parents=True, exist_ok=True)
        save_json(
            cfg.codex_catalog_state,
            {"previous_model_catalog_json": current_path or None},
        )

    cfg.codex_kimi_catalog.parent.mkdir(parents=True, exist_ok=True)
    save_json(cfg.codex_kimi_catalog, build_flames_kimi_codex_catalog())
    info(f"Codex Kimi metadata catalog → {cfg.codex_kimi_catalog}")
    return set_codex_top_level_string(text, "model_catalog_json", managed_path)


