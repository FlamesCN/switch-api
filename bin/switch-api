        elif p == "antigravity":
            icon = "🚀"
        elif p == "xingyun":
            icon = "☁️"
        elif p == "flames":
            icon = "🔥"
        elif p == "openai" or p.startswith("openai_"):
            icon = "🔑"
            if tool == "openclaw":
                mode = detect_openclaw_openai_mode(cfg)
                if mode:
                    suffix = f" ({mode})"
            elif tool == "codex":
                mode = detect_codex_openai_mode(cfg)
                if mode:
                    suffix = f" ({mode})"
        elif p == "openrouter":
            icon = "🌐"
        elif p == "aiwave":
            icon = "🌊"
        elif p == "duck_cc1":
            icon = "🦆"
        elif p == "duck_codex2cc":
            icon = "🦆"
        elif p == "icodeeasy":
            icon = "🧊"
        print(f"  {tool:<10} {icon}  {p}{suffix}")
    print(f"  {'codex_home':<10} 📁  {cfg.codex_home}" + (f" [{codex_account}]" if codex_account else ""))
    print(f"{CYAN}═══════════════════════════{NC}")
    print("  🦆 = DuckCoding (api.duckcoding.ai)")
    print("  🔗 = Quotio Tunnel (api.ancientechoes.ai) / Quotio-Local (127.0.0.1:8317)")
